{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Serif italic",
	"slug": "serif-italic",
	"blockTypes": [
		"core/paragraph",
		"core/list"
	],
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--display)",
			"fontStyle": "italic",
			"fontSize": "clamp(1.15rem, 1rem + 0.5vw, 1.5rem)",
			"fontWeight": "400",
			"lineHeight": "1.4"
		}
	}
}