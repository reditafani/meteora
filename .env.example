# Copy to .env and fill in. Variables prefixed with PUBLIC_ are embedded in the static build.
# After changing any value, rebuild (npm run build) and re-upload.

# Canonical site origin (no trailing slash). Choose www or non-www and keep .htaccess consistent.
PUBLIC_SITE_URL=https://meteoraevents.com

# WhatsApp number in international format, digits only (no +, spaces or dashes).
PUBLIC_WHATSAPP_NUMBER=393280642479

# Form endpoint (PHP handler shipped in public/api/). Leave as is for Keliweb.
PUBLIC_FORM_ENDPOINT=/api/send.php

# Analytics — leave empty to disable. Nothing loads before cookie consent.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
