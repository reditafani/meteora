---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Page not found | Meteora Events" description="Page not found." alternates={{ it: '/it/', en: '/' }} noindex>
  <section class="section">
    <div class="container container--narrow nf">
      <p class="eyebrow">404</p>
      <h1>Page <em>not found.</em></h1>
      <p class="lead muted">The page you are looking for does not exist or has moved.</p>
      <div class="cta-row">
        <a class="btn" href="/">Home</a>
        <a class="link" href="/contact/">Request a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: var(--space-m);
    min-height: 50svh;
    align-content: center;
  }
</style>
