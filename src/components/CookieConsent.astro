---
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const hasMarketing = Boolean(site.analytics.metaPixel);
---

<!-- Compact banner (Garante privacy guidelines 2021): the X closes it keeping
     only the necessary cookies (= refuse), "Accetta tutti" accepts, "Personalizza"
     opens the per-category choice. Nothing non-essential runs before a choice. -->
<div class="cookie" role="region" aria-label={s.cookieTitle} hidden data-cookie data-ga4={site.analytics.ga4} data-gtm={site.analytics.gtm} data-pixel={site.analytics.metaPixel}>
  <button type="button" class="cookie__close" data-cookie-reject aria-label={s.cookieClose} title={s.cookieClose}>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <p class="cookie__text">
    {s.cookieText} <a href={url('cookies', lang)}>{s.cookiePolicy}</a>
  </p>
  <form class="cookie__prefs" hidden data-cookie-prefs>
    <fieldset>
      <legend class="visually-hidden">{s.cookieSettings}</legend>
      <label class="cookie__opt">
        <input type="checkbox" checked disabled />
        <span><strong>{s.cookieNecessary}</strong> — {s.cookieNecessaryDesc}</span>
      </label>
      <label class="cookie__opt">
        <input type="checkbox" name="analytics" />
        <span><strong>{s.cookieAnalytics}</strong> — {s.cookieAnalyticsDesc}</span>
      </label>
      {
        hasMarketing && (
          <label class="cookie__opt">
            <input type="checkbox" name="marketing" />
            <span><strong>{s.cookieMarketing}</strong> — {s.cookieMarketingDesc}</span>
          </label>
        )
      }
    </fieldset>
  </form>
  <div class="cookie__actions">
    <button type="button" class="cookie__link" data-cookie-customize>{s.cookieCustomize}</button>
    <button type="button" class="btn btn--outline cookie__btn" data-cookie-save hidden>{s.cookieSave}</button>
    <button type="button" class="btn cookie__btn" data-cookie-accept>{s.cookieAccept}</button>
  </div>
</div>

<script>
  import { initAnalytics, readConsent, saveConsent } from '@/scripts/analytics';

  const box = document.querySelector<HTMLElement>('[data-cookie]');
  if (box) {
    const ids = { ga4: box.dataset.ga4 || '', gtm: box.dataset.gtm || '', metaPixel: box.dataset.pixel || '' };
    initAnalytics(ids);

    const prefs = box.querySelector<HTMLFormElement>('[data-cookie-prefs]')!;
    const saveBtn = box.querySelector<HTMLButtonElement>('[data-cookie-save]')!;
    const customizeBtn = box.querySelector<HTMLButtonElement>('[data-cookie-customize]')!;
    const show = (withPrefs = false) => {
      const st = readConsent();
      (prefs.elements.namedItem('analytics') as HTMLInputElement | null)!.checked = st?.analytics ?? false;
      const mk = prefs.elements.namedItem('marketing') as HTMLInputElement | null;
      if (mk) mk.checked = st?.marketing ?? false;
      prefs.hidden = !withPrefs;
      saveBtn.hidden = !withPrefs;
      customizeBtn.hidden = withPrefs;
      box.hidden = false;
    };
    const hide = () => (box.hidden = true);

    if (!readConsent()) show();

    box.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      saveConsent(true, true);
      hide();
    });
    box.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      saveConsent(false, false);
      hide();
    });
    customizeBtn.addEventListener('click', () => show(true));
    saveBtn.addEventListener('click', () => {
      const a = (prefs.elements.namedItem('analytics') as HTMLInputElement).checked;
      const m = (prefs.elements.namedItem('marketing') as HTMLInputElement | null)?.checked ?? false;
      saveConsent(a, m);
      hide();
    });
    document.querySelectorAll('[data-cookie-open]').forEach((b) => b.addEventListener('click', () => show(true)));
  }
</script>

<style>
  /* compact card: bottom left on computers, a slim strip on phones */
  .cookie {
    position: fixed;
    left: max(0.5rem, env(safe-area-inset-left));
    right: max(0.5rem, env(safe-area-inset-right));
    bottom: calc(0.5rem + env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 2.6rem 0.7rem 0.9rem;
    max-height: 80svh;
    overflow-y: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 18px 50px -24px rgb(20 14 10 / 0.5);
  }
  .cookie[hidden] {
    display: none;
  }
  /* the X: small icon, comfortable 40px touch area */
  .cookie__close {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }
  .cookie__close:hover { color: var(--color-accent-ink); }
  .cookie__text {
    margin: 0;
    font-size: 0.8125rem; /* 13px */
    line-height: 1.45;
    color: var(--color-text-muted);
  }
  .cookie__text a { color: var(--color-text); }
  .cookie__prefs {
    grid-column: 1 / -1;
  }
  .cookie__prefs fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .cookie__opt {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .cookie__opt input {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.1rem;
    accent-color: var(--color-text);
  }
  .cookie__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    white-space: nowrap;
  }
  .cookie__link {
    border: 0;
    padding: 0.5rem 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cookie__btn {
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
  }
  @media (min-width: 768px) {
    .cookie {
      left: 1.25rem;
      right: auto;
      bottom: 1.25rem;
      width: 21.5rem; /* ≈ 344px */
      padding: 0.9rem 2.6rem 0.9rem 1rem;
    }
  }
</style>
