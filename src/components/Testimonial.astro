---
/** Renders authentic testimonials only; outputs nothing while the list is empty. */
import type { Lang } from '@/i18n/routes';
import { testimonials } from '@/data/testimonials';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

{
  testimonials.length > 0 && (
    <section class="section section--alt tm" aria-label={lang === 'it' ? 'Dicono di noi' : 'Kind words'}>
      <div class="container container--narrow">
        {testimonials.map((q) => (
          <figure class="tm__item" data-reveal>
            <blockquote>
              <p>“{q.quote[lang]}”</p>
            </blockquote>
            <figcaption class="micro">
              {q.author}
              {q.role && <span class="muted"> — {q.role[lang]}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .tm__item + .tm__item {
    margin-top: var(--space-xl);
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.75rem);
    font-style: italic;
    line-height: 1.25;
    font-weight: 350;
  }
  figcaption {
    margin-top: var(--space-m);
  }
</style>
