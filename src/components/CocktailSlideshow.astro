---
import type { Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { featuredCocktails } from '@/data/cocktails';
import Img from './Img.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const it = lang === 'it';
---

<section class="section section--dark cs" aria-labelledby="cs-title">
  <div class="container cs__head">
    <div>
      <p class="eyebrow" data-reveal>Cocktail · Experience</p>
      <h2 id="cs-title" class="cs__title" data-reveal style="--delay:.06s">
        {it ? <>La nostra <em>cocktail list.</em></> : <>Our <em>cocktail list.</em></>}
      </h2>
    </div>
    <div class="cs__nav">
      <button class="cs__arrow cs__prev" aria-label={it ? 'Precedente' : 'Previous'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="cs__arrow cs__next" aria-label={it ? 'Successivo' : 'Next'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="cs__track-wrap">
    <ul class="cs__track" role="list">
      {featuredCocktails.map((c, i) => (
        <li class="cs__slide" data-reveal style={`--delay:${i * 0.04}s`}>
          <div class="cs__frame">
            <div class="cs__media media">
              {c.image
                ? <Img src={c.image} alt={c.name} sizes="(min-width: 900px) 24vw, 50vw" widths={[280, 560]} />
                : <div class="cs__placeholder" aria-hidden="true"></div>
              }
            </div>
          </div>
          <div class="cs__info">
            <h3 class="cs__name">{c.name}</h3>
            <div class="cs__ind">
              <span class="cs__ind-lbl">{it ? 'Dolce' : 'Sweet'}</span>
              <div class="cs__bar-track" role="img" aria-label={`sweetness ${c.sweetness}/5`}>
                <div class="cs__bar-fill" style={`left:${((c.sweetness - 1) / 4) * 100}%`}></div>
              </div>
              <span class="cs__ind-lbl">{it ? 'Secco' : 'Dry'}</span>
            </div>
            <div class="cs__ind">
              <span class="cs__ind-lbl">{it ? 'Leggero' : 'Light'}</span>
              <div class="cs__bar-track" role="img" aria-label={`alcohol ${c.alcohol}/5`}>
                <div class="cs__bar-fill" style={`left:${((c.alcohol - 1) / 4) * 100}%`}></div>
              </div>
              <span class="cs__ind-lbl">{it ? 'Intenso' : 'Intense'}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cs {
    padding-inline: 0;
    padding-top: calc(var(--space-l) * 0.81);
    padding-bottom: calc(var(--space-xl) * 0.81);
  }

  /* ── Header row ── */
  .cs__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    margin-bottom: calc(var(--space-l) * 0.81);
  }
  .cs__title {
    font-family: var(--font-display);
    font-size: clamp(1.22rem, 0.88rem + 1.22vw, 1.87rem);
    font-weight: 300;
    line-height: 1.1;
    margin-top: var(--space-s);
  }
  .cs__title em {
    font-style: italic;
    color: var(--color-accent-on-dark);
  }

  /* ── Arrows (top-right of header) ── */
  .cs__nav {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
    padding-bottom: 0.2rem;
  }
  .cs__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .cs__arrow:hover {
    border-color: var(--color-accent-on-dark);
    color: var(--color-accent-on-dark);
  }
  @media (max-width: 600px) {
    .cs__arrow {
      width: 2.2rem;
      height: 2.2rem;
    }
  }

  /* ── Track ── */
  .cs__track-wrap {
    overflow: hidden;
  }
  .cs__track {
    display: flex;
    gap: 1.36rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-inline: var(--gutter);
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }
  .cs__track:active { cursor: grabbing; }
  .cs__track::-webkit-scrollbar { display: none; }

  /* ── Slide ── */
  .cs__slide {
    flex-shrink: 0;
    width: clamp(110px, 12.4vw, 159px);
    scroll-snap-align: start;
  }
  .cs__frame {
    border: 1px solid var(--color-accent-on-dark);
    padding: 5px;
  }
  .cs__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .cs__media :global(img) {
    transition: transform 1.2s var(--ease-out);
  }
  .cs__slide:hover .cs__media :global(img) {
    transform: scale(1.04);
  }
  .cs__placeholder {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.06);
  }

  /* ── Info area ── */
  .cs__info {
    padding-top: 0.61rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cs__name {
    font-family: var(--font-display);
    font-size: clamp(0.65rem, 0.54rem + 0.34vw, 0.82rem);
    font-weight: 400;
    line-height: 1.25;
    color: #fff;
    margin-bottom: 0.58rem;
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* ── Indicators (dolce/secco · leggero/intenso) ── */
  .cs__ind {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .cs__ind-lbl {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.32);
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* ── Alcohol indicator: thin line + vertical gold tick ── */
  .cs__bar-track {
    position: relative;
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
  }
  .cs__bar-fill {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-on-dark);
  }
</style>

<script>
  const track = document.querySelector('.cs__track') as HTMLElement | null;
  if (track) {
    let paused = false;
    let raf: number;
    const SPEED = 0.5;
    let pos = 0;
    let totalW = 0;

    function getTotal() {
      return track!.scrollWidth / 2;
    }

    function applyPos() {
      if (totalW > 0) {
        pos = ((pos % totalW) + totalW) % totalW;
      }
      track!.style.transform = `translateX(${-pos}px)`;
    }

    function tick() {
      if (!paused) {
        pos += SPEED;
        totalW = getTotal();
        applyPos();
      }
      raf = requestAnimationFrame(tick);
    }

    // Duplicate slides for seamless loop
    const slides = Array.from(track.querySelectorAll('.cs__slide'));
    slides.forEach((s) => track.appendChild(s.cloneNode(true)));

    track.style.overflowX = 'visible';
    track.style.scrollSnapType = 'none';

    totalW = getTotal();

    // ── Drag (mouse) ──
    let dragging = false;
    let dragStartX = 0;
    let posAtDragStart = 0;

    track.addEventListener('mousedown', (e) => {
      dragging = true;
      paused = true;
      dragStartX = e.clientX;
      posAtDragStart = pos;
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      totalW = getTotal();
      pos = posAtDragStart + (dragStartX - e.clientX);
      applyPos();
    });
    window.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      setTimeout(() => { paused = false; }, 1200);
    });

    // ── Drag (touch) ──
    let touchStartX = 0;
    let posAtTouchStart = 0;

    track.addEventListener('touchstart', (e) => {
      paused = true;
      touchStartX = e.touches[0].clientX;
      posAtTouchStart = pos;
    }, { passive: true });
    track.addEventListener('touchmove', (e) => {
      totalW = getTotal();
      pos = posAtTouchStart + (touchStartX - e.touches[0].clientX);
      applyPos();
    }, { passive: true });
    track.addEventListener('touchend', () => {
      setTimeout(() => { paused = false; }, 1800);
    }, { passive: true });

    // Pause on hover (when not dragging)
    track.addEventListener('mouseenter', () => { if (!dragging) paused = true; });
    track.addEventListener('mouseleave', () => { if (!dragging) paused = false; });

    // ── Arrow buttons (now in section header, not track-wrap) ──
    const section = track.closest('.cs') as HTMLElement;

    let animRaf = 0;
    function easeInOut(t: number) {
      return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    }
    function nudge(dir: number) {
      paused = true;
      cancelAnimationFrame(animRaf);
      const slide = track!.querySelector<HTMLElement>('.cs__slide');
      const gap = parseFloat(getComputedStyle(track!).gap) || 2;
      const delta = dir * ((slide?.offsetWidth ?? 280) + gap);
      const startPos = pos;
      const duration = 480;
      const start = performance.now();
      function step(now: number) {
        const t = Math.min((now - start) / duration, 1);
        pos = startPos + delta * easeInOut(t);
        totalW = getTotal();
        applyPos();
        if (t < 1) {
          animRaf = requestAnimationFrame(step);
        } else {
          pos = startPos + delta;
          totalW = getTotal();
          applyPos();
          setTimeout(() => { paused = false; }, 500);
        }
      }
      animRaf = requestAnimationFrame(step);
    }

    section?.querySelector('.cs__prev')?.addEventListener('click', () => nudge(-1));
    section?.querySelector('.cs__next')?.addEventListener('click', () => nudge(1));

    raf = requestAnimationFrame(tick);
  }
</script>
