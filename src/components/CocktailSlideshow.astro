---
import type { Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { featuredCocktails } from '@/data/cocktails';
import Img from './Img.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const it = lang === 'it';
---

<section class="section section--dark cs" aria-labelledby="cs-title">
  <div class="container cs__head">
    <div>
      <p class="eyebrow" data-reveal>Cocktail · Experience</p>
      <h2 id="cs-title" class="cs__title" data-reveal style="--delay:.06s">
        {it ? <>La nostra <em>cocktail list.</em></> : <>Our <em>cocktail list.</em></>}
      </h2>
    </div>
    <div class="cs__nav">
      <button class="cs__arrow cs__prev" aria-label={it ? 'Precedente' : 'Previous'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="cs__arrow cs__next" aria-label={it ? 'Successivo' : 'Next'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="cs__track-wrap">
    <ul class="cs__track" role="list">
      {featuredCocktails.map((c, i) => (
        <li class="cs__slide" data-reveal style={`--delay:${i * 0.04}s`}>
          <div class="cs__frame">
            <div class="cs__media media">
              {c.image
                ? <Img src={c.image} alt={c.name} sizes="(min-width: 900px) 24vw, 50vw" widths={[280, 560]} />
                : <div class="cs__placeholder" aria-hidden="true"></div>
              }
            </div>
          </div>
          <div class="cs__info">
            <h3 class="cs__name">{c.name}</h3>
            <div class="cs__ind">
              <span class="cs__ind-lbl">{it ? 'Dolce' : 'Sweet'}</span>
              <div class="cs__bar-track" role="img" aria-label={`sweetness ${c.sweetness}/5`}>
                <div class="cs__bar-fill" style={`left:${((c.sweetness - 1) / 4) * 100}%`}></div>
              </div>
              <span class="cs__ind-lbl">{it ? 'Secco' : 'Dry'}</span>
            </div>
            <div class="cs__ind">
              <span class="cs__ind-lbl">{it ? 'Leggero' : 'Light'}</span>
              <div class="cs__bar-track" role="img" aria-label={`alcohol ${c.alcohol}/5`}>
                <div class="cs__bar-fill" style={`left:${((c.alcohol - 1) / 4) * 100}%`}></div>
              </div>
              <span class="cs__ind-lbl">{it ? 'Intenso' : 'Intense'}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cs {
    padding-inline: 0;
    padding-top: calc(var(--space-l) * 0.81);
    padding-bottom: calc(var(--space-l) * 0.7);
  }

  /* ── Header row ── */
  .cs__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    margin-bottom: calc(var(--space-l) * 0.81);
  }
  .cs__title {
    font-family: var(--font-display);
    font-size: clamp(1.22rem, 0.88rem + 1.22vw, 1.87rem);
    font-weight: 300;
    line-height: 1.1;
    margin-top: var(--space-s);
  }
  .cs__title em {
    font-style: italic;
    color: var(--color-accent-on-dark);
  }

  /* ── Arrows (top-right of header) ── */
  .cs__nav {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
    padding-bottom: 0.2rem;
  }
  .cs__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .cs__arrow:hover {
    border-color: var(--color-accent-on-dark);
    color: var(--color-accent-on-dark);
  }
  @media (max-width: 600px) {
    .cs__arrow {
      width: 2.2rem;
      height: 2.2rem;
    }
  }

  /* ── Track ── */
  .cs__track-wrap {
    overflow: hidden;
  }
  .cs__track {
    display: flex;
    gap: 1.36rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-inline: var(--gutter);
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    /* JS drives the horizontal motion; vertical swipes still scroll the page */
    touch-action: pan-y;
    will-change: transform;
  }
  .cs__track:active { cursor: grabbing; }
  .cs__track::-webkit-scrollbar { display: none; }

  /* ── Slide ── */
  /* slides stretch to the tallest one; indicators are pushed to the bottom so
     they line up across all cocktails, whatever the name length */
  .cs__slide {
    flex-shrink: 0;
    width: clamp(110px, 12.4vw, 159px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .cs__frame {
    border: 1px solid var(--color-accent-on-dark);
    padding: 5px;
  }
  .cs__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .cs__media :global(img) {
    transition: transform 1.2s var(--ease-out);
  }
  .cs__slide:hover .cs__media :global(img) {
    transform: scale(1.04);
  }
  .cs__placeholder {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.06);
  }

  /* ── Info area ── */
  .cs__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 0.61rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cs__name {
    font-family: var(--font-display);
    font-size: clamp(0.65rem, 0.54rem + 0.34vw, 0.82rem);
    font-weight: 400;
    line-height: 1.25;
    color: #fff;
    padding-bottom: 0.58rem;
    margin-bottom: auto;
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* ── Indicators (dolce/secco · leggero/intenso) ── */
  .cs__ind {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .cs__ind-lbl {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.32);
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* ── Alcohol indicator: thin line + vertical gold tick ── */
  .cs__bar-track {
    position: relative;
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
  }
  .cs__bar-fill {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-on-dark);
  }
</style>

<script>
  const track = document.querySelector('.cs__track') as HTMLElement | null;
  if (track) {
    // Time-based marquee with inertia: auto-scrolls, can be dragged or flicked,
    // and always eases back to the auto speed instead of jumping.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const AUTO = 0.03;      // px per ms (≈ 0.5px per frame at 60fps)
    const EASE_MS = 650;    // time constant for easing towards the target speed
    const FLICK = 0.6375;   // share of the finger's speed kept as glide after release
    const MAX_FLICK = 1.59; // px per ms, cap on release velocity

    let pos = 0;
    let vel = AUTO;
    let totalW = 0;
    let hovering = false;
    let holdUntil = 0;      // keep still for a moment after a drag/nudge
    let last = performance.now();

    // Duplicate slides for a seamless loop
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.cs__slide'));
    slides.forEach((s) => track.appendChild(s.cloneNode(true)));
    const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.cs__slide'));

    // Reveal every slide together when the strip enters the viewport, so
    // slides don't fade in one by one while they move (clones included).
    const revealIo = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        allSlides.forEach((s) => s.classList.add('is-visible'));
        revealIo.disconnect();
      }
    });
    revealIo.observe(track);

    track.style.overflowX = 'visible';
    track.style.scrollSnapType = 'none';

    // Width of one set of slides, cached (reading scrollWidth every frame forces layout)
    const measure = () => { totalW = track.scrollWidth / 2; };
    measure();
    new ResizeObserver(measure).observe(track);

    const render = () => {
      if (totalW > 0) pos = ((pos % totalW) + totalW) % totalW;
      track.style.transform = `translate3d(${-pos}px, 0, 0)`;
    };

    // ── Drag (pointer: mouse, touch, pen) ──
    let dragging = false;
    let startX = 0;
    let posAtStart = 0;
    let lastX = 0;
    let lastT = 0;
    let dragVel = 0;

    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      startX = lastX = e.clientX;
      lastT = e.timeStamp;
      posAtStart = pos;
      dragVel = 0;
      vel = 0;
      track.setPointerCapture(e.pointerId);
      if (e.pointerType === 'mouse') e.preventDefault();
    });
    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      pos = posAtStart + (startX - e.clientX);
      const dt = e.timeStamp - lastT;
      if (dt > 0) {
        // smoothed release velocity (px/ms)
        dragVel = 0.8 * ((lastX - e.clientX) / dt) + 0.2 * dragVel;
        lastX = e.clientX;
        lastT = e.timeStamp;
      }
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      // ignore a stale velocity if the finger rested before lifting
      const fresh = e.timeStamp - lastT < 80;
      vel = fresh ? Math.max(-MAX_FLICK, Math.min(MAX_FLICK, dragVel * FLICK)) : 0;
      holdUntil = performance.now() + 900;
    };
    track.addEventListener('dragstart', (e) => e.preventDefault()); // no native image drag
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // Ease to a stop on hover (desktop), resume smoothly on leave
    track.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
    track.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') hovering = false; });

    // ── Arrow buttons (section header) ──
    const section = track.closest('.cs') as HTMLElement;
    let nudgeFrom = 0;
    let nudgeTo = 0;
    let nudgeStart = -1;
    const NUDGE_MS = 520;
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    function nudge(dir: number) {
      const slide = track!.querySelector<HTMLElement>('.cs__slide');
      const gap = parseFloat(getComputedStyle(track!).columnGap) || 0;
      nudgeFrom = pos;
      nudgeTo = pos + dir * ((slide?.offsetWidth ?? 280) + gap);
      nudgeStart = performance.now();
      vel = 0;
    }
    section?.querySelector('.cs__prev')?.addEventListener('click', () => nudge(-1));
    section?.querySelector('.cs__next')?.addEventListener('click', () => nudge(1));

    // ── Frame loop ──
    function tick(now: number) {
      const dt = Math.min(now - last, 64); // clamp after tab switches / long frames
      last = now;

      if (nudgeStart >= 0) {
        const t = Math.min((now - nudgeStart) / (reduceMotion.matches ? 1 : NUDGE_MS), 1);
        pos = nudgeFrom + (nudgeTo - nudgeFrom) * easeInOut(t);
        if (t >= 1) { nudgeStart = -1; holdUntil = now + 700; }
      } else if (!dragging) {
        const auto = hovering || reduceMotion.matches || now < holdUntil ? 0 : AUTO;
        // exponential easing towards the target speed: flicks glide out, autoplay ramps in
        vel += (auto - vel) * (1 - Math.exp(-dt / EASE_MS));
        pos += vel * dt;
      }
      render();
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
