---
/**
 * CarouselProgress — "P5" indicator for horizontal scroll-snap carousels.
 * A progress bar (filled part = visible share of the track, min 20%) that
 * follows the horizontal scroll, plus a "SCORRI →" button that advances one card.
 * Place it right after the scroll container and pass that container's id.
 */
import type { Lang } from '@/i18n/routes';

interface Props {
  lang: Lang;
  /** id of the horizontally scrolling element */
  for: string;
  variant?: 'dark' | 'light';
}
const { lang, for: target, variant = 'dark' } = Astro.props;
const it = lang === 'it';
---

<div class:list={['cprog', `cprog--${variant}`]} data-cprog={target} hidden>
  <div
    class="cprog__bar"
    role="progressbar"
    aria-label={it ? 'Avanzamento carosello' : 'Carousel progress'}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="cprog__fill"></span>
  </div>
  <button
    class="cprog__next"
    type="button"
    aria-controls={target}
    aria-label={it ? 'Scorri alla card successiva' : 'Scroll to the next card'}
  >
    <span>{it ? 'Scorri' : 'Scroll'}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  </button>
</div>

<style>
  .cprog {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    padding-inline: var(--gutter);
  }
  .cprog[hidden] { display: none; }

  .cprog--dark {
    --cprog-rail: rgba(246, 240, 230, 0.15);
    --cprog-accent: #c9b78f;
  }
  .cprog--light {
    --cprog-rail: rgba(23, 18, 15, 0.15);
    --cprog-accent: #a0804f;
  }

  .cprog__bar {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--cprog-rail);
    overflow: hidden;
  }
  .cprog__fill {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 20%;
    background: var(--cprog-accent);
    will-change: transform;
  }

  .cprog__next {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cprog-accent);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.25s var(--ease);
  }
  /* touch target of at least 44×44px without changing the visual size */
  .cprog__next::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 44px);
    height: max(100%, 44px);
    transform: translate(-50%, -50%);
  }
  .cprog__next svg { display: block; flex-shrink: 0; }
  .cprog__next.is-end { opacity: 0.4; cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .cprog__next { transition: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-cprog]').forEach((root) => {
    const track = document.getElementById(root.dataset.cprog ?? '');
    const bar  = root.querySelector<HTMLElement>('.cprog__bar');
    const fill = root.querySelector<HTMLElement>('.cprog__fill');
    const next = root.querySelector<HTMLButtonElement>('.cprog__next');
    if (!track || !bar || !fill || !next) return;

    let raf = 0;

    const update = () => {
      raf = 0;
      const max = track.scrollWidth - track.clientWidth;
      const hasOverflow = max > 1;
      root.hidden = !hasOverflow;
      if (!hasOverflow) return;

      const share = Math.max(track.clientWidth / track.scrollWidth, 0.2);
      const progress = Math.min(Math.max(track.scrollLeft / max, 0), 1);
      const barW = bar.clientWidth;
      fill.style.width = `${share * 100}%`;
      fill.style.transform = `translateX(${progress * barW * (1 - share)}px)`;
      bar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));

      const atEnd = track.scrollLeft >= max - 2;
      next.classList.toggle('is-end', atEnd);
      next.setAttribute('aria-disabled', String(atEnd));
    };

    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };

    next.addEventListener('click', () => {
      if (next.classList.contains('is-end')) return;
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({
        left: (card?.offsetWidth ?? track.clientWidth) + gap,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    });

    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('load', schedule, { once: true });
    // watch the cards too: overflow can change while the track itself keeps its size
    const ro = new ResizeObserver(schedule);
    ro.observe(track);
    Array.from(track.children).forEach((card) => ro.observe(card));
    update();
  });
</script>
