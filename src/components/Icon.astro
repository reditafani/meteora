---
/** Minimal line icons, used sparingly (contact links, UI controls). */
interface Props {
  name: 'arrow' | 'whatsapp' | 'instagram' | 'mail' | 'phone' | 'close' | 'menu' | 'plus' | 'pin' | 'user' | 'briefcase' | 'cocktail' | 'link' | 'snowflake' | 'star' | 'ice';
  size?: number;
  label?: string;
}
const { name, size = 18, label } = Astro.props;
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" focusable="false" {...a11y}>
  {name === 'arrow' && <path d="M4 12h15M14 6l6 6-6 6" />}
  {name === 'close' && <path d="M5 5l14 14M19 5L5 19" />}
  {name === 'menu' && <path d="M3 6h18M3 12h18M3 18h18" />}
  {name === 'plus' && <path d="M12 4v16M4 12h16" />}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="0.5" /><path d="M3.5 6l8.5 7 8.5-7" /></>)}
  {name === 'phone' && <path d="M6.6 3.5h2.7l1.4 4-2 1.4a12 12 0 0 0 6.4 6.4l1.4-2 4 1.4v2.7a1.6 1.6 0 0 1-1.7 1.6A16.9 16.9 0 0 1 5 5.2a1.6 1.6 0 0 1 1.6-1.7z" />}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" /></>)}
  {name === 'pin' && (<><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z" /><circle cx="12" cy="9.8" r="2.3" /></>)}
  {name === 'whatsapp' && (<><path d="M4 20l1.2-4.2A8.2 8.2 0 1 1 8.4 19z" /><path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6 6 0 0 0 2.8 2.4c.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.2-.8 1.5-.6.4-1.6.5-2.9 0a8.9 8.9 0 0 1-4.4-4c-.6-1.1-.6-2.3-.2-3.4z" /></>)}
  {name === 'user' && (<><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" /></>)}
  {name === 'briefcase' && (<><rect x="3" y="7" width="18" height="13" rx="1" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></>)}
  {name === 'cocktail' && (<><path d="M5 3h14l-6.5 9H11.5L5 3z" /><line x1="12" y1="12" x2="12" y2="19" /><line x1="8" y1="19" x2="16" y2="19" /></>)}
  {name === 'link' && (<><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></>)}
  {name === 'snowflake' && (<><line x1="12" y1="2" x2="12" y2="22" /><line x1="2" y1="12" x2="22" y2="12" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /><line x1="19.07" y1="4.93" x2="4.93" y2="19.07" /></>)}
  {name === 'star' && <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />}
  {name === 'ice' && (<><polyline points="21 8 21 16 12 21 3 16 3 8 12 3 21 8" /><polyline points="3 8 12 13 21 8" /><line x1="12" y1="13" x2="12" y2="21" /></>)}
</svg>
