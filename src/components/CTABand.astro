---
/** Closing conversion moment used at the end of key pages. */
import type { ImageMetadata } from 'astro';
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import Img from './Img.astro';

interface Props {
  lang: Lang;
  image: ImageMetadata;
  imageAlt: string;
  label?: string;
  trackLabel?: string;
  href?: string;
}
const { lang, image, imageAlt, label, trackLabel = 'cta_band', href } = Astro.props;
const it = lang === 'it';
---

<section class="band on-dark">
  <div class="band__media drift" aria-hidden="false">
    <Img src={image} alt={imageAlt} sizes="100vw" />
  </div>
  <div class="container band__content">
    <div class="band__title" data-reveal><slot>{it ? <h2>Immaginate il bar <em>al vostro evento.</em></h2> : <h2>Picture the bar <em>at your event.</em></h2>}</slot></div>
    <p class="lead band__lead" data-reveal style="--delay:.1s">
      <slot name="lead">{it ? 'Raccontateci data, luogo e ospiti. Vi risponderemo con una proposta su misura.' : 'Tell us the date, the place and the guests. We will reply with a tailored proposal.'}</slot>
    </p>
    <div class="cta-row" data-reveal style="--delay:.18s">
      <a class="btn btn--light" href={href ?? url('contact', lang)} data-track="cta_click" data-track-label={trackLabel}>
        {label ?? (it ? 'Richiedi un preventivo' : 'Request a quote')} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <slot name="secondary" />
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: min(90svh, 52rem);
    display: flex;
    align-items: center;
  }
  .band__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .band__media :global(picture),
  .band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(12 9 7 / 0.82), rgb(12 9 7 / 0.35) 70%, rgb(12 9 7 / 0.2));
  }
  .band__content {
    padding-block: var(--section);
  }
  .band__title :global(h2) {
    max-width: 13ch;
    font-size: clamp(2.75rem, 1.5rem + 4.5vw, 6rem);
    line-height: 1;
  }
  .band__lead {
    margin-block: var(--space-m) var(--space-l);
    max-width: 30rem;
    color: var(--color-on-dark);
  }
</style>
