---
/** REQUEST PARTNER PRICING — dedicated B2B form. Pricing is never shown publicly. */
import '@/styles/forms.css';
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import Field from './Field.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const typeOptions = it
  ? [
      { value: 'wedding-planner', label: 'Wedding Planner' },
      { value: 'location',        label: 'Location' },
      { value: 'other',           label: 'Altro professionista wedding' },
    ]
  : [
      { value: 'wedding-planner', label: 'Wedding Planner' },
      { value: 'location',        label: 'Venue' },
      { value: 'other',           label: 'Other wedding professional' },
    ];
const messages = {
  required: s.errRequired,
  email: s.errEmail,
  phone: s.errPhone,
  date: s.errDate,
  consent: s.errConsent,
  invalid: s.formInvalid,
  sending: s.sending,
  error: s.formError,
};
---

<form
  class="form"
  action={site.formEndpoint}
  method="post"
  data-lead-form
  data-form="partner"
  data-event="partner_pricing_request"
  data-done="partner-done"
  data-messages={JSON.stringify(messages)}
>
  <input type="hidden" name="form_type" value="partner" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="_t" value="" />
  <input type="hidden" name="redirect" value={url('thanks', lang)} />
  <div class="hp" aria-hidden="true">
    <label>Leave empty <input type="text" name="company_fax" tabindex="-1" autocomplete="off" /></label>
  </div>

  <Field lang={lang} name="first_name" label={it ? 'Nome' : 'First name'} required autocomplete="given-name" />
  <Field lang={lang} name="last_name" label={it ? 'Cognome' : 'Last name'} required autocomplete="family-name" />
  <Field lang={lang} name="company" label={it ? 'Nome attività' : 'Business name'} required autocomplete="organization" span="full" />
  <Field lang={lang} name="type" type="select" label={it ? 'Tipologia' : 'Type'} required options={typeOptions} placeholder={it ? 'Seleziona' : 'Select'} span="full" />
  <Field lang={lang} name="area" label={it ? 'Area / città' : 'Area / city'} required placeholder={it ? 'Es. Firenze, Chianti' : 'E.g. Florence, Tuscany'} span="full" />
  <Field lang={lang} name="email" type="email" label="Email" required autocomplete="email" inputmode="email" />
  <Field lang={lang} name="phone" type="tel" label="Telefono / WhatsApp" required autocomplete="tel" inputmode="tel" placeholder="+39 …" />
  <Field lang={lang} name="instagram" label="Instagram" placeholder="@handle" />
  <Field lang={lang} name="website" type="url" label={it ? 'Sito web' : 'Website'} placeholder="https://…" />
  <Field lang={lang} name="message" type="textarea" label={it ? 'Messaggio' : 'Message'} span="full" rows={4} />

  <div class="form__full consent-wrap">
    <label class="consent">
      <input type="checkbox" name="privacy" value="1" required aria-describedby="partner-consent-err" />
      <span set:html={s.privacyConsent.replace('{href}', url('privacy', lang))} />
    </label>
    <p class="field__err" id="partner-consent-err" aria-live="polite"></p>
  </div>

  <div class="form__full form__actions">
    <button type="submit" class="btn">{s.partnerPricing} <span class="arrow" aria-hidden="true">→</span></button>
    <p class="form__status" role="status" data-form-status></p>
  </div>
  <p class="form__full form__microcopy muted">
    {it
      ? 'Ti ricontatteremo per presentarti Meteora Events e le condizioni dedicate al settore wedding.'
      : 'We will get back to you to introduce Meteora Events and our dedicated professional terms.'}
  </p>
</form>

<div class="form-done" id="partner-done" tabindex="-1" hidden role="status">
  <p class="eyebrow">{it ? 'Richiesta ricevuta' : 'Request received'}</p>
  <h3>{it ? <>Grazie. <em>Vi ricontattiamo presto.</em></> : <>Thank you. <em>We will be in touch soon.</em></>}</h3>
  <p class="muted">
    {it
      ? 'Verificheremo la vostra realtà e vi presenteremo Meteora Events e le condizioni dedicate.'
      : 'We will review your details and introduce Meteora Events and our dedicated professional terms.'}
  </p>
</div>

<script>
  import { initForms } from '@/scripts/forms';
  initForms();
</script>

<style>
  .form__microcopy {
    font-size: var(--fs-small);
    margin-top: var(--space-s);
  }
</style>
