---
/** REQUEST PARTNER PRICING — dedicated B2B form. Pricing is never shown publicly. */
import '@/styles/forms.css';
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import Field from './Field.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const types = [
  { value: 'wedding-planner', label: 'Wedding Planner' },
  { value: 'venue', label: it ? 'Location' : 'Venue' },
  { value: 'caterer', label: 'Catering' },
  { value: 'event-professional', label: it ? 'Professionista eventi' : 'Event Professional' },
];
const volumes = [
  { value: '1-5', label: it ? '1–5 eventi' : '1–5 events' },
  { value: '6-15', label: it ? '6–15 eventi' : '6–15 events' },
  { value: '16-30', label: it ? '16–30 eventi' : '16–30 events' },
  { value: '30+', label: it ? 'Oltre 30 eventi' : '30+ events' },
];
const messages = {
  required: s.errRequired,
  email: s.errEmail,
  phone: s.errPhone,
  date: s.errDate,
  consent: s.errConsent,
  invalid: s.formInvalid,
  sending: s.sending,
  error: s.formError,
};
---

<form
  class="form"
  action={site.formEndpoint}
  method="post"
  data-lead-form
  data-form="partner"
  data-event="partner_pricing_request"
  data-done="partner-done"
  data-messages={JSON.stringify(messages)}
>
  <input type="hidden" name="form_type" value="partner" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="_t" value="" />
  <input type="hidden" name="redirect" value={url('thanks', lang)} />
  <div class="hp" aria-hidden="true">
    <label>Leave empty <input type="text" name="company_fax" tabindex="-1" autocomplete="off" /></label>
  </div>

  <fieldset class="choice form__full">
    <legend class="choice__legend">{it ? 'Siete' : 'You are'} <span class="req" aria-hidden="true">*</span></legend>
    <div class="choice__opts">
      {
        types.map((o, i) => (
          <label>
            <input type="radio" name="partner_type" value={o.value} required={i === 0} />
            <span>{o.label}</span>
          </label>
        ))
      }
    </div>
    <p class="choice__err" aria-live="polite"></p>
  </fieldset>

  <Field lang={lang} name="first_name" label={it ? 'Nome' : 'Name'} required autocomplete="given-name" />
  <Field lang={lang} name="last_name" label={it ? 'Cognome' : 'Surname'} required autocomplete="family-name" />
  <Field lang={lang} name="company" label={it ? 'Azienda' : 'Company'} required autocomplete="organization" />
  <Field lang={lang} name="role" label={it ? 'Ruolo' : 'Role'} autocomplete="organization-title" />
  <Field lang={lang} name="email" type="email" label="Email" required autocomplete="email" inputmode="email" />
  <Field lang={lang} name="phone" type="tel" label="Telefono / WhatsApp" required autocomplete="tel" inputmode="tel" placeholder="+39 …" />
  <Field lang={lang} name="website" label="Website / Instagram" placeholder="www… / @…" />
  <Field lang={lang} name="event_location" label={it ? 'Zona in cui lavorate di solito' : 'Typical event location'} required placeholder={it ? 'Es. Firenze e Chianti' : 'E.g. Florence and Chianti'} />
  <Field lang={lang} name="volume" type="select" label={it ? 'Eventi stimati all’anno' : 'Estimated annual events'} options={volumes} placeholder={it ? 'Seleziona' : 'Select'} span="full" />
  <Field lang={lang} name="message" type="textarea" label={it ? 'Messaggio' : 'Message'} span="full" rows={4} />

  <div class="form__full consent-wrap">
    <label class="consent">
      <input type="checkbox" name="privacy" value="1" required aria-describedby="partner-consent-err" />
      <span set:html={s.privacyConsent.replace('{href}', url('privacy', lang))} />
    </label>
    <p class="field__err" id="partner-consent-err" aria-live="polite"></p>
  </div>

  <div class="form__full form__actions">
    <button type="submit" class="btn">{s.partnerPricing} <span class="arrow" aria-hidden="true">→</span></button>
    <p class="form__status" role="status" data-form-status></p>
  </div>
</form>

<div class="form-done" id="partner-done" tabindex="-1" hidden role="status">
  <p class="eyebrow">{it ? 'Richiesta ricevuta' : 'Request received'}</p>
  <h3>{it ? <>Grazie. <em>Parliamo presto.</em></> : <>Thank you. <em>Let’s talk soon.</em></>}</h3>
  <p class="muted">
    {it
      ? 'Vi invieremo il listino riservato ai partner e le condizioni di collaborazione all’indirizzo indicato.'
      : 'We will send our partner price list and collaboration terms to the address you provided.'}
  </p>
</div>

<script>
  import { initForms } from '@/scripts/forms';
  initForms();
</script>
