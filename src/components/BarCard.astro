---
import type { Bar } from '@/data/bars';
import type { Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import Img from './Img.astro';

interface Props {
  bar: Bar;
  lang: Lang;
  index: number;
  sizes?: string;
}
const { bar, lang, sizes = '(min-width: 1024px) 50vw, 85vw' } = Astro.props;
const s = t(lang);
const hasSlider = bar.images.length > 1;
---

<article class:list={['barcard', bar.status === 'coming-soon' && 'barcard--soon']}>
  <div class="barcard__media media">
    {
      bar.images.length > 0 ? (
        <>
          {bar.images.map((img, i) => (
            <div class:list={['barcard__slide', i === 0 && 'is-active']} data-slide={i}>
              <Img src={img.src} alt={img.alt[lang]} sizes={sizes} />
            </div>
          ))}
          {hasSlider && (
            <>
              <button class="barcard__arrow barcard__arrow--prev" aria-label={lang === 'it' ? 'Foto precedente' : 'Previous photo'} data-prev>
                <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true">
                  <path d="M8 1 1 8l7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="barcard__arrow barcard__arrow--next" aria-label={lang === 'it' ? 'Foto successiva' : 'Next photo'} data-next>
                <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true">
                  <path d="M1 1l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="barcard__dots" aria-hidden="true">
                {bar.images.map((_, i) => (
                  <span class:list={['barcard__dot', i === 0 && 'is-active']} data-dot={i}></span>
                ))}
              </div>
            </>
          )}
        </>
      ) : (
        <div class="barcard__swatch" style={`--swatch:${bar.swatch}`} role="img" aria-label={`${bar.name} — ${s.comingSoon}`}>
          <span>{s.comingSoon}</span>
        </div>
      )
    }
  </div>
  <div class="barcard__body">
    {bar.status === 'coming-soon' && <p class="micro barcard__n">{s.comingSoon}</p>}
    <h3 class="barcard__name">{bar.name}</h3>
    <p class="barcard__mood">{bar.mood[lang]}</p>
    <p class="barcard__desc muted">{bar.description[lang]}</p>
    <p class="barcard__ideal"><span class="micro">{s.idealFor}</span> {bar.idealFor[lang].join(' · ')}</p>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('.barcard').forEach(card => {
    const slides = card.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = card.querySelectorAll<HTMLElement>('[data-dot]');
    const prev = card.querySelector<HTMLButtonElement>('[data-prev]');
    const next = card.querySelector<HTMLButtonElement>('[data-next]');
    if (!prev || !next || slides.length < 2) return;

    let current = 0;

    function go(to: number) {
      slides[current].classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = ((to % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      dots[current]?.classList.add('is-active');
    }

    prev.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); go(current - 1); });
    next.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); go(current + 1); });
    dots.forEach((dot, i) => {
      dot.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); go(i); });
    });

    let touchX = 0;
    const media = card.querySelector<HTMLElement>('.barcard__media');
    media?.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    media?.addEventListener('touchend', (e) => {
      const dx = touchX - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) go(current + (dx > 0 ? 1 : -1));
    }, { passive: true });
  });
</script>

<style>
  .barcard {
    position: relative;
    display: grid;
    gap: var(--space-m);
  }
  .barcard__media {
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
  }

  /* ── Slides ── */
  .barcard__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.55s ease;
  }
  .barcard__slide.is-active {
    opacity: 1;
    z-index: 1;
  }
  .barcard__slide :global(picture),
  .barcard__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .barcard:hover .barcard__slide.is-active :global(img) {
    transform: scale(1.04);
  }

  /* ── Navigation arrows ── */
  .barcard__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 5, 3, 0.52);
    color: #fff;
    border: 1px solid rgba(255 255 255 / 0.18);
    border-radius: 50%;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.2s, opacity 0.2s;
    opacity: 0.55;
  }
  .barcard__arrow--prev { left: 0.75rem; }
  .barcard__arrow--next { right: 0.75rem; }
  .barcard__arrow:hover,
  .barcard:hover .barcard__arrow { opacity: 1; background: rgba(8, 5, 3, 0.78); }

  /* ── Dot indicators ── */
  .barcard__dots {
    position: absolute;
    bottom: 0.65rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 0.35rem;
  }
  .barcard__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255 255 255 / 0.45);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .barcard__dot.is-active {
    background: #fff;
    transform: scale(1.2);
  }

  /* ── Swatch (coming-soon) ── */
  .barcard__swatch {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 30% 20%, color-mix(in srgb, var(--swatch) 70%, white) 0%, var(--swatch) 55%, color-mix(in srgb, var(--swatch) 70%, black) 100%);
  }
  .barcard__swatch span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: rgb(255 255 255 / 0.85);
    mix-blend-mode: overlay;
    letter-spacing: 0.02em;
  }

  /* ── Body text ── */
  .barcard__n {
    color: var(--color-accent-ink);
  }
  .barcard__name {
    font-size: var(--fs-h3);
    margin-top: 0.35rem;
  }
  .barcard__mood {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    margin-top: 0.25rem;
  }
  .barcard__desc {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
  }
  .barcard__ideal {
    margin-top: 0.9rem;
    font-size: var(--fs-small);
  }
  .barcard__ideal .micro {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }
  .barcard--soon .barcard__name {
    color: var(--color-text-muted);
  }
  @media (hover: none) {
    .barcard__slide :global(img) { transition: none; }
    .barcard:hover .barcard__slide.is-active :global(img) { transform: none; }
  }
</style>
