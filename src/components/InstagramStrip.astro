---
/**
 * Live Instagram feed via Behold.so widget.
 * Replace BEHOLD_FEED_ID with the real ID from behold.so.
 */
import type { Lang } from '@/i18n/routes';
import { site } from '@/data/site';

/* ─── Replace this placeholder with the feed ID from behold.so ─── */
const BEHOLD_FEED_ID = 'BEHOLD_FEED_ID';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
---

<section class="section ig" aria-labelledby="ig-title">
  <div class="container">
    <div class="ig__head">
      <div>
        <p class="eyebrow" data-reveal>Instagram</p>
        <h2 id="ig-title" class="h3 ig__title" data-reveal style="--delay:.06s">
          {it ? <>Dietro al banco, <em>evento dopo evento.</em></> : <>Behind the bar, <em>event after event.</em></>}
        </h2>
      </div>
      <a class="link" href={site.instagram.url} target="_blank" rel="noopener" data-track="instagram_click" data-track-label="strip_header">{site.instagram.handle}</a>
    </div>

    <div class="ig__feed">
      <behold-widget feed-id={BEHOLD_FEED_ID}></behold-widget>
    </div>
  </div>
</section>

<script type="module" src="https://w.behold.so/widget.js"></script>

<style>
  .ig__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }
  .ig__title {
    margin-top: var(--space-s);
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.75rem);
  }
  .ig__title em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .ig__feed {
    width: 100%;
  }
</style>
