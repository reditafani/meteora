---
import Img from './Img.astro';
import type { ImageMetadata } from 'astro';

interface Venue {
  name: string;
  location: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  venues: Venue[];
}

const { venues } = Astro.props;
---

<div class="vs">
  <ul class="vs__list" role="list">
    {
      venues.map((v, i) => (
        <li class="vs__item" data-reveal style={`--delay:${i * 0.08}s`}>
          <div class="vs__media">
            <Img src={v.image} alt={v.imageAlt} sizes="(min-width: 960px) 33vw, (min-width: 600px) 50vw, 85vw" />
          </div>
          <div class="vs__overlay">
            <p class="vs__name">{v.name}</p>
            <p class="vs__location">{v.location}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .vs {
    overflow: hidden;
  }

  .vs__list {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .vs__list::-webkit-scrollbar {
    display: none;
  }

  .vs__item {
    position: relative;
    flex: 0 0 85vw;
    scroll-snap-align: start;
    overflow: hidden;
  }

  .vs__media {
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
  }
  .vs__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.8s var(--ease-out);
  }
  .vs__item:hover .vs__media :global(img) {
    transform: scale(1.04);
  }

  /* gradient overlay */
  .vs__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(21, 17, 14, 0.78) 0%,
      rgba(21, 17, 14, 0.18) 42%,
      transparent 65%
    );
    pointer-events: none;
  }

  .vs__overlay {
    position: absolute;
    bottom: var(--space-l);
    left: var(--space-l);
    z-index: 1;
    pointer-events: none;
  }

  .vs__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.625rem);
    font-style: italic;
    font-weight: 300;
    line-height: var(--lh-tight);
    color: #fff;
    letter-spacing: 0.01em;
  }

  .vs__location {
    margin-top: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (min-width: 600px) {
    .vs__item {
      flex: 0 0 calc(50% - 2px);
    }
  }

  @media (min-width: 960px) {
    .vs__list {
      overflow-x: visible;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
    }
    .vs__item {
      flex: unset;
    }
    .vs__media {
      aspect-ratio: 3 / 4;
    }
  }
</style>
