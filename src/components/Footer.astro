---
import type { Alternates, Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Alternates>;
}
const { lang, alternates } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const nav = [
  { key: 'about',    label: it ? 'Chi siamo'             : 'About us'               },
  { key: 'services', label: it ? 'I nostri servizi'      : 'Our Services'           },
  { key: 'bars',     label: it ? 'I nostri banchi bar'   : 'Our Bar Collection'     },
  { key: 'partners', label: it ? 'Fornitori consigliati' : 'Recommended suppliers'  },
  { key: 'ice',      label: it ? 'Noleggio ghiaccio'     : 'Ice Rental'            },
  { key: 'contact',  label: it ? 'Contatti'              : 'Contact'               },
] as const;
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">

    <!-- ── Mobile top bar (logo + icons + lang) ── -->
    <div class="footer__m-top">
      <a href={url('home', lang)} class="footer__m-logo" aria-label={site.name}>
        <Logo variant="gold" width={110} />
      </a>
      <div class="footer__m-actions">
        <a class="footer__m-btn" href={url('contact', lang)} aria-label="Email" data-track="email_click">
          <Icon name="mail" size={19} />
        </a>
        <a class="footer__m-btn" href={site.instagram.url} target="_blank" rel="noopener" aria-label="Instagram" data-track="instagram_click">
          <Icon name="instagram" size={19} />
        </a>
        <div class="footer__m-lang">
          <LanguageSwitcher lang={lang} alternates={alternates} />
        </div>
      </div>
    </div>

    <!-- ── Desktop grid ── -->
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo variant="gold" width={150} />
        <p class="muted footer__addr">
          {site.address.street}<br />
          {site.address.locality}, {it ? site.address.region : site.address.regionEn}<br />
          P.IVA {site.legal.vatNumber}
        </p>
      </div>

      <nav class="footer__explore" aria-label={s.footerNav}>
        <h2 class="micro footer__h">{s.footerNav}</h2>
        <ul role="list" class="footer__nav">
          {nav.map((n) => <li><a href={url(n.key, lang)}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="micro footer__h">{s.footerContact}</h2>
        <ul role="list" class="footer__contact">
          <li><a class="footer__contact-link" href={`mailto:${site.email}`} data-track="email_click"><Icon name="mail" size={14} />{site.email}</a></li>
          <li><a class="footer__ig" href={site.instagram.url} target="_blank" rel="noopener" data-track="instagram_click"><Icon name="instagram" size={14} />{site.instagram.handle}</a></li>
        </ul>
      </div>
    </div>

    <!-- ── Desktop bottom ── -->
    <div class="footer__bottom">
      <p class="muted">© {year} {(site.legal.companyName || site.name).replace(/\.?$/, '.')} {s.rights}</p>
      <ul role="list" class="footer__legal" aria-label={s.footerLegal}>
        <li><a href={url('privacy', lang)}>{s.privacy}</a></li>
        <li><a href={url('cookies', lang)}>{s.cookiePolicy}</a></li>
        <li><button type="button" data-cookie-open>{s.cookieSettings}</button></li>
      </ul>
      <LanguageSwitcher lang={lang} alternates={alternates} />
    </div>

    <!-- ── Mobile bottom info ── -->
    <div class="footer__m-body">
      <p class="footer__m-copy">© {year} {site.legal.companyName || site.name} · P.IVA {site.legal.vatNumber}</p>
      <p class="footer__m-addr-line">
        {site.address.street}, {site.address.postalCode} {site.address.locality} ({site.address.province})
      </p>
      <ul role="list" class="footer__m-legal">
        <li><a href={url('privacy', lang)}>{s.privacy}</a></li>
        <li><a href={url('cookies', lang)}>{s.cookiePolicy}</a></li>
        <li><button type="button" data-cookie-open>{s.cookieSettings}</button></li>
      </ul>
    </div>

  </div>
</footer>

<style>
  /* ── Base ── */
  .footer {
    padding-block: var(--space-l) calc(var(--space-m) + 4.5rem);
    background: rgb(8 5 3);
  }
  @media (min-width: 768px) {
    .footer { padding-bottom: var(--space-m); }
  }

  /* ── Hide mobile elements on desktop ── */
  .footer__m-top,
  .footer__m-body { display: none; }

  /* ── Desktop grid ── */
  .footer__grid {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-m);
  }
  @media (min-width: 900px) {
    /* content-sized columns spread edge to edge → equal empty space left and right */
    .footer__grid { grid-template-columns: repeat(4, auto); justify-content: space-between; align-items: start; }
    /* logo and address become two separate columns of the row */
    .footer__brand { display: contents; }
  }
  .footer__brand :global(img) {
    width: 150px;
    height: auto;
    margin-top: -10px;
  }
  .footer__addr,
  .footer__base {
    margin-top: var(--space-s);
    font-size: var(--fs-small);
  }
  @media (min-width: 900px) {
    /* bottom-aligned so the P.IVA line sits level with the last Explore row
       (padding matches the nav links' padding-block) */
    .footer__addr { margin-top: 0; line-height: 1.55; align-self: end; padding-bottom: 0.3rem; }
    /* logo centred on the address block's horizontal axis */
    .footer__brand :global(img) { margin-top: 0; align-self: end; margin-bottom: 0.25rem; transform: translateY(-30%); }
  }
  .footer__h {
    color: var(--color-on-dark-muted);
    margin-bottom: var(--space-s);
  }
  .footer__nav { columns: 2; column-gap: var(--space-m); }
  @media (min-width: 900px) {
    /* 3 content-sized columns × 2 links, filled top-to-bottom */
    .footer__nav {
      columns: auto;
      display: grid;
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      column-gap: var(--space-l);
    }
  }
  .footer__nav a,
  .footer__contact a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
    font-size: var(--fs-small);
    transition: color 0.3s;
  }
  .footer__nav a:hover,
  .footer__contact a:hover { color: var(--color-accent-on-dark); }

  /* ── Desktop bottom bar ── */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--fs-small);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .footer__legal a,
  .footer__legal button {
    padding-block: 0.4rem;
    text-decoration: none;
    color: var(--color-on-dark-muted);
    font-size: var(--fs-small);
  }
  .footer__legal button {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    appearance: none;
    -webkit-appearance: none;
    line-height: inherit;
    vertical-align: baseline;
    margin: 0;
    padding-inline: 0;
  }
  .footer__legal a:hover,
  .footer__legal button:hover { color: var(--color-on-dark); }
  .footer__contact a.footer__ig,
  .footer__contact a.footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .footer__contact a.footer__ig :global(svg),
  .footer__contact a.footer__contact-link :global(svg) {
    display: inline-block;
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* ── Mobile layout ── */
  @media (max-width: 767px) {
    .footer {
      padding-block: var(--space-s) 1.25rem;
    }
    .footer__grid,
    .footer__bottom { display: none; }

    /* Mobile top bar */
    .footer__m-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block: var(--space-m);
      border-bottom: 1px solid rgba(255 255 255 / 0.1);
    }
    .footer__m-logo :global(img) {
      width: 110px;
      height: auto;
      margin-top: -16px;
    }
    .footer__m-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .footer__m-btn {
      display: grid;
      place-items: center;
      width: 2.7rem;
      height: 2.7rem;
      border: 1px solid rgba(207 182 138 / 0.38);
      color: rgba(207 182 138 / 0.75);
      text-decoration: none;
      transition: color 0.2s, border-color 0.2s;
      flex-shrink: 0;
    }
    .footer__m-btn:hover {
      color: var(--color-accent-on-dark);
      border-color: rgba(207 182 138 / 0.7);
    }
    .footer__m-lang {
      display: flex;
      align-items: center;
      height: 2.7rem;
      border: 1px solid rgba(207 182 138 / 0.38);
      padding-inline: 0.65rem;
    }

    /* Mobile body */
    .footer__m-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.3rem;
      padding-block: 0.9rem 0.25rem;
    }
    .footer__m-copy {
      font-size: 0.7rem;
      color: rgba(207 182 138 / 0.65);
      line-height: 1.5;
    }
    .footer__m-addr-line,
    .footer__m-vat {
      font-size: 0.7rem;
      color: rgba(207 182 138 / 0.45);
      line-height: 1.5;
    }
    .footer__m-legal {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.2rem 1rem;
      margin-top: 0.4rem;
      list-style: none;
      padding: 0;
    }
    .footer__m-legal a,
    .footer__m-legal button {
      font-size: 0.72rem;
      color: rgba(207 182 138 / 0.5);
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
      transition: color 0.2s;
    }
    .footer__m-legal a:hover,
    .footer__m-legal button:hover { color: var(--color-accent-on-dark); }
  }
</style>
