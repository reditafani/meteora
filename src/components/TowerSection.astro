---
/** SIGNATURE TOWER EXPERIENCE — cinematic moment. Source: brochure p.15. */
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { towers } from '@/data/services';
import Img from './Img.astro';
import couple from '@/assets/images/towers/couple-pour.jpg';
import espresso from '@/assets/images/towers/espresso-martini-tower.jpg';
import sunset from '@/assets/images/towers/coupe-tower-sunset.jpg';

interface Props {
  lang: Lang;
  cta?: boolean;
  id?: string;
}
const { lang, cta = true, id = 'tower' } = Astro.props;
const it = lang === 'it';
---

<section class="tw section section--dark" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="tw__head">
      <p class="eyebrow" data-reveal>Signature Tower Experience</p>
      <h2 id={`${id}-title`} class="display tw__title" data-reveal style="--delay:.08s">
        {it ? <>Un momento pensato <em>per essere ricordato.</em></> : <>A moment designed <em>to be remembered.</em></>}
      </h2>
    </div>

    <div class="tw__stage">
      <figure class="tw__a media" data-reveal="image">
        <Img src={couple} alt={it ? 'Gli sposi versano bollicine su una tower di coppe' : 'The couple pour sparkling wine over a coupe tower'} sizes="(min-width: 960px) 44vw, 100vw" />
      </figure>
      <figure class="tw__b media" data-reveal="image" style="--delay:.15s">
        <Img src={sunset} alt={it ? 'Tower di coppe al tramonto tra gli alberi in fiore' : 'Coupe tower at sunset beneath blossoming trees'} sizes="(min-width: 960px) 24vw, 50vw" />
      </figure>
      <figure class="tw__c media" data-reveal="image" style="--delay:.3s">
        <Img src={espresso} alt={it ? 'Espresso Martini Tower su tavolo nero' : 'Espresso Martini Tower on a black table'} sizes="(min-width: 960px) 26vw, 50vw" />
      </figure>
      <div class="tw__text">
        <p class="lead" data-reveal>
          {it
            ? 'Coppe o calici disposti a cascata, riempiti dal vivo dal nostro staff o dagli sposi. Per il brindisi, il taglio della torta o l’apertura della festa: un effetto elegante, coinvolgente e altamente fotografico.'
            : 'Coupes or glasses arranged in a cascade and filled live by our staff or by the couple. For the toast, the cake cutting or opening the party: an elegant, captivating and highly photogenic moment.'}
        </p>
        <dl class="tw__list">
          {
            towers.map((g) => (
              <div data-reveal>
                <dt class="micro">{g.group[lang]}</dt>
                {g.items.map((i) => <dd>{i}</dd>)}
              </div>
            ))
          }
        </dl>
        <p class="muted tw__small">
          {it
            ? 'Desiderate un altro tipo di tower? Chiedetecelo. Disponibile in abbinamento al servizio bar, o come servizio a sé su richiesta.'
            : 'Would you like a different tower? Just ask. Available alongside the bar service, or on its own on request.'}
        </p>
        {
          cta && (
            <div class="cta-row">
              <a class="btn btn--light" href={url('services', lang, 'tower')}>{it ? 'Scopri la Tower Experience' : 'Discover the Tower Experience'}</a>
              <a class="link" href={url('contact', lang)} data-track="cta_click" data-track-label="tower_quote">{it ? 'Richiedi un preventivo' : 'Request a quote'}</a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tw__title {
    margin-top: var(--space-m);
    max-width: 12ch;
    font-size: clamp(3rem, 1.4rem + 6vw, 8.5rem);
  }
  .tw__stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }
  .tw__a {
    grid-column: 1 / -1;
    aspect-ratio: 5 / 6;
  }
  .tw__b,
  .tw__c {
    aspect-ratio: 3 / 4.4;
  }
  .tw__text {
    grid-column: 1 / -1;
    margin-top: var(--space-l);
    display: grid;
    gap: var(--space-l);
    max-width: 34rem;
  }
  .tw__list {
    display: grid;
    gap: var(--space-m);
  }
  .tw__list dt {
    color: var(--color-accent-on-dark);
    margin-bottom: 0.4rem;
  }
  .tw__list dd {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.35;
  }
  .tw__small {
    font-size: var(--fs-small);
  }
  @media (min-width: 960px) {
    .tw__stage {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-m);
      align-items: start;
    }
    .tw__a {
      grid-column: 1 / 7;
      grid-row: 1 / 3;
    }
    .tw__b {
      grid-column: 8 / 10;
      margin-top: var(--space-2xl);
    }
    .tw__c {
      grid-column: 10 / 13;
    }
    .tw__text {
      grid-column: 8 / 13;
      margin-top: var(--space-l);
    }
  }
</style>
