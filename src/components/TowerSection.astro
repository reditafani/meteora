---
import type { Lang } from '@/i18n/routes';
import Img from '@/components/Img.astro';
import imgDefault  from '@/assets/images/towers/gold-coupe-tower.jpg';
import imgSparkling from '@/assets/images/towers/couple-pour.jpg';
import imgSpritz    from '@/assets/images/bars/spritz-open-bar.jpg';
import imgEspresso  from '@/assets/images/towers/espresso-martini-tower.jpg';
import { services } from '@/data/services';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const sv = services.find(s => s.id === 'tower')!;

const slides = [
  { key: 'default',   src: imgDefault,   alt: it ? 'Tower di coppe in cristallo con bordo dorato'    : 'Gold-rimmed crystal coupe tower' },
  { key: 'sparkling', src: imgSparkling, alt: it ? 'Sposi che versano le bollicine su una tower'      : 'Couple pouring sparkling wine over a coupe tower' },
  { key: 'spritz',    src: imgSpritz,    alt: it ? 'Servizio Spritz durante un aperitivo'             : 'Spritz service during an aperitivo' },
  { key: 'espresso',  src: imgEspresso,  alt: it ? 'Tower di Espresso Martini con schiuma cremosa'    : 'Espresso Martini tower with creamy foam' },
];

const rows = [
  {
    key: 'sparkling',
    name: 'Sparkling towers',
    desc: it
      ? 'Prosecco, Franciacorta o Champagne disposti in una cascata di coppe riempite dal vivo. Il momento più scenografico e fotografato del vostro evento.'
      : 'Prosecco, Franciacorta or Champagne in a live-filled cascade of coupes. The most scenic and photographed moment of your event.',
  },
  {
    key: 'spritz',
    name: 'Spritz tower',
    desc: it
      ? 'Aperol o Campari Spritz disposti a cascata per un aperitivo dal grande impatto visivo, con i colori intensi che conquistano la scena.'
      : 'Aperol or Campari Spritz in a cascading tower — a visually striking aperitivo moment full of colour and spectacle.',
  },
  {
    key: 'espresso',
    name: 'Espresso Martini tower',
    desc: it
      ? 'Una tower di Espresso Martini cremosi e freddi per sorprendere gli ospiti dopo cena. Un finale che resta impresso nei ricordi.'
      : 'A tower of cold, creamy Espresso Martinis to delight guests after dinner. A finale they will remember.',
  },
  {
    key: 'default',
    name: it ? 'Personalizzata' : 'Bespoke',
    desc: it
      ? `Avete in mente un'altra tower? Raccontatecela, la creiamo per voi.`
      : 'Have another tower in mind? Tell us about it — we will create it for you.',
  },
];
---

<article class="tw" id="tower" aria-labelledby="tower-t">

  <!-- LEFT: 4-image slideshow -->
  <div class="tw__frame">
    <div class="tw__media">
      {slides.map((s, i) => (
        <div class:list={['tw__slide', { 'is-active': i === 0 }]} data-slide={s.key}>
          <Img src={s.src} alt={s.alt} sizes="(min-width: 960px) 45vw, 100vw" />
        </div>
      ))}
    </div>
  </div>

  <!-- RIGHT: text + expandable rows -->
  <div class="tw__text">
    <p class="micro svc__kicker" data-reveal>· {sv.kicker[lang]}</p>
    <h2 id="tower-t" class="h3 svc__title" data-reveal>Signature Tower <em>Experience</em></h2>
    <p class="lead muted" data-reveal>{it ? `Il momento che tutti aspettano di fotografare. Coppe disposte a cascata, riempite dal vivo dal nostro staff o da voi, per il brindisi, il taglio della torta o l'inizio della festa.` : sv.summary['en']}</p>
    <ul class="tw__list" role="list" data-reveal>
      {rows.map(row => (
        <li class="tw__row" data-tower={row.key}>
          <div class="tw__row-hd">
            <span class="tw__row-name">{row.name}</span>
            <span class="tw__row-icon" aria-hidden="true">
              <svg class="tw__row-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              <span class="tw__row-close">+</span>
            </span>
          </div>
          <p class="tw__row-desc">{row.desc}</p>
        </li>
      ))}
    </ul>
  </div>

</article>

<script>
  const article  = document.getElementById('tower');
  if (article) {
    const listRows = article.querySelectorAll<HTMLElement>('.tw__row');
    const slideEls = Array.from(article.querySelectorAll<HTMLElement>('.tw__slide'));
    const frame    = article.querySelector<HTMLElement>('.tw__frame');
    let cur = 0;

    function goTo(n: number) {
      cur = ((n % slideEls.length) + slideEls.length) % slideEls.length;
      slideEls.forEach((s, i) => s.classList.toggle('is-active', i === cur));
    }
    function showSlide(key: string) {
      const i = slideEls.findIndex(s => s.dataset.slide === key);
      if (i >= 0) goTo(i);
    }

    // ── Autoplay, same timing as the "Dove lavoriamo" gallery (About page).
    //    It pauses while a row is hovered or the pointer is on the photo, and
    //    stops for good once the visitor clicks/taps a row: the photo then
    //    stays on the tower they chose. ──
    const AUTOPLAY_MS = 3000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let paused = false;
    let chosen = '';   // tower the visitor clicked: autoplay is over
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => {
      stop();
      if (chosen || reduceMotion.matches || paused || document.hidden || slideEls.length < 2) return;
      timer = window.setInterval(() => goTo(cur + 1), AUTOPLAY_MS);
    };
    const pause = (on: boolean) => { paused = on; start(); };
    const choose = (key: string) => { chosen = key; showSlide(key); stop(); };

    const isTouch = window.matchMedia('(hover: none)').matches;

    listRows.forEach(row => {
      if (isTouch) {
        row.addEventListener('click', () => {
          const open = row.classList.contains('is-active');
          listRows.forEach(r => r.classList.remove('is-active'));
          if (!open) row.classList.add('is-active');
          choose(row.dataset.tower!); // closing the row keeps its photo too
        });
      } else {
        row.addEventListener('mouseenter', () => {
          listRows.forEach(r => r.classList.toggle('is-active', r === row));
          showSlide(row.dataset.tower!);
          pause(true);
        });
        row.addEventListener('mouseleave', () => {
          // the row stays open: on desktop one row is always open
          if (chosen) showSlide(chosen); // back to the tower they clicked
          pause(false);
        });
        row.addEventListener('click', () => choose(row.dataset.tower!));
      }
    });

    // ── Desktop: one row is always open (the first one to start with), so
    //    the room for a description is already there. The photo is stretched
    //    to the white text box, which keeps room for the longest description:
    //    switching rows never resizes the box or the photo. ──
    if (!isTouch) listRows[0]?.classList.add('is-active');
    const text = article.querySelector<HTMLElement>('.tw__text');
    const desktop = window.matchMedia('(min-width: 960px)');
    const reserveRoom = () => {
      if (!text) return;
      text.style.minHeight = '';
      if (!desktop.matches) return;
      const open = article.querySelector('.tw__row.is-active');
      open?.classList.remove('is-active');
      const closed = text.offsetHeight;
      let extra = 0;
      article.querySelectorAll<HTMLElement>('.tw__row-desc').forEach(d => {
        extra = Math.max(extra, Math.min(d.scrollHeight, 120)); // 120px = open max-height in CSS
      });
      open?.classList.add('is-active');
      const gap = parseFloat(getComputedStyle(document.documentElement).fontSize) * 0.45; // row gap above an open description (CSS)
      text.style.minHeight = `${Math.ceil(closed + extra + gap)}px`;
    };
    // recompute whenever the box width changes (text wraps differently)
    let lastWidth = 0;
    new ResizeObserver(() => {
      if (!text || text.offsetWidth === lastWidth) return;
      lastWidth = text.offsetWidth;
      reserveRoom();
    }).observe(article);
    window.addEventListener('resize', () => { lastWidth = 0; reserveRoom(); });
    document.fonts?.ready.then(reserveRoom);

    if (!isTouch) {
      frame?.addEventListener('mouseenter', () => pause(true));
      frame?.addEventListener('mouseleave', () => pause(false));
    }
    document.addEventListener('visibilitychange', start);
    start();
  }
</script>

<style>
  /* ── Article grid ── */
  .tw {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    scroll-margin-top: calc(var(--header-h-compact) + 1rem);
  }

  /* ── Title em (gold italic) ── */
  .svc__title em {
    font-style: italic;
    color: var(--color-accent-ink);
  }

  /* ── Left: framed slideshow ── */
  .tw__frame {
    padding: 6px;
    background: #fff;
    border: 1px solid rgba(184, 158, 114, 0.45);
  }
  .tw__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  /* Soft cross-fade: the new photo fades in on top of the old one, which
     stays visible underneath until the fade is over (no dip to the frame),
     with a gentle settle from a slight zoom */
  .tw__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0s linear 1.4s, transform 0s linear 1.4s;
  }
  .tw__slide.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
    transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1), transform 3.2s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .tw__slide, .tw__slide.is-active { transform: none; transition: opacity 0.3s ease; }
  }
  .tw__slide :global(picture),
  .tw__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Right: text ── */
  .tw__text > * + * {
    margin-top: var(--space-m);
  }

  /* Mobile: kicker, title and description before the slideshow, as in the
     other services (see .svc__item in ServicesView) */
  @media (max-width: 699px) {
    .tw { gap: 0; }
    .tw__text { display: contents; }
    .tw__text > * { order: 2; }
    .tw__text > .svc__kicker, .tw__text > .svc__title, .tw__text > .lead { order: 0; }
    .tw__frame { order: 1; margin-top: var(--space-m); }
  }

  /* ── Expandable rows ── */
  .tw__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .tw__row {
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.75rem;
    cursor: pointer; /* a click fixes the photo on that tower */
  }
  .tw__row-hd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tw__row-name {
    font-size: 0.96rem;
    transition: color 0.2s;
  }
  .tw__row.is-active .tw__row-name {
    color: var(--color-accent-ink);
  }
  /* Closed rows: a down arrow says the row opens; the open row: a cross */
  .tw__row-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 1rem; height: 1rem;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent-ink);
    flex-shrink: 0;
  }
  .tw__row-arrow,
  .tw__row-close {
    grid-area: 1 / 1;
    transition: opacity 0.2s, transform 0.3s ease;
  }
  .tw__row-close { opacity: 0; }
  .tw__row.is-active .tw__row-arrow {
    opacity: 0;
    transform: translateY(2px);
  }
  .tw__row.is-active .tw__row-close {
    opacity: 1;
    transform: rotate(45deg);
  }
  .tw__row-desc {
    font-size: var(--fs-small);
    color: var(--color-text);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    transition: max-height 0.35s ease, opacity 0.25s ease 0.05s, margin-top 0.3s ease;
  }
  .tw__row.is-active .tw__row-desc {
    max-height: 120px;
    opacity: 1;
    margin-top: 0.45rem;
  }
  /* Desktop: the closing and the opening description animate their real
     height in step (grid 0fr ↔ 1fr, same timing), so together they never
     take more room than the longest one: the box and the photo stay still. */
  @media (min-width: 700px) {
    .tw__row {
      display: grid;
      grid-template-rows: auto 0fr;
      row-gap: 0;
      transition: grid-template-rows 0.35s ease, row-gap 0.35s ease;
    }
    .tw__row.is-active {
      grid-template-rows: auto 1fr;
      row-gap: 0.45rem;
    }
    .tw__row-desc,
    .tw__row.is-active .tw__row-desc {
      min-height: 0;
      max-height: none;
      margin-top: 0;
      transition: opacity 0.25s ease;
    }
  }

  /* ── Desktop: white-box layout (same as svc__item) ── */
  @media (min-width: 960px) {
    .tw {
      display: block;
      position: relative;
      padding-left: 30%;
    }
    .tw__frame {
      position: absolute;
      left: 0;
      top: 20px;
      bottom: 20px;
      width: 34%;
      z-index: 2;
      padding: 6px;
      background: #fff;
      border: 1px solid rgba(184, 158, 114, 0.45);
    }
    .tw__media {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      overflow: hidden;
    }
    .tw__text {
      background: #fff;
      border: 1px solid rgba(184, 158, 114, 0.4);
      padding: 2.5rem 2.5rem 3rem 6rem;
      position: relative;
      z-index: 1;
    }
    .tw__text::before {
      content: '';
      position: absolute;
      inset: -7px;
      border: 1px solid rgba(184, 158, 114, 0.55);
      pointer-events: none;
      z-index: -1;
    }
  }
</style>
