---
import type { Alternates, Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Alternates>;
  current?: string;
}
const { lang, alternates, current } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const primary = [
  { key: 'weddings', label: it ? 'Matrimoni' : 'Weddings' },
  { key: 'destination', label: 'Destination Weddings' },
  { key: 'bars', label: it ? 'Banchi bar' : 'The Bar Collection' },
  { key: 'cocktails', label: 'Cocktail Experience' },
  { key: 'services', label: it ? 'Servizi' : 'Services' },
  { key: 'corporate', label: it ? 'Aziende & privati' : 'Corporate & Private' },
  { key: 'events', label: it ? 'Eventi' : 'Events' },
] as const;
const secondary = [
  { key: 'partners', label: it ? 'Wedding planner & location' : 'Planners & venues' },
  { key: 'about', label: it ? 'Chi siamo' : 'About' },
  { key: 'why', label: it ? 'Perché Meteora' : 'Why Meteora' },
  { key: 'contact', label: it ? 'Contatti' : 'Contact' },
] as const;
---

<div class="mm on-dark" id="mobile-menu" role="dialog" aria-modal="true" aria-label={s.menu} hidden data-menu>
  <div class="mm__bar container">
    <a href={url('home', lang)} class="mm__logo"><Logo variant="cream" width={110} /></a>
    <button type="button" class="mm__close" data-menu-close>
      <Icon name="close" size={26} />
      <span class="visually-hidden">{s.closeMenu}</span>
    </button>
  </div>
  <nav class="mm__body container" aria-label={s.mainNav}>
    <ul role="list" class="mm__primary">
      {
        primary.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={url(item.key, lang)} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul role="list" class="mm__secondary">
      {
        secondary.map((item) => (
          <li>
            <a href={url(item.key, lang)} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mm__foot">
      <a class="btn btn--light btn--block" href={url('contact', lang)} data-track="cta_click" data-track-label="menu_quote">{s.quote}</a>
      <div class="mm__meta">
        <LanguageSwitcher lang={lang} alternates={alternates} />
        <a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>
        <a href={site.instagram.url} target="_blank" rel="noopener" data-track="instagram_click">{site.instagram.handle}</a>
      </div>
    </div>
  </nav>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const closer = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  let lastFocus: HTMLElement | null = null;

  const focusables = () =>
    Array.from(menu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? []).filter((el) => el.offsetParent !== null);

  function open() {
    if (!menu) return;
    lastFocus = document.activeElement as HTMLElement;
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('is-open'));
    document.documentElement.style.overflow = 'hidden';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    closer?.focus();
  }
  function close() {
    if (!menu || menu.hidden) return;
    menu.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    const done = () => (menu.hidden = true);
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 400);
    lastFocus?.focus();
  }
  openers.forEach((b) => b.addEventListener('click', open));
  closer?.addEventListener('click', close);
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      const f = focusables();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
  window.matchMedia('(min-width: 1180px)').addEventListener('change', (e) => e.matches && close());
</script>

<style>
  .mm {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .mm.is-open {
    opacity: 1;
  }
  .mm__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }
  .mm__logo {
    width: 104px;
  }
  .mm__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
  }
  .mm__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding-block: var(--space-m) var(--space-l);
  }
  .mm__primary a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 350;
    line-height: 1.15;
    text-decoration: none;
    padding-block: 0.15rem;
  }
  .mm__primary a[aria-current='page'] {
    font-style: italic;
    color: var(--color-accent-on-dark);
  }
  .mm__primary li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.7s var(--ease-out);
    transition-delay: calc(0.05s * var(--i) + 0.1s);
  }
  .mm.is-open .mm__primary li {
    opacity: 1;
    transform: none;
  }
  .mm__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    padding-top: var(--space-m);
  }
  .mm__secondary a {
    display: block;
    padding-block: 0.55rem;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--color-on-dark-muted);
  }
  .mm__foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-m);
  }
  .mm__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    font-size: var(--fs-small);
    color: var(--color-on-dark-muted);
  }
  .mm__meta a {
    text-decoration: none;
  }
</style>
