---
import type { Alternates, Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Alternates>;
  current?: string;
}
const { lang, current } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const primary = [
  { key: 'about',    label: it ? 'Chi siamo'          : 'About us',         icon: 'user'      },
  { key: 'services', label: it ? 'I nostri servizi'   : 'Our Services',     icon: 'cocktail'  },
  { key: 'bars',     label: it ? 'I nostri banchi bar': 'Our Bar Collection',icon: 'briefcase' },
  { key: 'partners', label: it ? 'Collabora con noi'  : 'Work with us',     icon: 'link'      },
  { key: 'ice',      label: it ? 'Noleggio ghiaccio'  : 'Ice Rental',       icon: 'ice'       },
  { key: 'contact',  label: it ? 'Contatti'           : 'Contact',          icon: 'mail'      },
] as const;

const aboutSections = it ? [
  { id: 'a-story',    label: 'La nostra filosofia' },
  { id: 'a-included', label: 'Chiavi in mano' },
  { id: 'a-process',  label: 'Come funziona' },
  { id: 'a-serves',   label: 'I nostri eventi' },
  { id: 'a-map',      label: 'Dove lavoriamo' },
] : [
  { id: 'a-story',    label: 'Our philosophy' },
  { id: 'a-included', label: 'All-inclusive' },
  { id: 'a-process',  label: 'How it works' },
  { id: 'a-serves',   label: 'Our events' },
  { id: 'a-map',      label: 'Where we work' },
];
---

<div class="mm__backdrop" data-menu-backdrop aria-hidden="true"></div>

<aside class="mm on-dark" id="mobile-menu" role="dialog" aria-modal="true" aria-label={s.menu} hidden data-menu>
  <div class="mm__bar">
    <a href={url('home', lang)} class="mm__logo"><Logo variant="cream" width={100} /></a>
    <button type="button" class="mm__close" data-menu-close aria-label={s.closeMenu}>
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="mm__body" aria-label={s.mainNav}>
    <ul role="list" class="mm__primary">
      {primary.map((item, i) => (
        item.key === 'about' ? (
          <li class="mm__item--has-sub" style={`--i:${i}`}>
            <a href={url('about', lang)} class="mm__sub-toggle" aria-current={current === 'about' ? 'page' : undefined}>
              <span class="mm__icon"><Icon name="user" size={18} /></span>
              <span class="mm__label">{item.label}</span>
              <span class="mm__chevron" aria-hidden="true">›</span>
            </a>
            <ul class="mm__sub" role="list">
              {aboutSections.map(s => (
                <li><a href={`${url('about', lang)}#${s.id}`}>{s.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li style={`--i:${i}`}>
            <a href={url(item.key, lang)} aria-current={current === item.key ? 'page' : undefined}>
              <span class="mm__icon"><Icon name={item.icon as any} size={18} /></span>
              <span class="mm__label">{item.label}</span>
            </a>
          </li>
        )
      ))}
    </ul>

    <div class="mm__foot">
      <a class="btn btn--light btn--block" href={url('contact', lang)} data-track="cta_click" data-track-label="menu_quote">{s.quote}</a>
      <div class="mm__meta">
        <a href={`mailto:${site.email}`} data-track="email_click"><Icon name="mail" size={13} />{site.email}</a>
        <a href={site.instagram.url} target="_blank" rel="noopener" data-track="instagram_click"><Icon name="instagram" size={13} />{site.instagram.handle}</a>
      </div>
    </div>
  </nav>
</aside>

<script>
  const menu     = document.querySelector<HTMLElement>('[data-menu]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  const openers  = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const closer   = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const subList  = menu?.querySelector<HTMLElement>('.mm__sub');
  let lastFocus: HTMLElement | null = null;

  const focusables = () =>
    Array.from(menu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? []).filter(
      (el) => el.offsetParent !== null
    );

  function open() {
    if (!menu) return;
    lastFocus = document.activeElement as HTMLElement;
    menu.hidden = false;
    requestAnimationFrame(() => {
      menu.classList.add('is-open');
      backdrop?.classList.add('is-open');
    });
    document.documentElement.style.overflow = 'hidden';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    closer?.focus();
  }
  function close() {
    if (!menu || menu.hidden) return;
    menu.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    subList?.classList.remove('is-open');
    const done = () => (menu.hidden = true);
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 420);
    lastFocus?.focus();
  }

  openers.forEach((b) => b.addEventListener('click', open));
  closer?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);

  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      const f = focusables();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1180px)').addEventListener('change', (e) => e.matches && close());

  const subItem = menu?.querySelector<HTMLElement>('.mm__item--has-sub');
  subItem?.addEventListener('mouseenter', () => {
    subList?.classList.add('is-open');
  });
  subItem?.addEventListener('mouseleave', () => {
    subList?.classList.remove('is-open');
  });
</script>

<style>
  /* ── Backdrop ── */
  .mm__backdrop {
    position: fixed;
    inset: 0;
    z-index: 79;
    background: rgba(15, 11, 9, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }
  .mm__backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Panel ── */
  .mm {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    width: min(400px, 88vw);
    z-index: 80;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.42s var(--ease);
    background: var(--color-dark);
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.35);
  }
  .mm.is-open {
    transform: translateX(0);
  }

  /* ── Top bar ── */
  .mm__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-m);
    min-height: var(--header-h);
    border-bottom: 1px solid rgba(255 255 255 / 0.08);
    flex-shrink: 0;
  }
  .mm__logo {
    width: 90px;
  }
  .mm__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.4rem;
    color: var(--color-on-dark-muted);
    transition: color 0.2s;
  }
  .mm__close:hover {
    color: var(--color-on-dark);
  }

  /* ── Nav body ── */
  .mm__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-m) var(--space-m) var(--space-l);
  }

  /* ── Nav items ── */
  .mm__primary {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .mm__primary li {
    opacity: 0;
    transform: translateX(16px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.55s var(--ease-out);
    transition-delay: calc(0.045s * var(--i) + 0.08s);
  }
  .mm.is-open .mm__primary li {
    opacity: 1;
    transform: none;
  }
  .mm__primary a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .mm__primary a:hover {
    background: rgba(255 255 255 / 0.06);
    color: var(--color-accent-on-dark);
  }
  .mm__primary a[aria-current='page'] {
    color: var(--color-accent-on-dark);
    background: rgba(184, 158, 114, 0.1);
  }
  .mm__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-accent-on-dark);
    opacity: 0.8;
  }
  .mm__label {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 1.65rem);
    font-weight: 350;
    line-height: 1.15;
  }
  .mm__primary a[aria-current='page'] .mm__label {
    font-style: italic;
  }

  /* ── Footer ── */
  .mm__foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-m);
  }
  .mm__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    font-size: var(--fs-small);
    color: var(--color-on-dark-muted);
  }
  .mm__meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .mm__meta a:hover {
    color: var(--color-on-dark);
  }

  /* ── Sub-menu (Chi siamo) ── */
  .mm__sub-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.6rem;
    border-radius: 4px;
    color: var(--color-on-dark);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .mm__sub-toggle:hover,
  .mm__item--has-sub:hover > .mm__sub-toggle {
    background: rgba(255 255 255 / 0.06);
    color: var(--color-accent-on-dark);
  }
  .mm__sub-toggle[aria-current='page'] {
    color: var(--color-accent-on-dark);
    background: rgba(184, 158, 114, 0.1);
  }
  .mm__sub-toggle[aria-current='page'] .mm__label {
    font-style: italic;
  }
  .mm__chevron {
    margin-left: auto;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-accent-on-dark);
    opacity: 0.8;
    transition: transform 0.3s var(--ease-out);
  }
  .mm__item--has-sub:hover .mm__chevron {
    transform: rotate(90deg);
  }
  .mm__sub {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      max-height 0.38s var(--ease-out),
      opacity 0.3s var(--ease-out),
      transform 0.35s var(--ease-out);
    padding-left: calc(18px + 0.85rem + 0.6rem);
  }
  .mm__item--has-sub:hover .mm__sub,
  .mm__sub.is-open {
    max-height: 320px;
    opacity: 1;
    transform: translateY(0);
  }
  .mm__sub a {
    display: block;
    padding: 0.55rem 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 3vw, 1.2rem);
    font-weight: 350;
    line-height: 1.2;
    text-decoration: none;
    color: var(--color-on-dark-muted);
    border-bottom: 1px solid rgba(255 255 255 / 0.06);
    transition: color 0.2s, padding-left 0.2s;
  }
  .mm__sub li:last-child a {
    border-bottom: none;
  }
  .mm__sub a:hover {
    color: var(--color-accent-on-dark);
    padding-left: 0.8rem;
  }
</style>
