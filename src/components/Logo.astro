---
/**
 * Brand logo: vector SVGs exported from the original Illustrator file
 * (public/images/brand/). Gold has the gradient meteor trail; cream and dark
 * are single-colour versions of the same artwork.
 */
interface Props {
  variant?: 'gold' | 'cream' | 'dark';
  width?: number;
  class?: string;
  priority?: boolean;
}
const { variant = 'gold', width = 150, class: cls, priority = false } = Astro.props;

// viewBox of the artwork: 526.53 × 213.7
const RATIO = 213.7 / 526.53;
const height = Math.round(width * RATIO);
---

<img
  src={`/images/brand/logo-${variant}.svg`}
  alt="Meteora Events"
  width={width}
  height={height}
  class={cls}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
/>
