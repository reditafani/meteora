---
import type { Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';

const tuscanyItems = it
  ? ['Firenze', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia']
  : ['Florence', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia'];

const weddingItems = it
  ? ['Lago di Como', 'Costiera Amalfitana', 'Puglia', 'Roma', 'Venezia', 'Lago di Garda']
  : ['Lake Como', 'Amalfi Coast', 'Puglia', 'Rome', 'Venice', 'Lake Garda'];

const weddingKeys = ['lago-di-como', 'costiera-amalfitana', 'puglia', 'roma', 'venezia', 'lago-di-garda'];
---

<section class="section section--alt" aria-labelledby="a-map">
  <div class="container map-grid">

    <!-- LEFT: text + lists -->
    <div class="map-left">
      <p class="eyebrow" data-reveal>{it ? 'Dove lavoriamo' : 'Where we work'}</p>
      <h2 id="a-map" class="map-title" data-reveal>
        {it
          ? <>La vostra location, <em>il nostro bar.</em></>
          : <>Your location, <em>our bar.</em></>}
      </h2>
      <p class="map-tagline" data-reveal>
        {it ? 'BASE IN TOSCANA · IN TUTTA ITALIA' : 'BASED IN TUSCANY · ACROSS ITALY'}
      </p>
      <p class="muted map-desc" data-reveal>
        {it
          ? 'La Toscana è casa nostra: conosciamo le sue ville, le sue strade e i suoi tempi.'
          : 'Tuscany is our home: we know its villas, its roads and its rhythms.'}
      </p>

      <div class="map-lists">
        <!-- Tuscany column -->
        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot map-col__dot--gold" aria-hidden="true"></span>
            {it ? 'TOSCANA · CASA NOSTRA' : 'TUSCANY · HOME GROUND'}
          </p>
          <ul role="list">
            {tuscanyItems.map(name => (
              <li class="dest-item" data-highlight-loc="tuscany">{name}</li>
            ))}
          </ul>
        </div>

        <!-- Destination wedding column -->
        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot" aria-hidden="true"></span>
            DESTINATION WEDDING
          </p>
          <ul role="list">
            {weddingItems.map((name, i) => (
              <li class="dest-item" data-highlight-loc={weddingKeys[i]}>{name}</li>
            ))}
          </ul>
          <p class="map-more muted">
            {it
              ? '+ Sicilia, Umbria, Langhe, Portofino e altre'
              : '+ Sicily, Umbria, Langhe, Portofino and more'}
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT: SVG map -->
    <figure class="map-right" aria-hidden="true">
      <svg viewBox="0 0 490 570" fill="none" xmlns="http://www.w3.org/2000/svg" class="italy-svg">

        <!-- ── Italy mainland ── -->
        <path class="shape"
          d="M76,92 C82,75 92,56 110,46 C122,40 140,36 162,38 C178,38 198,42 218,42
             C235,42 250,46 268,50 L285,48 L292,68
             C290,78 282,90 272,100 C265,112 258,130 258,148
             C258,162 262,178 272,190 C280,200 292,204 310,204
             L332,200 L348,212 C356,220 360,232 358,248
             C355,260 340,268 328,275 L315,288 L300,300
             L280,310 L268,312
             C260,310 254,298 252,284
             C248,268 244,256 235,246
             C224,234 215,226 205,220
             C196,215 188,208 184,200
             C178,190 176,178 172,165
             C168,148 162,130 155,114
             C150,104 145,95 140,88
             L128,82 L108,88 L86,94 Z"/>

        <!-- ── Tuscany highlighted region ── -->
        <path class="tuscany-region" id="tuscany-region"
          d="M148,100 C145,90 143,80 148,72
             C153,68 162,66 175,68 C188,68 205,72 215,85
             C220,95 218,110 212,122 C207,135 202,148 196,158
             C188,165 176,168 164,165
             C152,162 144,148 144,128 Z"/>

        <!-- ── Sardinia ── -->
        <path class="shape"
          d="M102,268 C96,275 92,285 94,298
             C96,312 104,325 114,330 C124,336 136,332 143,320
             C150,308 150,295 145,280 C140,265 125,258 112,258 Z"/>

        <!-- ── Sicily ── -->
        <path class="shape"
          d="M252,373 L266,364 L286,360 L310,365 L328,374
             C338,382 340,398 332,408
             C322,415 310,415 295,410
             L268,408 C254,402 248,390 252,373 Z"/>

        <!-- ── Toscana italic label ── -->
        <text x="184" y="118" class="tuscany-lbl" text-anchor="middle">Toscana</text>

        <!-- ── Base marker ── -->
        <circle cx="170" cy="120" r="5" class="dot dot--base"/>
        <text x="165" y="135" class="lbl lbl--base" text-anchor="end">BASE · MONTECATINI</text>

        <!-- ── Secondary dots (not in list, smaller) ── -->
        <g class="dot-g dot-g--sec">
          <circle cx="108" cy="58" r="3" class="dot dot--sec"/>
          <text x="103" y="54" class="lbl lbl--sm" text-anchor="end">Lago Maggiore</text>
        </g>
        <g class="dot-g dot-g--sec">
          <circle cx="80" cy="108" r="3" class="dot dot--sec"/>
          <text x="75" y="104" class="lbl lbl--sm" text-anchor="end">Langhe</text>
        </g>
        <g class="dot-g dot-g--sec">
          <circle cx="118" cy="98" r="3" class="dot dot--sec"/>
          <text x="113" y="94" class="lbl lbl--sm" text-anchor="end">Portofino</text>
        </g>
        <g class="dot-g dot-g--sec">
          <circle cx="228" cy="145" r="4" class="dot"/>
          <text x="234" y="142" class="lbl" text-anchor="start">Umbria</text>
        </g>
        <g class="dot-g dot-g--sec">
          <circle cx="130" cy="292" r="3" class="dot dot--sec"/>
          <text x="125" y="288" class="lbl lbl--sm" text-anchor="end">Costa Smeralda</text>
        </g>
        <g class="dot-g dot-g--sec">
          <circle cx="315" cy="390" r="4" class="dot"/>
          <text x="322" y="387" class="lbl" text-anchor="start">Sicilia</text>
          <text x="322" y="399" class="lbl lbl--sm" text-anchor="start">Taormina</text>
        </g>

        <!-- ── Main interactive destination dots ── -->
        <g class="dot-g" data-loc="lago-di-como">
          <circle cx="148" cy="52" r="5" class="dot"/>
          <text x="154" y="48" class="lbl" text-anchor="start">Lago di Como</text>
        </g>
        <g class="dot-g" data-loc="lago-di-garda">
          <circle cx="196" cy="60" r="5" class="dot"/>
          <text x="202" y="56" class="lbl" text-anchor="start">Lago di Garda</text>
        </g>
        <g class="dot-g" data-loc="venezia">
          <circle cx="262" cy="72" r="5" class="dot"/>
          <text x="268" y="68" class="lbl" text-anchor="start">Venezia</text>
        </g>
        <g class="dot-g" data-loc="roma">
          <circle cx="185" cy="186" r="5" class="dot"/>
          <text x="179" y="182" class="lbl" text-anchor="end">Roma</text>
        </g>
        <g class="dot-g" data-loc="costiera-amalfitana">
          <circle cx="228" cy="236" r="5" class="dot"/>
          <text x="222" y="232" class="lbl" text-anchor="end">Costiera Amalfitana</text>
        </g>
        <g class="dot-g" data-loc="puglia">
          <circle cx="348" cy="215" r="5" class="dot"/>
          <text x="355" y="211" class="lbl" text-anchor="start">Puglia</text>
        </g>

      </svg>

      <!-- Legend -->
      <figcaption class="map-legend">
        <span class="map-legend__item">
          <span class="map-legend__sw map-legend__sw--gold" aria-hidden="true"></span>
          {it ? 'Casa nostra' : 'Home ground'}
        </span>
        <span class="map-legend__item">
          <span class="map-legend__sw" aria-hidden="true"></span>
          Destination wedding
        </span>
      </figcaption>
    </figure>

  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.dest-item[data-highlight-loc]');
  const tuscanyEl = document.getElementById('tuscany-region');

  function activate(loc: string) {
    if (loc === 'tuscany') {
      tuscanyEl?.classList.add('is-active');
    } else {
      document.querySelector<SVGGElement>(`.dot-g[data-loc="${loc}"]`)?.classList.add('is-active');
    }
  }
  function deactivate(loc: string) {
    if (loc === 'tuscany') {
      tuscanyEl?.classList.remove('is-active');
    } else {
      document.querySelector<SVGGElement>(`.dot-g[data-loc="${loc}"]`)?.classList.remove('is-active');
    }
  }

  items.forEach(item => {
    const loc = item.dataset.highlightLoc!;
    item.addEventListener('mouseenter', () => activate(loc));
    item.addEventListener('mouseleave', () => deactivate(loc));
    item.addEventListener('focus',      () => activate(loc));
    item.addEventListener('blur',       () => deactivate(loc));
  });
</script>

<style>
  /* ── Layout ── */
  .map-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  /* ── Left panel ── */
  .map-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4.2rem);
    font-weight: 300;
    line-height: 1.06;
    margin-top: var(--space-s);
    margin-bottom: var(--space-m);
  }
  .map-title em {
    font-style: italic;
    color: var(--color-accent-ink);
    display: block;
  }
  .map-tagline {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--color-text);
    margin-bottom: var(--space-s);
  }
  .map-desc {
    font-size: var(--fs-small);
    margin-bottom: var(--space-l);
    max-width: 30rem;
  }
  .map-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
  }
  .map-col__hd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding-bottom: var(--space-xs, 0.5rem);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-s);
  }
  .map-col__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text);
    flex-shrink: 0;
  }
  .map-col__dot--gold {
    border-radius: 2px;
    background: var(--color-accent-ink);
  }
  .map-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dest-item {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.2rem);
    font-weight: 400;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-border);
    cursor: default;
    transition: color 0.2s;
  }
  .dest-item:hover {
    color: var(--color-accent-ink);
  }
  .map-more {
    font-size: 0.78rem;
    margin-top: var(--space-s);
    line-height: 1.4;
  }

  /* ── SVG map ── */
  .map-right {
    margin: 0;
    padding: 0;
  }
  .italy-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Italy fills */
  .shape {
    fill: color-mix(in srgb, var(--color-accent-ink) 22%, var(--color-background-secondary));
  }
  .tuscany-region {
    fill: var(--color-accent-ink);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .tuscany-region.is-active {
    opacity: 1;
  }

  /* Labels */
  .tuscany-lbl {
    font-family: 'Cormorant Garamond Variable', 'Cormorant Garamond', serif;
    font-size: 13px;
    font-style: italic;
    fill: rgba(255 255 255 / 0.8);
    pointer-events: none;
  }
  .lbl {
    font-family: 'Cormorant Garamond Variable', 'Cormorant Garamond', serif;
    font-size: 11px;
    fill: var(--color-text);
    pointer-events: none;
    transition: fill 0.2s ease;
  }
  .lbl--sm {
    font-size: 9px;
    fill: color-mix(in srgb, var(--color-text) 45%, transparent);
  }
  .lbl--base {
    font-family: 'Jost Variable', 'Jost', sans-serif;
    font-size: 7.5px;
    letter-spacing: 0.05em;
    fill: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  /* Dots */
  .dot {
    fill: var(--color-text);
    transition: fill 0.2s ease;
  }
  .dot--base {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.5;
  }
  .dot--sec {
    fill: color-mix(in srgb, var(--color-text) 45%, transparent);
  }

  /* Highlight states */
  .dot-g.is-active .dot {
    fill: var(--color-accent-ink);
  }
  .dot-g.is-active .lbl {
    fill: var(--color-accent-ink);
    font-weight: 600;
  }

  /* Legend */
  .map-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-l);
    margin-top: var(--space-m);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .map-legend__item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .map-legend__sw {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-text);
    flex-shrink: 0;
  }
  .map-legend__sw--gold {
    border-radius: 2px;
    background: var(--color-accent-ink);
  }
</style>
