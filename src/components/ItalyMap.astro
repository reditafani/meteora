---
import type { Lang } from '@/i18n/routes';
import Img from '@/components/Img.astro';
import banquetHall     from '@/assets/images/venues/banquet-hall.jpg';
import florencePanorama from '@/assets/images/destinations/florence-panorama.jpg';
import amalfiCoast     from '@/assets/images/destinations/amalfi-coast.jpg';
import tuscanyHills    from '@/assets/images/destinations/tuscany-hills.jpg';
import lakeComo        from '@/assets/images/destinations/lake-como.jpg';
import tuscanyVilla    from '@/assets/images/destinations/tuscany-villa-aerial.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';

const tuscanyItems = it
  ? ['Firenze', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia']
  : ['Florence', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia'];

const weddingItems = it
  ? ['Lago di Como', 'Costiera Amalfitana', 'Puglia', 'Roma', 'Venezia', 'Lago di Garda']
  : ['Lake Como', 'Amalfi Coast', 'Puglia', 'Rome', 'Venice', 'Lake Garda'];

const slides = [
  { img: florencePanorama, alt: it ? 'Panorama di Firenze con il Duomo' : 'Florence panorama with the Duomo' },
  { img: amalfiCoast,      alt: it ? 'Costiera Amalfitana vista dal mare' : 'Amalfi Coast seen from the sea' },
  { img: tuscanyHills,     alt: it ? 'Colline toscane al tramonto' : 'Tuscany hills at sunset' },
  { img: lakeComo,         alt: it ? 'Lago di Como con fiori in primo piano' : 'Lake Como with flowers in the foreground' },
  { img: tuscanyVilla,     alt: it ? 'Villa toscana vista dall\'alto con piscina' : 'Aerial view of Tuscan villa with pool' },
  { img: banquetHall,      alt: it ? 'Sala da banchetto con soffitto affrescato' : 'Banquet hall with frescoed ceiling' },
];
---

<section class="section section--alt map-section" aria-labelledby="a-map">
  <div class="container map-grid">

    <!-- LEFT: text + lists -->
    <div class="map-left">
      <p class="eyebrow" data-reveal>{it ? 'Dove lavoriamo' : 'Where we work'}</p>
      <h2 id="a-map" class="map-title" data-reveal>
        {it
          ? <>La vostra location, <em>il nostro bar.</em></>
          : <>Your location, <em>our bar.</em></>}
      </h2>
      <p class="map-tagline" data-reveal>
        {it ? 'BASE IN TOSCANA · IN TUTTA ITALIA' : 'BASED IN TUSCANY · ACROSS ITALY'}
      </p>
      <p class="muted map-desc" data-reveal>
        {it
          ? 'La Toscana è casa nostra: conosciamo le sue ville, le sue strade e i suoi tempi.'
          : 'Tuscany is our home: we know its villas, its roads and its rhythms.'}
      </p>

      <div class="map-lists">
        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot map-col__dot--gold" aria-hidden="true"></span>
            {it ? 'TOSCANA · CASA NOSTRA' : 'TUSCANY · HOME GROUND'}
          </p>
          <ul role="list">
            {tuscanyItems.map(name => (
              <li class="dest-item">{name}</li>
            ))}
          </ul>
        </div>

        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot" aria-hidden="true"></span>
            DESTINATION WEDDING
          </p>
          <ul role="list">
            {weddingItems.map(name => (
              <li class="dest-item">{name}</li>
            ))}
          </ul>
          <p class="map-more muted">
            {it
              ? '+ Sicilia, Umbria, Langhe, Portofino e altre'
              : '+ Sicily, Umbria, Langhe, Portofino and more'}
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT: slideshow -->
    <div class="map-right" data-reveal>
      <div class="map-slideshow">
        <div class="map-slides">
          {slides.map((slide, i) => (
            <div class:list={['map-slide', i === 0 && 'is-active']} data-slide={i}>
              <Img src={slide.img} alt={slide.alt} sizes="(min-width: 900px) 38vw, 80vw" widths={[480, 800, 1200]} />
            </div>
          ))}
          <button class="map-arrow map-prev" aria-label={it ? 'Precedente' : 'Previous'}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="map-arrow map-next" aria-label={it ? 'Successivo' : 'Next'}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <div class="map-dots" role="list">
          {slides.map((_, i) => (
            <button
              class:list={['map-dot', i === 0 && 'is-active']}
              data-goto={i}
              aria-label={`${it ? 'Immagine' : 'Image'} ${i + 1}`}
              role="listitem"
            ></button>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Section ── */
  .map-section {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem);
  }

  /* ── Layout ── */
  .map-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  /* ── Left panel ── */
  .map-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4.2rem);
    font-weight: 300;
    line-height: 1.06;
    margin-top: var(--space-s);
    margin-bottom: var(--space-m);
  }
  .map-title em {
    font-style: italic;
    color: var(--color-accent-ink);
    display: block;
  }
  .map-tagline {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--color-text);
    margin-bottom: var(--space-s);
  }
  .map-desc {
    font-size: var(--fs-body);
    margin-bottom: var(--space-l);
    max-width: 30rem;
  }
  .map-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
  }
  .map-col__hd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding-bottom: var(--space-xs, 0.5rem);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-s);
  }
  .map-col__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text);
    flex-shrink: 0;
  }
  .map-col__dot--gold {
    border-radius: 2px;
    background: var(--color-accent-ink);
  }
  .map-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dest-item {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.2rem);
    font-weight: 400;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .map-more {
    font-size: 0.78rem;
    margin-top: var(--space-s);
    line-height: 1.4;
  }

  /* ── Right: slideshow ── */
  .map-right {
    width: 100%;
  }

  .map-slideshow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .map-slides {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-border);
  }

  .map-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.85s ease;
  }
  .map-slide.is-active {
    opacity: 1;
  }
  .map-slide :global(picture),
  .map-slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Arrows ── */
  .map-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid rgba(255 255 255 / 0.35);
    background: rgba(0 0 0 / 0.35);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: rgba(255 255 255 / 0.85);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .map-arrow:hover {
    border-color: var(--color-accent-ink);
    color: var(--color-accent-ink);
    background: rgba(0 0 0 / 0.55);
  }
  .map-prev { left: 0.75rem; }
  .map-next { right: 0.75rem; }

  /* ── Dots ── */
  .map-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .map-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--color-border);
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
  }
  .map-dot.is-active {
    background: var(--color-accent-ink);
    transform: scale(1.4);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.map-slideshow').forEach(show => {
    const slides = show.querySelectorAll<HTMLElement>('.map-slide');
    const dots   = show.querySelectorAll<HTMLElement>('.map-dot');
    let cur = 0;

    function goTo(n: number) {
      slides[cur].classList.remove('is-active');
      dots[cur].classList.remove('is-active');
      cur = ((n % slides.length) + slides.length) % slides.length;
      slides[cur].classList.add('is-active');
      dots[cur].classList.add('is-active');
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    show.querySelector('.map-prev')?.addEventListener('click', () => goTo(cur - 1));
    show.querySelector('.map-next')?.addEventListener('click', () => goTo(cur + 1));
  });
</script>
