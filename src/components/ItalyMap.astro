---
import type { Lang } from '@/i18n/routes';
import Img from '@/components/Img.astro';
import wFlorenceDuomo from '@/assets/images/destinations/weddings/wedding-florence-duomo.jpg';
import wChiantiVineyards from '@/assets/images/destinations/weddings/wedding-chianti-vineyards.jpg';
import wValDOrciaCypresses from '@/assets/images/destinations/weddings/wedding-val-d-orcia-cypresses.jpg';
import wSienaHillsSunset from '@/assets/images/destinations/weddings/wedding-siena-hills-sunset.jpg';
import wLuccaOldTown from '@/assets/images/destinations/weddings/wedding-lucca-old-town.jpg';
import wVersiliaBeachPier from '@/assets/images/destinations/weddings/wedding-versilia-beach-pier.jpg';
import wMaremmaPoppyFields from '@/assets/images/destinations/weddings/wedding-maremma-poppy-fields.jpg';
import wLakeComoVilla from '@/assets/images/destinations/weddings/wedding-lake-como-villa.jpg';
import wAmalfiCoastPositano from '@/assets/images/destinations/weddings/wedding-amalfi-coast-positano.jpg';
import wPugliaTrulli from '@/assets/images/destinations/weddings/wedding-puglia-trulli.jpg';
import wRomeColosseum from '@/assets/images/destinations/weddings/wedding-rome-colosseum.jpg';
import wLakeGardaLimone from '@/assets/images/destinations/weddings/wedding-lake-garda-limone.jpg';
import wUmbriaAssisi from '@/assets/images/destinations/weddings/wedding-umbria-assisi.jpg';
import wVeniceCanal from '@/assets/images/destinations/weddings/wedding-venice-canal.jpg';
import wLanghePiedmont from '@/assets/images/destinations/weddings/wedding-langhe-piedmont.jpg';
import wPortofinoHarbour from '@/assets/images/destinations/weddings/wedding-portofino-harbour.jpg';
import wCapriFaraglioni from '@/assets/images/destinations/weddings/wedding-capri-faraglioni.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';

const tuscanyItems = it
  ? ['Firenze', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia', 'Maremma']
  : ['Florence', 'Chianti', "Val d'Orcia", 'Siena', 'Lucca', 'Versilia', 'Maremma'];

const weddingItems = it
  ? ['Lago di Como', 'Costiera Amalfitana', 'Puglia', 'Roma', 'Lago di Garda', 'Umbria', 'Venezia']
  : ['Lake Como', 'Amalfi Coast', 'Puglia', 'Rome', 'Lake Garda', 'Umbria', 'Venice'];

// Gallery: one photo per destination listed on the left (same order), each
// credited with the place and the photographer in the caption
const slides = [
  { img: wFlorenceDuomo, place: it ? "Firenze" : "Florence", photo: 'Spencer Davis',
    alt: it ? 'Matrimonio a Firenze: il Duomo sopra i tetti della città' : 'Wedding in Florence: the Duomo above the city rooftops' },
  { img: wChiantiVineyards, place: it ? "Chianti" : "Chianti", photo: 'Johny Goerend',
    alt: it ? 'Matrimonio nel Chianti tra vigneti e colline' : 'Wedding in Chianti among vineyards and hills' },
  { img: wValDOrciaCypresses, place: it ? "Val d'Orcia" : "Val d'Orcia", photo: 'Doozydoom',
    alt: it ? 'Matrimonio in Val d’Orcia: viale di cipressi tra le colline' : 'Wedding in Val d’Orcia: cypress avenue across the hills' },
  { img: wSienaHillsSunset, place: it ? "Siena" : "Siena", photo: 'Wolfgang Hasselmann',
    alt: it ? 'Matrimonio a Siena: colline senesi al tramonto' : 'Wedding in Siena: Sienese hills at sunset' },
  { img: wLuccaOldTown, place: it ? "Lucca" : "Lucca", photo: 'Kateryna Senkevyich',
    alt: it ? 'Matrimonio a Lucca: torri e tetti del centro storico' : 'Wedding in Lucca: towers and rooftops of the old town' },
  { img: wVersiliaBeachPier, place: it ? "Versilia" : "Versilia", photo: 'Samuele Bertoli',
    alt: it ? 'Matrimonio in Versilia: pontile sul mare al tramonto' : 'Wedding in Versilia: seaside pier at sunset' },
  { img: wMaremmaPoppyFields, place: it ? "Maremma" : "Maremma", photo: 'Daniele Levis Pelusi',
    alt: it ? 'Matrimonio in Maremma tra campi di papaveri' : 'Wedding in Maremma among poppy fields' },
  { img: wLakeComoVilla, place: it ? "Lago di Como" : "Lake Como", photo: 'Lewis J Goetz',
    alt: it ? 'Matrimonio sul Lago di Como: villa affacciata sull’acqua' : 'Wedding on Lake Como: villa overlooking the water' },
  { img: wAmalfiCoastPositano, place: it ? "Costiera Amalfitana" : "Amalfi Coast", photo: 'Alessio Bachetti',
    alt: it ? 'Matrimonio in Costiera Amalfitana: scogliere e mare turchese' : 'Wedding on the Amalfi Coast: cliffs and turquoise sea' },
  { img: wPugliaTrulli, place: it ? "Puglia" : "Puglia", photo: 'Tania Lyahnovich',
    alt: it ? 'Matrimonio in Puglia tra trulli e bouganville' : 'Wedding in Puglia among trulli and bougainvillea' },
  { img: wRomeColosseum, place: it ? "Roma" : "Rome", photo: 'Spencer Davis',
    alt: it ? 'Matrimonio a Roma: il Colosseo visto dall’alto' : 'Wedding in Rome: aerial view of the Colosseum' },
  { img: wLakeGardaLimone, place: it ? "Lago di Garda" : "Lake Garda", photo: 'Patrick Federi',
    alt: it ? 'Matrimonio sul Lago di Garda: borgo tra montagne e lago' : 'Wedding on Lake Garda: village between mountains and lake' },
  { img: wUmbriaAssisi, place: it ? "Umbria" : "Umbria", photo: 'Achim Ruhnau',
    alt: it ? 'Matrimonio in Umbria: la rocca di Assisi' : 'Wedding in Umbria: the fortress of Assisi' },
  { img: wVeniceCanal, place: it ? "Venezia" : "Venice", photo: 'Thomas Haas',
    alt: it ? 'Matrimonio a Venezia: canale al tramonto' : 'Wedding in Venice: canal at sunset' },
  { img: wLanghePiedmont, place: it ? "Langhe" : "Langhe", photo: 'David Salamanca',
    alt: it ? 'Matrimonio nelle Langhe: campanile e colline del Piemonte' : 'Wedding in the Langhe: bell tower and Piedmont hills' },
  { img: wPortofinoHarbour, place: it ? "Portofino" : "Portofino", photo: 'Indrek Gutmann',
    alt: it ? 'Matrimonio a Portofino: il porticciolo e le case colorate' : 'Wedding in Portofino: the harbour and its colourful houses' },
  { img: wCapriFaraglioni, place: it ? "Capri" : "Capri", photo: 'Andy Holmes',
    alt: it ? 'Matrimonio a Capri: i Faraglioni e il mare' : 'Wedding in Capri: the Faraglioni and the sea' },
];
---

<section class="section section--alt map-section" aria-labelledby="a-map">
  <div class="container map-grid">

    <!-- LEFT: text + lists -->
    <div class="map-left">
      <p class="eyebrow" data-reveal>{it ? 'Dove lavoriamo' : 'Where we work'}</p>
      <h2 id="a-map" class="map-title" data-reveal>
        {it
          ? <>La vostra location, <em>il nostro bar.</em></>
          : <>Your location, <em>our bar.</em></>}
      </h2>
      <p class="map-tagline" data-reveal>
        {it ? 'BASE IN TOSCANA · IN TUTTA ITALIA' : 'BASED IN TUSCANY · ACROSS ITALY'}
      </p>
      <p class="muted map-desc" data-reveal>
        {it
          ? 'La Toscana è casa nostra: conosciamo le sue ville, le sue strade e i suoi tempi.'
          : 'Tuscany is our home: we know its villas, its roads and its rhythms.'}
      </p>

      <div class="map-lists">
        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot map-col__dot--gold" aria-hidden="true"></span>
            {it ? 'TOSCANA · CASA NOSTRA' : 'TUSCANY · HOME GROUND'}
          </p>
          <ul role="list">
            {tuscanyItems.map(name => (
              <li class="dest-item">{name}</li>
            ))}
          </ul>
        </div>

        <div class="map-col">
          <p class="map-col__hd">
            <span class="map-col__dot" aria-hidden="true"></span>
            DESTINATION WEDDING
          </p>
          <ul role="list">
            {weddingItems.map(name => (
              <li class="dest-item">{name}</li>
            ))}
          </ul>
          <p class="map-more muted">
            {it
              ? '+ Langhe, Portofino, Capri e altre'
              : '+ Langhe, Portofino, Capri and more'}
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT: slideshow -->
    <div class="map-right" data-reveal>
      <div class="map-slideshow">
        <div class="map-slides-frame">
        <div class="map-slides">
          {slides.map((slide, i) => (
            <div class:list={['map-slide', i === 0 && 'is-active']} data-slide={i}>
              <Img src={slide.img} alt={slide.alt} sizes="(min-width: 900px) 38vw, 80vw" widths={[480, 800, 1200]} />
              <p class="map-credit">{slide.place} · {it ? 'Foto di' : 'Photo by'} {slide.photo}</p>
            </div>
          ))}
          <button class="map-arrow map-prev" aria-label={it ? 'Precedente' : 'Previous'}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="map-arrow map-next" aria-label={it ? 'Successivo' : 'Next'}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        </div>
        <div class="map-dots" role="list">
          {slides.map((_, i) => (
            <button
              class:list={['map-dot', i === 0 && 'is-active']}
              data-goto={i}
              aria-label={`${it ? 'Immagine' : 'Image'} ${i + 1}`}
              role="listitem"
            ></button>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Section ── */
  .map-section {
    padding-top: var(--space-l);
    padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
    scroll-margin-top: calc(var(--header-h-compact, 4rem) + 1rem);
  }

  /* ── Layout ── */
  .map-grid {
    display: grid;
    gap: var(--space-xl);
  }
  /* Desktop: eyebrow + one-line title across both columns; below, the text
     column on the left and the gallery on the right, its top aligned with
     the "BASE IN TOSCANA · IN TUTTA ITALIA" tagline */
  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: 5fr 7fr;
      grid-template-rows: auto auto auto auto 1fr;
      align-items: start;
      column-gap: clamp(2rem, 6vw, 6rem);
      row-gap: 0;
    }
    .map-left { display: contents; }
    .map-left > .eyebrow,
    .map-title { grid-column: 1 / -1; }
    .map-grid .map-title { white-space: nowrap; }
    /* .map-grid raises specificity over the base `.map-title em { display: block }` below */
    .map-grid .map-title em { display: inline; }
    .map-tagline { grid-column: 1; grid-row: 3; }
    .map-desc    { grid-column: 1; grid-row: 4; }
    .map-lists   { grid-column: 1; grid-row: 5; }
    .map-right   { grid-column: 2; grid-row: 3 / 6; }
  }
  /* Single column: gallery right after the intro text, before the lists */
  @media (max-width: 899px) {
    .map-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .map-left { display: contents; }
    .map-right { order: 1; margin-bottom: var(--space-l); }
    .map-lists { order: 2; }
  }

  /* ── Left panel ── */
  .map-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4.2rem);
    font-weight: 300;
    line-height: 1.06;
    margin-top: var(--space-s);
    margin-bottom: var(--space-m);
  }
  .map-title em {
    font-style: italic;
    color: var(--color-accent-ink);
    display: block;
  }
  .map-tagline {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--color-text);
    margin-bottom: var(--space-s);
  }
  .map-desc {
    font-size: var(--fs-body);
    margin-bottom: var(--space-l);
    max-width: 30rem;
  }
  .map-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
  }
  .map-col__hd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding-bottom: var(--space-xs, 0.5rem);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-s);
  }
  .map-col__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text);
    flex-shrink: 0;
  }
  .map-col__dot--gold {
    border-radius: 2px;
    background: var(--color-accent-ink);
  }
  .map-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dest-item {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.86rem + 0.45vw, 1.16rem);
    font-weight: 400;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }
  .map-more {
    font-size: 0.78rem;
    margin-top: var(--space-s);
    line-height: 1.4;
  }

  /* ── Right: slideshow ── */
  .map-right {
    width: 100%;
  }

  .map-slideshow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .map-slides-frame {
    padding: 6px;
    background: #fff;
    border: 1px solid rgba(184, 158, 114, 0.45);
  }

  .map-slides {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-border);
  }

  .map-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.85s ease;
  }
  .map-slide.is-active {
    opacity: 1;
  }
  .map-slide :global(picture),
  .map-slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* place + photographer, small and neutral at the bottom of the photo */
  .map-credit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1.6rem 0.9rem 0.55rem;
    background: linear-gradient(to top, rgba(0 0 0 / 0.42), transparent);
    color: rgba(255 255 255 / 0.88);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-align: right;
    pointer-events: none;
  }

  /* ── Arrows ── */
  .map-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid rgba(255 255 255 / 0.35);
    background: rgba(0 0 0 / 0.35);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: rgba(255 255 255 / 0.85);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .map-arrow:hover {
    border-color: var(--color-accent-ink);
    color: var(--color-accent-ink);
    background: rgba(0 0 0 / 0.55);
  }
  .map-prev { left: 0.75rem; }
  .map-next { right: 0.75rem; }

  /* ── Dots ── */
  .map-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .map-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--color-border);
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
  }
  .map-dot.is-active {
    background: var(--color-accent-ink);
    transform: scale(1.4);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.map-slideshow').forEach(show => {
    const slides = show.querySelectorAll<HTMLElement>('.map-slide');
    const dots   = show.querySelectorAll<HTMLElement>('.map-dot');
    let cur = 0;

    function goTo(n: number) {
      slides[cur].classList.remove('is-active');
      dots[cur].classList.remove('is-active');
      cur = ((n % slides.length) + slides.length) % slides.length;
      slides[cur].classList.add('is-active');
      dots[cur].classList.add('is-active');
    }

    // ── Autoplay (mobile + desktop): restarts after every user interaction ──
    const AUTOPLAY_MS = 3000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let hovering = false;
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => {
      stop();
      if (reduceMotion.matches || hovering || document.hidden || slides.length < 2) return;
      timer = window.setInterval(() => goTo(cur + 1), AUTOPLAY_MS);
    };
    const userGo = (n: number) => { goTo(n); start(); };

    dots.forEach((dot, i) => dot.addEventListener('click', () => userGo(i)));
    show.querySelector('.map-prev')?.addEventListener('click', () => userGo(cur - 1));
    show.querySelector('.map-next')?.addEventListener('click', () => userGo(cur + 1));

    // pause while the pointer is over the gallery (desktop) or the tab is hidden
    show.addEventListener('mouseenter', () => { hovering = true; stop(); });
    show.addEventListener('mouseleave', () => { hovering = false; start(); });
    document.addEventListener('visibilitychange', start);

    // ── Swipe (mobile only: single-column layout below 900px) ──
    const mobile = window.matchMedia('(max-width: 899px)');
    const frame = show.querySelector<HTMLElement>('.map-slides');
    let startX = 0;
    let startY = 0;
    frame?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    frame?.addEventListener('touchend', (e) => {
      if (!mobile.matches) return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      // horizontal swipe only; vertical moves keep scrolling the page
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) userGo(dx < 0 ? cur + 1 : cur - 1);
    }, { passive: true });

    start();
  });
</script>
