---
import type { Crumb } from '@/lib/seo';
interface Props {
  crumbs: Crumb[];
  label?: string;
  tone?: 'light' | 'dark';
}
const { crumbs, label = 'Breadcrumb', tone = 'light' } = Astro.props;
---

<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label={label}>
  <ol role="list">
    {
      crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.8rem;
    font-weight: 400;
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 0.2rem;
    opacity: 0.45;
    font-size: 1em;
  }
  .crumbs a {
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .crumbs a:hover {
    opacity: 1;
  }
  .crumbs--light {
    color: var(--color-text-muted);
  }
  .crumbs--dark {
    color: rgba(255 255 255 / 0.65);
  }
  [aria-current] {
    opacity: 0.9;
  }
</style>
