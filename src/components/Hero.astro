---
/**
 * Cinematic full-screen hero. Uses a photograph by default; if `video` is
 * provided it plays muted/looped on larger screens only, never with
 * prefers-reduced-motion or Save-Data, and always keeps the poster image.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  position?: string;
  video?: { mp4?: string; webm?: string };
  eyebrow?: string;
  size?: 'full' | 'tall';
}
const { image, imageAlt, position = 'center', video, eyebrow, size = 'full' } = Astro.props;
---

<section class:list={['hero on-dark', `hero--${size}`]}>
  <div class="hero__media">
    <Img src={image} alt={imageAlt} priority sizes="100vw" position={position} class="hero__img" />
    {
      video && (video.mp4 || video.webm) && (
        <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true" data-hero-video>
          {video.webm && <source data-src={video.webm} type="video/webm" />}
          {video.mp4 && <source data-src={video.mp4} type="video/mp4" />}
        </video>
      )
    }
    <div class="hero__shade" aria-hidden="true"></div>
  </div>
  <div class="container hero__content">
    {eyebrow && <p class="eyebrow hero__eyebrow">{eyebrow}</p>}
    <slot />
  </div>
  <slot name="after" />
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const ok =
      window.matchMedia('(min-width: 768px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !conn?.saveData;
    if (ok) {
      v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => (s.src = s.dataset.src!));
      v.load();
      v.addEventListener('canplay', () => {
        v.classList.add('is-ready');
        void v.play().catch(() => {});
      }, { once: true });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .hero--tall {
    min-height: min(88svh, 60rem);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(picture),
  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .hero__video:global(.is-ready) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(img) {
      animation: hero-settle 2.8s var(--ease-out) both;
    }
    @keyframes hero-settle {
      from {
        transform: scale(1.07);
      }
      to {
        transform: scale(1);
      }
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(12 9 7 / 0.85) 0%, rgb(12 9 7 / 0.35) 45%, rgb(12 9 7 / 0.1) 70%, rgb(12 9 7 / 0.45) 100%),
      linear-gradient(to right, rgb(12 9 7 / 0.45), transparent 60%);
  }
  .hero__content {
    position: relative;
    padding-block: calc(var(--header-h) + var(--space-l)) clamp(5rem, 10vh, 8rem);
  }
  .hero--tall .hero__content {
    padding-bottom: var(--space-xl);
  }
  .hero__eyebrow {
    margin-bottom: var(--space-m);
  }
</style>
