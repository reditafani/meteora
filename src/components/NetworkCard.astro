---
import type { Professional } from '@/data/network';
import type { Lang } from '@/i18n/routes';
import { typeLabels } from '@/data/network';
import Img from '@/components/Img.astro';

interface Props {
  professional: Professional;
  lang: Lang;
}
const { professional: p, lang } = Astro.props;
const isWP = p.type === 'wedding-planner';
---

<article class:list={['nc', isWP ? 'nc--wp' : 'nc--loc']}>
  <div class:list={['media', 'nc__media']} data-reveal="image">
    {p.image
      ? <Img src={p.image} alt={p.imageAlt?.[lang] ?? p.name} sizes="(min-width: 900px) 260px, 80vw" widths={[400, 800]} />
      : <div class="nc__placeholder"></div>
    }
  </div>
  <div class="nc__body">
    <p class="micro nc__type">{typeLabels[p.type][lang]}</p>
    <h3 class="nc__name">{p.name}</h3>
    <p class="nc__area muted">{p.area[lang]}</p>
    {p.description[lang] && <p class="nc__desc muted">{p.description[lang]}</p>}
    {(p.instagram || p.website) && (
      <div class="nc__links">
        {p.instagram && (
          <a href={`https://instagram.com/${p.instagram}`} target="_blank" rel="noopener" class="nc__link">@{p.instagram}</a>
        )}
        {p.website && (
          <a href={p.website} target="_blank" rel="noopener" class="nc__link">
            {p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .nc {
    display: flex;
    flex-direction: column;
  }
  .nc--wp .nc__media {
    aspect-ratio: 3 / 4;
  }
  .nc--loc .nc__media {
    aspect-ratio: 4 / 3;
  }
  .nc__media img {
    transition: transform 1.2s var(--ease-out);
  }
  .nc:hover .nc__media img {
    transform: scale(1.04);
  }
  .nc__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-dark-2);
  }
  .nc__body {
    padding-top: var(--space-s);
    display: grid;
    gap: 0.3rem;
  }
  .nc__type {
    color: var(--color-accent-ink);
    margin-bottom: 0.2rem;
  }
  .nc__name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1vw + 1.1rem, 1.9rem);
    font-weight: 300;
    line-height: 1.15;
    transition: color 0.25s var(--ease-out);
  }
  .nc:hover .nc__name {
    color: var(--color-accent-ink);
  }
  .nc__area {
    font-size: var(--fs-small);
  }
  .nc__desc {
    font-size: var(--fs-small);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.2rem;
  }
  .nc__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.8rem;
    margin-top: 0.4rem;
  }
  .nc__link {
    font-size: var(--fs-small);
    color: var(--color-accent-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.2s;
  }
  .nc__link:hover {
    opacity: 0.7;
  }
</style>
