---
/** Editorial portfolio grid. Data: src/data/events.ts */
import type { Lang } from '@/i18n/routes';
import { routes } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { EventStory } from '@/data/events';
import Img from './Img.astro';

interface Props {
  lang: Lang;
  items: EventStory[];
  limit?: number;
}
const { lang, items, limit } = Astro.props;
const s = t(lang);
const list = limit ? items.slice(0, limit) : items;
---

<ul class="pg" role="list">
  {
    list.map((e, i) => (
      <li class:list={['pg__item', `pg__item--${i % 5}`]} data-reveal style={`--delay:${(i % 2) * 0.1}s`}>
        <a href={`${routes.events[lang]}${e.slug[lang]}/`} data-track="portfolio_interaction" data-track-label={e.slug.en}>
          <div class="pg__media media">
            <Img src={e.cover} alt={e.coverAlt[lang]} sizes="(min-width: 960px) 50vw, 100vw" />
          </div>
          <div class="pg__meta">
            <p class="micro pg__type">
              {e.type[lang]}
              {e.location && <> — {e.location[lang]}</>}
            </p>
            <h3 class="pg__title">{e.title[lang]}</h3>
            <p class="pg__excerpt muted">{e.excerpt[lang]}</p>
            <span class="link pg__cta">{s.readStory}</span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .pg {
    display: grid;
    gap: var(--space-xl) var(--space-m);
  }
  .pg a {
    display: block;
    text-decoration: none;
  }
  .pg__media {
    aspect-ratio: 3 / 2;
  }
  .pg__media :global(img) {
    transition: transform 1.6s var(--ease-out);
  }
  .pg a:hover .pg__media :global(img) {
    transform: scale(1.035);
  }
  .pg__meta {
    margin-top: var(--space-m);
    display: grid;
    gap: 0.4rem;
    max-width: 32rem;
  }
  .pg__type {
    color: var(--color-accent-ink);
  }
  .pg__title {
    font-size: var(--fs-h3);
  }
  .pg__excerpt {
    font-size: var(--fs-small);
  }
  .pg__cta {
    justify-self: start;
    margin-top: 0.3rem;
  }
  @media (min-width: 960px) {
    .pg {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2xl) var(--space-l);
    }
  }
</style>
