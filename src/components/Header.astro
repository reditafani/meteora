---
import type { Alternates, Lang } from '@/i18n/routes';
import { url } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Crumb } from '@/lib/seo';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Alternates>;
  /** 'overlay' = transparent over a dark hero until scrolled */
  theme?: 'overlay' | 'solid';
  current?: string;
  breadcrumbs?: Crumb[];
}
const { lang, alternates, theme = 'solid', current, breadcrumbs } = Astro.props;
const s = t(lang);
const it = lang === 'it';
const aboutUrl    = url('about', lang);
const servicesUrl = url('services', lang);
type NavChild = { label: string; href: string };
type NavItem  = { key: 'about' | 'services' | 'bars' | 'partners' | 'ice' | 'contact'; label: string; children?: NavChild[] };
const desktopNav: NavItem[] = [
  {
    key: 'about',
    label: it ? 'Chi siamo' : 'About',
    children: [
      { label: it ? 'La nostra filosofia' : 'Our philosophy',       href: `${aboutUrl}#a-story`    },
      { label: it ? 'Chiavi in mano'       : 'All-inclusive',        href: `${aboutUrl}#a-included` },
      { label: it ? 'Come funziona'         : 'How it works',         href: `${aboutUrl}#a-process`  },
      { label: it ? 'I nostri eventi'       : 'Our events',           href: `${aboutUrl}#a-serves`   },
      { label: it ? 'Dove lavoriamo'        : 'Where we work',        href: `${aboutUrl}#a-map`      },
    ],
  },
  {
    key: 'services',
    label: it ? 'Servizi' : 'Services',
    children: [
      { label: 'Essential experience',       href: `${servicesUrl}#essential`  },
      { label: 'Premium experience',         href: `${servicesUrl}#premium`    },
      { label: 'Aperitivo + open bar',       href: `${servicesUrl}#aperitivo`  },
      { label: 'Signature Tower Experience', href: `${servicesUrl}#tower`      },
      { label: it ? 'Bartender service' : 'Bartender service', href: `${servicesUrl}#bartender` },
      { label: it ? 'Personalizzazioni' : 'Bespoke add-ons',          href: `${servicesUrl}#personalizzazioni` },
    ],
  },
  { key: 'bars',     label: it ? 'Banchi bar' : 'Bar Collection' },
  { key: 'partners', label: it ? 'Fornitori consigliati' : 'Recommended Suppliers' },
  { key: 'ice',      label: it ? 'Noleggio ghiaccio' : 'Ice Rental' },
  { key: 'contact',  label: it ? 'Contatti'   : 'Contact'        },
];
---

<header class="site-header" data-theme={theme} data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={url('home', lang)} aria-label={`Meteora Events — ${s.breadcrumbHome}`}>
      <Logo variant="cream" width={132} class="logo logo--cream" priority />
      <Logo variant="gold" width={132} class="logo logo--gold" priority />
    </a>
    <nav class="site-header__nav" aria-label={s.mainNav}>
      {desktopNav.map(item =>
        item.children ? (
          <div class="site-header__nav-item">
            <a
              href={url(item.key, lang)}
              class:list={['site-header__nav-link', current === item.key && 'is-current']}
              aria-current={current === item.key ? 'page' : undefined}
            >{item.label}<svg class="site-header__caret" xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
            <div class="site-header__dropdown">
              {item.children.map((child, i) => (
                <a href={child.href} class="site-header__drop-link" style={`--i:${i}`}>{child.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={url(item.key, lang)}
            class:list={['site-header__nav-link', current === item.key && 'is-current']}
            aria-current={current === item.key ? 'page' : undefined}
          >{item.label}</a>
        )
      )}
    </nav>
    {breadcrumbs && breadcrumbs.length > 1 && (
      <div class="site-header__crumbs">
        <Breadcrumbs crumbs={breadcrumbs} tone={theme === 'overlay' ? 'dark' : 'light'} />
      </div>
    )}
    <div class="site-header__actions">
      <LanguageSwitcher lang={lang} alternates={alternates} class="site-header__lang" />
      <a class="btn site-header__cta" href={url('contact', lang)} data-track="cta_click" data-track-label="header_quote">
        {s.quote}
      </a>
      <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" size={24} />
        <span class="visually-hidden">{s.menu}</span>
      </button>
    </div>
  </div>
</header>
<MobileMenu lang={lang} alternates={alternates} current={current} />

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let ticking = false;
    const update = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    --fg: var(--color-text);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--fg);
    background: color-mix(in srgb, var(--color-background) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-border);
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) {
    --fg: var(--color-on-dark);
    background: linear-gradient(to bottom, rgb(12 9 7 / 0.55), rgb(12 9 7 / 0)) border-box no-repeat;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-m);
    height: var(--header-h);
    transition: height 0.45s var(--ease);
  }
  .site-header[data-scrolled] .site-header__inner {
    height: var(--header-h-compact);
  }
  .site-header__brand {
    position: relative;
    display: flex;
    align-items: center;
    flex: none;
    width: 118px;
    transition: width 0.45s var(--ease);
  }
  .site-header[data-scrolled] .site-header__brand {
    width: 96px;
  }
  .site-header__brand :global(.logo) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.4s var(--ease);
  }
  .site-header__brand :global(.logo--cream) {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) :global(.logo--cream) {
    opacity: 1;
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) :global(.logo--gold) {
    opacity: 0;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }
  .site-header__cta {
    display: none;
    min-height: 2.75rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.62rem;
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__cta {
    --btn-bg: transparent;
    --btn-fg: var(--color-on-dark);
    --btn-bd: color-mix(in srgb, var(--color-on-dark) 60%, transparent);
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__cta:hover {
    --btn-bg: var(--color-on-dark);
    --btn-fg: var(--color-dark);
  }
  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
  }
  .site-header__crumbs {
    display: none;
    flex: 1;
    align-items: center;
    overflow: hidden;
    padding-left: var(--space-m);
  }
  .site-header__crumbs :global(.crumbs) {
    line-height: 1;
  }
  .site-header__crumbs :global(.crumbs ol) {
    flex-wrap: nowrap;
    overflow: hidden;
    white-space: nowrap;
  }
  .site-header__crumbs :global(.crumbs) {
    transition: color 0.5s var(--ease);
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__crumbs :global(.crumbs) {
    color: rgba(255 255 255 / 0.65);
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__crumbs :global(.crumbs a:hover) {
    color: rgba(255 255 255 / 0.95);
  }
  .site-header[data-scrolled] .site-header__crumbs :global(.crumbs) {
    color: var(--color-text-muted);
  }
  @media (min-width: 640px) {
    .site-header__crumbs {
      display: flex;
    }
  }
  @media (min-width: 768px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  /* ── Desktop nav ── */
  .site-header__nav {
    display: none;
  }
  .site-header__nav-link {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
    opacity: 0.75;
    transition: opacity 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .site-header__nav-link:hover { opacity: 1; }
  .site-header__caret {
    display: inline-block;
    margin-left: 0.25rem;
    vertical-align: middle;
    transition: transform 0.2s;
  }
  .site-header__nav-item:hover .site-header__caret {
    transform: rotate(180deg);
  }
  .site-header__nav-link.is-current {
    opacity: 1;
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-thickness: 2px;
  }
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__nav-link:hover,
  .site-header[data-theme='overlay']:not([data-scrolled]) .site-header__nav-link.is-current {
    color: var(--color-accent-on-dark);
  }

  /* ── Dropdown ── */
  .site-header__nav-item {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
  }
  .site-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    background: rgb(8 5 3);
    border: 1px solid rgba(255 255 255 / 0.1);
    box-shadow: 0 8px 28px rgba(0 0 0 / 0.35);
    padding: 0.3rem 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 10;
  }
  /* Invisible bridge so mouse can reach dropdown */
  .site-header__dropdown::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }
  .site-header__nav-item:hover .site-header__dropdown {
    opacity: 1;
    pointer-events: auto;
  }

  /* Staggered cascade animation for each item */
  @keyframes nav-drop-in {
    from { opacity: 0; transform: translateY(-7px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .site-header__drop-link {
    display: block;
    padding: 0.62rem 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255 255 255 / 0.6);
    white-space: nowrap;
    opacity: 0;
    transition: color 0.15s, background 0.15s;
  }
  .site-header__nav-item:hover .site-header__drop-link {
    animation: nav-drop-in 0.42s ease forwards;
    animation-delay: calc(var(--i, 0) * 0.09s + 0.06s);
  }
  .site-header__drop-link:hover {
    color: var(--color-accent-on-dark);
    background: rgba(255 255 255 / 0.05);
  }

  @media (min-width: 1180px) {
    .site-header__nav {
      display: flex;
      align-items: center;
      gap: clamp(1.5rem, 2.6vw, 2.8rem);
      flex: 1;
      padding-inline: clamp(var(--space-m), 3vw, var(--space-l));
    }
    .site-header__toggle {
      display: none;
    }
    .site-header__crumbs {
      display: none;
    }
  }
</style>
