---
/**
 * Asymmetric image + text composition. Optional second, smaller image
 * overlapping the first creates the editorial "magazine spread" rhythm.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  secondImage?: ImageMetadata;
  secondAlt?: string;
  reverse?: boolean;
  ratio?: 'portrait' | 'landscape' | 'tall' | 'square';
  position?: string;
  caption?: string;
  class?: string;
}
const { image, imageAlt, secondImage, secondAlt = '', reverse = false, ratio = 'portrait', position, caption, class: cls } = Astro.props;
---

<div class:list={['ed', reverse && 'ed--reverse', secondImage && 'ed--pair', cls]}>
  <figure class="ed__figure">
    <div class:list={['ed__main media drift', `ratio-${ratio}`]} data-reveal="image">
      <Img src={image} alt={imageAlt} sizes="(min-width: 960px) 50vw, 100vw" position={position} />
    </div>
    {
      secondImage && (
        <div class="ed__second media ratio-portrait" data-reveal="image" style="--delay:.2s">
          <Img src={secondImage} alt={secondAlt} sizes="(min-width: 960px) 20vw, 45vw" />
        </div>
      )
    }
    {caption && <figcaption class="caption">{caption}</figcaption>}
  </figure>
  <div class="ed__text stack">
    <slot />
  </div>
</div>

<style>
  .ed {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .ed__figure {
    position: relative;
  }
  .ed--pair .ed__figure {
    padding-bottom: 18%;
  }
  .ed__second {
    position: absolute;
    right: -4%;
    bottom: 0;
    width: 42%;
    border: 6px solid var(--color-background);
  }
  :global(.section--alt) .ed__second {
    border-color: var(--color-background-secondary);
  }
  :global(.section--dark) .ed__second {
    border-color: var(--color-dark);
  }
  .ed__text {
    --stack: var(--space-m);
    max-width: 34rem;
  }
  @media (min-width: 960px) {
    .ed {
      grid-template-columns: 6fr 5fr;
      gap: clamp(3rem, 8vw, 9rem);
    }
    .ed--reverse {
      grid-template-columns: 5fr 6fr;
    }
    .ed--reverse .ed__figure {
      order: 2;
    }
    .ed--reverse .ed__second {
      right: auto;
      left: -8%;
    }
  }
</style>
