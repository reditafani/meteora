    .ice-lt__type { cursor: pointer; }
    .ice-lt__type-img { aspect-ratio: 1 / 1; margin-bottom: 0.4rem; }
    .ice-lt__type.is-active .ice-lt__type-img { border-color: #fff; }
    .ice-lt__type-label { font-size: 0.62rem; text-align: center; }
    .ice-lt__type-long { display: none; }
    .ice-lt__type-short { display: inline; }
  }

</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-ice-lt-gallery]');
  if (gallery) {
    const slides = gallery.querySelectorAll<HTMLElement>('[data-ice-lt-slide]');
    const items  = document.querySelectorAll<HTMLElement>('[data-ice-lt-target]');
    const total  = slides.length;
    let current  = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(idx: number) {
      current = idx;
      slides.forEach(s => s.classList.toggle('is-active', s.dataset.iceLtSlide === String(idx)));
      // highlight the matching thumbnail (styled on mobile only)
      items.forEach(item => item.classList.toggle('is-active', item.dataset.iceLtTarget === String(idx)));
    }

    function startAuto() {
      clearInterval(timer);
      timer = setInterval(() => show((current + 1) % total), 4000);
    }

    items.forEach(item => {
      const target = Number(item.dataset.iceLtTarget);
      item.addEventListener('mouseenter', () => { clearInterval(timer); show(target); });
      item.addEventListener('mouseleave', () => startAuto());
      // touch only (mobile): tap a thumbnail to show it, then keep cycling from there;
      // mouse keeps the hover behaviour above
      item.addEventListener('pointerup', (e) => {
        if (e.pointerType === 'mouse') return;
        show(target);
        startAuto();
      });
    });

    startAuto();
  }
</script>
