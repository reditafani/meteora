    .ice-lt__grid {
      grid-template-rows: auto auto auto;
      align-items: stretch;
      row-gap: 0;
    }
    .ice-lt__text { display: contents; }
    .ice-lt__eyebrow { grid-column: 2; grid-row: 1; }
    .ice-lt__title   { grid-column: 2; grid-row: 2; }
    /* .ice-lt__grid raises specificity over the base margin declared below */
    .ice-lt__grid .ice-lt__desc { grid-column: 2; grid-row: 3; margin-bottom: 0; }
    /* the photo columns take the text's height and never push it:
       height 0 + min-height 100% = fill the grid area without sizing it */
    .ice-lt__img-wrap,
    .ice-lt__grid .ice-lt__types {
      height: 0;
      min-height: 100%;
    }
    .ice-lt__img-wrap {
      grid-column: 1;
      grid-row: 2 / 4;
      display: flex;
    }
    .ice-lt__img-wrap .ice-lt__img { flex: 1; aspect-ratio: auto; }
    .ice-lt__grid .ice-lt__types {
      grid-column: 3;
      grid-row: 2 / 4;
      align-self: stretch;
      grid-template-rows: 1fr 1fr;
    }
    .ice-lt__type { display: flex; flex-direction: column; min-height: 0; }
    .ice-lt__types .ice-lt__type-img {
      position: relative;
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }
    .ice-lt__types .ice-lt__type-img :global(picture),
    .ice-lt__types .ice-lt__type-img :global(img) {
      position: absolute;
      inset: 0;
    }
  }

  /* Left image with frame */
  .ice-lt__img-wrap {
    position: relative;
  }
  .ice-lt__img {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(184, 158, 114, 0.5);
  }
  .ice-lt__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ice-lt__slide.is-active {
    opacity: 1;
  }
  .ice-lt__slide :global(picture),
  .ice-lt__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Centre text */
  .ice-lt__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
    margin-bottom: var(--space-s);
  }
  .ice-lt__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.5vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    color: #fff;
    margin-bottom: var(--space-m);
  }
  .ice-lt__title em {
    font-style: italic;
    color: var(--color-accent-on-dark);
  }
  .ice-lt__desc {
    font-size: var(--fs-body);
    line-height: 1.7;
    margin-bottom: var(--space-m);
  }
  .ice-lt__tagline {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.8rem + 0.5vw, 1.15rem);
    font-style: italic;
    color: var(--color-accent-on-dark);
    line-height: 1.5;
    margin-bottom: var(--space-m);
  }
  .ice-lt__cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
