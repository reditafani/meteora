---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Img from '@/components/Img.astro';
import TowerSection from '@/components/TowerSection.astro';
import CocktailSlideshow from '@/components/CocktailSlideshow.astro';
import { services } from '@/data/services';
import { serviceSchema } from '@/lib/seo';
import hero      from '@/assets/images/bars/bartender-event.jpg';
import iceHoshi  from '@/assets/images/ice/hoshizaki.jpg';
import personalizImg from '@/assets/images/cocktails/rosemary-cocktail.jpg';
import iceSphere from '@/assets/images/ice/sphere.jpg';
import iceCube   from '@/assets/images/ice/compact-cube.jpg';
import iceNugget from '@/assets/images/ice/nugget.jpg';
import iceCube5  from '@/assets/images/ice/cube-5cm.jpg';
import iceLong   from '@/assets/images/ice/long-drink.jpg';
import CarouselProgress from '@/components/CarouselProgress.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const tabLabels: Record<string, { it: string; en: string }> = {
  // "Experience" shows on the mobile cards only (svc-index__mob is hidden on desktop)
  essential: { it: 'Essential<span class="svc-index__mob"> <br class="svc-index__br" />Experience</span>', en: 'Essential<span class="svc-index__mob"> <br class="svc-index__br" />Experience</span>' },
  premium:   { it: 'Premium<span class="svc-index__mob"> <br class="svc-index__br" />Experience</span>',   en: 'Premium<span class="svc-index__mob"> <br class="svc-index__br" />Experience</span>' },
  // <br> splits the label on the mobile cards only (hidden on desktop)
  aperitivo: { it: 'Aperitivo + <br class="svc-index__br" />Open Bar', en: 'Aperitivo + <br class="svc-index__br" />Open Bar' },
  tower:     { it: 'Signature <br class="svc-index__br" />Tower', en: 'Signature <br class="svc-index__br" />Tower' },
  bartender: { it: 'Bartender <br class="svc-index__br" />service', en: 'Bartender <br class="svc-index__br" />service' },
};
const s = t(lang);
const meta = it
  ? { title: 'Formule Bar per Matrimoni ed Eventi: Open Bar, Aperitivo e Altro', description: 'Le nostre formule di servizio bar: open bar, aperitivo, champagne tower, barman professionali e allestimento scenografico per matrimoni ed eventi in Toscana.' }
  : { title: 'Wedding Bar Packages in Tuscany & Italy: Open Bar & More', description: 'Open bar, cocktail hour, champagne tower and professional bartenders with scenographic set-ups for your destination wedding in Tuscany and Italy.' };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Servizi' : 'Services', href: url('services', lang) },
];
const iceTypes = [
  // short*: labels for the single-row mobile strip
  { src: iceCube,   labelIt: 'Cubo compatto', labelEn: 'Compact cube', shortIt: 'Cubo',   shortEn: 'Cube'     },
  { src: iceNugget, labelIt: 'Nugget',        labelEn: 'Nugget',       shortIt: 'Nugget', shortEn: 'Nugget'   },
  { src: iceCube5,  labelIt: 'Cubo 5×5',     labelEn: '5×5 cube',     shortIt: '5×5',    shortEn: '5×5'      },
  { src: iceLong,   labelIt: 'Long drink',    labelEn: 'Long drink',   shortIt: 'Long',   shortEn: 'Long'     },
  { src: iceSphere, labelIt: 'Sfera',         labelEn: 'Sphere',       shortIt: 'Sfera',  shortEn: 'Sphere'   },
  { src: iceHoshi,  labelIt: 'Inciso',        labelEn: 'Engraved',     shortIt: 'Inciso', shortEn: 'Engraved' },
];

const schema = [
  ...services.map((sv) => serviceSchema({ name: sv.name[lang], serviceType: 'Bar catering', description: sv.summary[lang], url: url('services', lang, sv.id), lang })),
];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('services')} current="services" breadcrumbs={crumbs} schema={schema} headerTheme="overlay">
  <PageHero variant="fullscreen" align="left" image={hero} imageAlt={it ? 'Bartender al lavoro dietro il banco durante un evento' : 'Bartender working behind the bar at an event'} crumbs={crumbs}>
    <h1>{it ? <>Dall'aperitivo <em>all'ultimo drink.</em></> : <>From aperitivo <em>to the last drink.</em></>}</h1>
    <p slot="lead" class="lead muted">
      {it
        ? 'Un servizio bar completo: metodo nel servizio, effetto scenico nell\'allestimento. Ogni proposta è costruita su misura.'
        : 'A complete bar service: method in delivery, scenic effect in the setup. Every proposal is built to measure.'}
    </p>
    <div slot="bottombar" class="svc-index-wrap">
      <nav class="svc-index" id="svc-index" aria-label={it ? "Indice servizi" : "Services index"}>
        {[
          ...services.map((sv) => ({ href: `#${sv.id}`, label: tabLabels[sv.id][lang] })),
          { href: '#personalizzazioni', label: it ? 'Personalizzazioni' : 'Bespoke add-ons' },
        ].map((item) => (
          <a href={item.href}>
            <span class="svc-index__label" set:html={item.label}></span>
          </a>
        ))}
      </nav>
      <CarouselProgress lang={lang} for="svc-index" variant="dark" />
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container svc">
      {services.slice(0, 3).map((sv, i) => (
        <article class:list={['svc__item', i % 2 === 1 && 'svc__item--rev']} id={sv.id} aria-labelledby={`${sv.id}-t`}>
          <div class="svc__frame" data-reveal="image">
            <div class="media svc__media">
              <Img src={sv.image} alt={sv.imageAlt[lang]} sizes="(min-width: 960px) 45vw, 100vw" />
            </div>
          </div>
          <div class="svc__text">
            <p class="micro svc__kicker" data-reveal>· {sv.kicker[lang]}</p>
            <h2 id={`${sv.id}-t`} class="h3 svc__title" data-reveal>
              {sv.id === 'aperitivo'
                ? <>{it ? 'Aperitivo + ' : 'Aperitivo + '}<em>{it ? 'Open Bar' : 'Open Bar'}</em></>
                : sv.name[lang].includes(' — ')
                  ? <>{sv.name[lang].split(' — ')[0]} — <em>{sv.name[lang].split(' — ')[1]}</em></>
                  : sv.name[lang]}
            </h2>
            <p class="lead muted" data-reveal>
              {sv.id === 'essential' && it
                ? 'Arriva il momento che tutti aspettano: la festa. Le luci si abbassano, la musica sale e il bar diventa il cuore della serata. Voi pensate solo a divertirvi, al resto pensiamo noi: dall\'allestimento all\'ultimo drink.'
                : sv.id === 'premium' && it
                  ? 'Per chi vuole offrire ai propri ospiti il meglio. Le etichette più ricercate e prodotti premium: un open bar di un altro livello, drink dopo drink.'
                  : sv.id === 'aperitivo' && it
                    ? 'Una formula completa, pensata per accompagnare ogni momento. Un aperitivo con la sua drink list e il suo allestimento, poi l\'open bar per la festa. Due momenti diversi, la stessa attenzione ai dettagli.'
                    : sv.summary[lang]}
            </p>
            {(sv.id === 'essential' || sv.id === 'premium' || sv.id === 'aperitivo') && (
              <p class="svc__inc-label" data-reveal>{it ? 'Il servizio include:' : 'The service includes:'}</p>
            )}
            <ul class="svc__inc" role="list" data-reveal>
              {sv.includes[lang].map((x, idx) => (
                <li class:list={[sv.id === 'premium' && idx === 4 && 'svc__inc--highlight']}>{x}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CocktailSlideshow lang={lang} />

  <!-- ── Ice section (dark) ── -->
  <section class="section section--dark ice-lt" aria-labelledby="ice-lt-title">
    <div class="container ice-lt__grid">

      <!-- Left: framed image gallery -->
      <div class="ice-lt__img-wrap" data-reveal>
        <div class="ice-lt__img" data-ice-lt-gallery>
          <div class="ice-lt__slide is-active" data-ice-lt-slide="0">
            <Img src={iceSphere} alt={it ? 'Sfera di ghiaccio premium' : 'Premium ice sphere'} sizes="(min-width: 900px) 18vw, 80vw" widths={[300, 500, 700]} />
          </div>
          {iceTypes.map((tp, i) => (
            <div class="ice-lt__slide" data-ice-lt-slide={i + 1}>
              <Img src={tp.src} alt={it ? tp.labelIt : tp.labelEn} sizes="(min-width: 900px) 18vw, 80vw" widths={[300, 500, 700]} />
            </div>
          ))}
        </div>
      </div>

      <!-- Centre: text -->
      <div class="ice-lt__text">
        <p class="ice-lt__eyebrow" data-reveal>{it ? 'Il dettaglio invisibile' : 'The invisible detail'}</p>
        <h2 id="ice-lt-title" class="ice-lt__title" data-reveal>
          {it ? <>Tutto inizia <em>dal ghiaccio.</em></> : <>Everything begins <em>with ice.</em></>}
        </h2>
        <p class="ice-lt__desc muted" data-reveal>
          {it
            ? "Il ghiaccio non serve solo a raffreddare: controlla la diluizione e definisce l'equilibrio di ogni drink. Per noi è un ingrediente."
            : "Ice doesn't just chill — it controls dilution and defines the balance of every drink. For us it's an ingredient."}
        </p>
      </div>

      <!-- Right: 3×2 ice grid -->
      <div class="ice-lt__types" data-reveal>
        {iceTypes.map((tp, i) => (
          <div class="ice-lt__type" data-ice-lt-target={i + 1}>
            <div class="ice-lt__type-img">
              <Img src={tp.src} alt={it ? tp.labelIt : tp.labelEn} sizes="(min-width: 900px) 10vw, 30vw" widths={[180, 320]} />
            </div>
            <p class="ice-lt__type-label">
              <span class="ice-lt__type-long">{it ? tp.labelIt : tp.labelEn}</span>
              <span class="ice-lt__type-short">{it ? tp.shortIt : tp.shortEn}</span>
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="section section--tight">
    <div class="container svc">
      <TowerSection lang={lang} />
      {services.slice(4).map((sv, i) => (
        <article class:list={['svc__item', 'svc__item--rev']} id={sv.id} aria-labelledby={`${sv.id}-t`}>
          <div class="svc__frame" data-reveal="image">
            <div class="media svc__media">
              <Img src={sv.image} alt={sv.imageAlt[lang]} sizes="(min-width: 960px) 45vw, 100vw" />
            </div>
          </div>
          <div class="svc__text">
            <p class="micro svc__kicker" data-reveal>· {sv.kicker[lang]}</p>
            <h2 id={`${sv.id}-t`} class="h3 svc__title" data-reveal>
              {sv.id === 'bartender'
                ? <>Bartender <em>Service</em></>
                : sv.name[lang].includes(' — ')
                  ? <>{sv.name[lang].split(' — ')[0]} — <em>{sv.name[lang].split(' — ')[1]}</em></>
                  : sv.name[lang]}
            </h2>
            <p class="lead muted" data-reveal>
              {sv.id === 'bartender' && it
                ? 'Il nostro metodo, anche senza il nostro bar. Una soluzione per chi cerca bartender qualificati, con i nostri standard di servizio e la nostra consulenza.'
                : sv.summary[lang]}
            </p>
            <p class="svc__inc-label" data-reveal>{it ? 'Il servizio include:' : 'The service includes:'}</p>
            <ul class="svc__inc" role="list" data-reveal>
              {sv.includes[lang].map((x) => <li>{x}</li>)}
            </ul>
          </div>
        </article>
      ))}

      <!-- Personalizzazioni su richiesta -->
      <article class="svc__item" id="personalizzazioni" aria-labelledby="personalizzazioni-t">
        <div class="svc__frame" data-reveal="image">
          <div class="media svc__media">
            <Img src={personalizImg} alt={it ? 'Cocktail con rosmarino e lime su marmo chiaro' : 'Cocktail with rosemary and lime on light marble'} sizes="(min-width: 960px) 34vw, 100vw" />
          </div>
        </div>
        <div class="svc__text">
          <p class="micro svc__kicker" data-reveal>· {it ? 'Personalizzazioni su richiesta' : 'Bespoke add-ons'}</p>
          <h2 id="personalizzazioni-t" class="h3 svc__title" data-reveal>
            {it ? <>Un bar <em>che parla di voi</em></> : <>A bar <em>that speaks of you</em></>}
          </h2>
          <p class="lead muted" data-reveal>
            {it
              ? "Dettagli su misura che raccontano la vostra storia o l'identità del vostro brand, e rendono il bar inconfondibilmente vostro."
              : 'Bespoke details that tell your story or your brand identity, making the bar unmistakably yours.'}
          </p>
          <ul class="svc__inc" role="list" data-reveal>
            {(it ? [
              'Cocktail creati e nominati per voi',
              'Le vostre iniziali incise nel ghiaccio',
              'Frontale del banco bar con i vostri nomi o il logo',
              'Tovaglioli personalizzati',
              'Frutta decorativa incisa',
              'Divise brandizzate per gli eventi aziendali',
            ] : [
              'Cocktails created and named for you',
              'Your initials engraved in the ice',
              'Bar front with your names or logo',
              'Personalised napkins',
              'Decorative engraved fruit',
              'Branded uniforms for corporate events',
            ]).map(item => <li>{item}</li>)}
          </ul>
        </div>
      </article>

    </div>
  </section>

  <section class="svc-outro on-dark">
    <div class="container svc-outro__inner">
      <p class="svc-outro__text" data-reveal>
        {it ? 'Avete in mente qualcosa di diverso?' : 'Have something different in mind?'}
        <br class="svc-outro__br" />
        {it ? 'Raccontatecelo, lo realizziamo per voi.' : 'Tell us about it — we will make it happen.'}
      </p>
      <a class="btn btn--ghost-light cta-pill cta-pill--block svc-outro__btn" href={url('contact', lang)} data-reveal style="--delay:.08s">
        {it ? 'Contattaci →' : 'Contact us →'}
      </a>
    </div>
  </section>


</BaseLayout>

<style>
  .svc-index-wrap { position: relative; }
  .svc-index {
    display: flex;
    width: 100%;
    background: rgba(6, 4, 3, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .svc-index::-webkit-scrollbar {
    display: none;
  }
  .svc-index a {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 1rem;
    text-decoration: none;
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .svc-index a::after {
    content: '';
    display: block;
    width: 5px;
    height: 5px;
    border-right: 1px solid var(--color-accent-on-dark);
    border-bottom: 1px solid var(--color-accent-on-dark);
    transform: rotate(45deg);
    opacity: 1;
    flex-shrink: 0;
  }
  .svc-index a:last-child {
    border-right: none;
  }
  .svc-index a:hover {
    color: var(--color-accent-on-dark);
    background: rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 900px) {
    .svc-index a {
      flex: 1;
    }
  }
  @media (min-width: 700px) {
    .svc-index :global(.svc-index__br),
    .svc-index :global(.svc-index__mob) { display: none; }
  }
  /* Mobile: square cards in a solid black band below the hero image,
     same as the home perks strip and the bars page */
  @media (max-width: 699px) {
    :global(.fhero.fhero--left .fhero__bottombar:has(.svc-index-wrap)) {
      position: relative;
      align-self: stretch;
    }
    /* hero text area sized like the bars page hero (the band now sits below it) */
    :global(.fhero.fhero--left:has(.svc-index-wrap)) {
      min-height: 0;
    }
    :global(.fhero.fhero--left:has(.fhero__bottombar .svc-index-wrap) .fhero__content) {
      min-height: 80svh;
      justify-content: flex-end;
      padding: calc(var(--header-h, 4rem) + 1rem) var(--gutter) var(--space-l);
    }
    .svc-index-wrap {
      background: rgb(8 5 3);
      padding-top: var(--space-m);
    }
    .svc-index {
      gap: 0.75rem;
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scroll-snap-type: x mandatory;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .svc-index a,
    .svc-index a:last-child {
      flex: 0 0 32%;
      min-width: 0;
      /* lower than square: 68% of the card width (32% of the track's inner width) */
      height: calc((100vw - 2 * var(--gutter)) * 0.32 * 0.68);
      scroll-snap-align: start;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.3rem 0.45rem 0.35rem;
      border: 1px solid rgba(201, 183, 143, 0.4);
      text-transform: none;
      letter-spacing: 0;
      white-space: normal;
      color: var(--color-on-dark);
    }
    /* "Personalizzazioni": wider card so the label stays on one line */
    .svc-index a:last-child {
      flex: 0 0 auto;
      padding-inline: 1rem;
      white-space: nowrap;
    }
    .svc-index__label {
      font-family: var(--font-display);
      font-size: clamp(1.1rem, 4.8vw, 1.4rem);
      font-weight: 300;
      line-height: 1.1;
      text-align: center;
      hyphens: manual;
    }
    .svc-index-wrap :global(.cprog) {
      margin-top: 0;
      padding-block: 16px; /* 16px from the cards, 16px to the band's end */
    }
  }
  .svc {
    display: grid;
    gap: var(--space-xl);
  }
  .svc__item {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    scroll-margin-top: calc(var(--header-h-compact) + 1rem);
  }
  .svc__frame {
    padding: 6px;
    background: #fff;
    border: 1px solid rgba(184, 158, 114, 0.45);
  }
  .svc__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .svc__text > * + * {
    margin-top: var(--space-m);
  }
  .svc__kicker {
    color: var(--color-accent-ink);
  }
  .svc__title {
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 3rem);
  }
  .svc__title em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .svc__inc-label {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: var(--space-m);
    margin-bottom: 0.25rem;
  }
  .svc__inc {
    border-top: 1px solid var(--color-border);
  }
  .svc__inc--highlight {
    font-weight: 600;
    color: var(--color-accent-ink);
  }
  .svc__inc li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.96rem;
  }
  .svc__inc li::before {
    content: '·';
    color: var(--color-accent-ink);
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1;
  }
  .svc__tagline {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.2rem);
    font-style: italic;
    color: var(--color-accent-ink);
    line-height: 1.5;
  }
  .svc__textcta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3px;
    transition: color 0.2s, border-color 0.2s;
  }
  .svc__textcta:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }
  /* Mobile: kicker, title and description come before the photo, then the
     rest of the text (the text box is flattened into the item's grid) */
  @media (max-width: 699px) {
    .svc__item { gap: 0; }
    .svc__text { display: contents; }
    .svc__text > * { order: 2; }
    .svc__text > .svc__kicker, .svc__text > .svc__title, .svc__text > .lead { order: 0; }
    .svc__frame { order: 1; margin-top: var(--space-m); }
  }
  .svc__note {
    max-width: 44rem;
    font-size: var(--fs-small);
    margin-top: calc(var(--space-xl) * -0.4);
  }
  .section--tight :global(.sh) {
    margin-bottom: var(--space-m);
  }
  @media (min-width: 960px) {
    .svc__item {
      display: block;
      position: relative;
      padding-left: 30%;
    }
    .svc__frame {
      position: absolute;
      left: 0;
      top: 20px;
      bottom: 20px;
      width: 34%;
      z-index: 2;
      padding: 6px;
      background: #fff;
      border: 1px solid rgba(184, 158, 114, 0.45);
    }
    .svc__media {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      overflow: hidden;
    }
    .svc__media :global(picture),
    .svc__media :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .svc__text {
      background: #fff;
      border: 1px solid rgba(184, 158, 114, 0.4);
      padding: 2.5rem 2.5rem 3rem 6rem;
      position: relative;
      z-index: 1;
    }
    .svc__text::before {
      content: '';
      position: absolute;
      inset: -7px;
      border: 1px solid rgba(184, 158, 114, 0.55);
      pointer-events: none;
      z-index: -1;
    }
    .svc__item--rev {
      padding-left: 0;
      padding-right: 30%;
    }
    .svc__item--rev .svc__frame {
      left: auto;
      right: 0;
    }
    .svc__item--rev .svc__text {
      padding-left: 2.5rem;
      padding-right: 6rem;
    }
  }

  /* ── Ice light section ── */
  .ice-lt {
    padding-top: clamp(1.6rem, 3vw, 2.5rem);
    padding-bottom: clamp(2.55rem, 5.1vw, 4.25rem);
    border-top: 1px solid rgba(207, 182, 138, 0.4);
  }
  .ice-lt__grid {
    display: grid;
    gap: var(--space-l);
