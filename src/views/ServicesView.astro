    /* Ice section: landscape ratio on mobile (prevents very tall portrait image) */
    .ice-lt__img { aspect-ratio: 16/9; }
  }

  /* Right: 3×2 ice grid */
  .ice-lt__types {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem 0.75rem;
