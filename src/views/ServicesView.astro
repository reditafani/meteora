---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Img from '@/components/Img.astro';
import TowerSection from '@/components/TowerSection.astro';
import CocktailSlideshow from '@/components/CocktailSlideshow.astro';
import { services } from '@/data/services';
import { serviceSchema } from '@/lib/seo';
import hero      from '@/assets/images/bars/bartender-event.jpg';
import iceHoshi  from '@/assets/images/ice/hoshizaki.jpg';
import iceSphere from '@/assets/images/ice/sphere.jpg';
import iceCube   from '@/assets/images/ice/compact-cube.jpg';
import iceNugget from '@/assets/images/ice/nugget.jpg';
import iceCube5  from '@/assets/images/ice/cube-5cm.jpg';
import iceLong   from '@/assets/images/ice/long-drink.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const tabLabels: Record<string, { it: string; en: string }> = {
  essential: { it: 'Essential', en: 'Essential' },
  premium:   { it: 'Premium',   en: 'Premium' },
  aperitivo: { it: 'Aperitivo + Open Bar', en: 'Aperitivo + Open Bar' },
  tower:     { it: 'Signature Tower', en: 'Signature Tower' },
  bartender: { it: 'Solo barman', en: 'Bartender only' },
};
const s = t(lang);
const meta = it
  ? { title: 'Servizi di Open Bar e Bar Catering | Meteora Events', description: 'Open Bar Essential e Premium, Aperitivo + Open Bar, Signature Tower Experience e servizio solo barman. Preventivi su misura per matrimoni ed eventi in tutta Italia.' }
  : { title: 'Open Bar & Bar Catering Services | Meteora Events', description: 'Essential and Premium Open Bar, Aperitivo + Open Bar, Signature Tower Experience and bartender-only service. Tailored quotes for weddings and events across Italy.' };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Servizi' : 'Services', href: url('services', lang) },
];
const iceTypes = [
  { src: iceCube,   labelIt: 'Cubo compatto', labelEn: 'Compact cube' },
  { src: iceNugget, labelIt: 'Nugget',        labelEn: 'Nugget'       },
  { src: iceCube5,  labelIt: 'Cubo 5×5',     labelEn: '5×5 cube'     },
  { src: iceLong,   labelIt: 'Long drink',    labelEn: 'Long drink'   },
  { src: iceSphere, labelIt: 'Sfera',         labelEn: 'Sphere'       },
  { src: iceHoshi,  labelIt: 'Inciso',        labelEn: 'Engraved'     },
];

const schema = [
  ...services.map((sv) => serviceSchema({ name: sv.name[lang], serviceType: 'Bar catering', description: sv.summary[lang], url: url('services', lang, sv.id), lang })),
];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('services')} current="services" breadcrumbs={crumbs} schema={schema} headerTheme="overlay">
  <PageHero variant="fullscreen" align="left" image={hero} imageAlt={it ? 'Bartender al lavoro dietro il banco durante un evento' : 'Bartender working behind the bar at an event'} crumbs={crumbs}>
    <h1>{it ? <>Dall'aperitivo <em>all'ultimo drink.</em></> : <>From aperitivo <em>to the last drink.</em></>}</h1>
    <p slot="lead" class="lead muted">
      {it
        ? 'Un servizio bar completo: metodo nel servizio, effetto scenico nell\'allestimento. Ogni proposta è costruita su misura.'
        : 'Complete, independent formulas coordinated with your caterer — or simply our staff and our method. Every proposal is built to measure.'}
    </p>
    <nav slot="bottombar" class="svc-index" aria-label={it ? "Indice servizi" : "Services index"}>
      {services.map((sv) => <a href={`#${sv.id}`}>{tabLabels[sv.id][lang]}</a>)}
      <a href="#personalizzazioni">{it ? 'Personalizzazioni' : 'Bespoke add-ons'}</a>
    </nav>
  </PageHero>

  <section class="section section--tight">
    <div class="container svc">
      {services.slice(0, 3).map((sv, i) => (
        <article class:list={['svc__item', i % 2 === 1 && 'svc__item--rev']} id={sv.id} aria-labelledby={`${sv.id}-t`}>
          <div class="media svc__media" data-reveal="image">
            <Img src={sv.image} alt={sv.imageAlt[lang]} sizes="(min-width: 960px) 45vw, 100vw" />
          </div>
          <div class="svc__text">
            <p class="micro svc__kicker" data-reveal>{String(i + 1).padStart(2, '0')} · {sv.kicker[lang]}</p>
            <h2 id={`${sv.id}-t`} class="h3 svc__title" data-reveal>
              {sv.id === 'aperitivo'
                ? <>{it ? 'Aperitivo + ' : 'Aperitivo + '}<em>{it ? 'Open Bar' : 'Open Bar'}</em></>
                : sv.name[lang].includes(' — ')
                  ? <>{sv.name[lang].split(' — ')[0]} — <em>{sv.name[lang].split(' — ')[1]}</em></>
                  : sv.name[lang]}
            </h2>
            <p class="lead muted" data-reveal>
              {sv.id === 'essential' && it
                ? 'Arriva il momento che tutti aspettano: la festa. Le luci si abbassano, la musica sale e il bar diventa il cuore della serata. Voi pensate solo a divertirvi, al resto pensiamo noi: dall\'allestimento all\'ultimo drink.'
                : sv.id === 'premium' && it
                  ? 'Per chi vuole offrire ai propri ospiti il meglio. Le etichette più ricercate e prodotti premium: un open bar di un altro livello, drink dopo drink.'
                  : sv.id === 'aperitivo' && it
                    ? 'Una formula completa, pensata per accompagnare ogni momento. Un aperitivo con la sua drink list e il suo allestimento, poi l\'open bar per la festa. Due momenti diversi, la stessa attenzione ai dettagli.'
                    : sv.summary[lang]}
            </p>
            {(sv.id === 'essential' || sv.id === 'premium' || sv.id === 'aperitivo') && (
              <p class="svc__inc-label" data-reveal>{it ? 'Il servizio include:' : 'The service includes:'}</p>
            )}
            <ul class="svc__inc" role="list" data-reveal>
              {sv.includes[lang].map((x, idx) => (
                <li class:list={[sv.id === 'premium' && idx === 4 && 'svc__inc--highlight']}>{x}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CocktailSlideshow lang={lang} />

  <!-- ── Ice light section ── -->
  <section class="section section--alt ice-lt" aria-labelledby="ice-lt-title">
    <div class="container ice-lt__grid">

      <!-- Left: framed image gallery -->
      <div class="ice-lt__img-wrap" data-reveal>
        <div class="ice-lt__img" data-ice-lt-gallery>
          <div class="ice-lt__slide is-active" data-ice-lt-slide="0">
            <Img src={iceSphere} alt={it ? 'Sfera di ghiaccio premium' : 'Premium ice sphere'} sizes="(min-width: 900px) 18vw, 80vw" widths={[300, 500, 700]} />
          </div>
          {iceTypes.map((tp, i) => (
            <div class="ice-lt__slide" data-ice-lt-slide={i + 1}>
              <Img src={tp.src} alt={it ? tp.labelIt : tp.labelEn} sizes="(min-width: 900px) 18vw, 80vw" widths={[300, 500, 700]} />
            </div>
          ))}
        </div>
      </div>

      <!-- Centre: text -->
      <div class="ice-lt__text">
        <p class="ice-lt__eyebrow" data-reveal>{it ? 'Il dettaglio invisibile' : 'The invisible detail'}</p>
        <h2 id="ice-lt-title" class="ice-lt__title" data-reveal>
          {it ? <>Tutto inizia <em>dal ghiaccio.</em></> : <>Everything begins <em>with ice.</em></>}
        </h2>
        <p class="ice-lt__desc muted" data-reveal>
          {it
            ? "Il ghiaccio non serve solo a raffreddare: controlla la diluizione e definisce l'equilibrio di ogni drink. Per noi è un ingrediente."
            : "Ice doesn't just chill — it controls dilution and defines the balance of every drink. For us it's an ingredient."}
        </p>
        <p class="ice-lt__tagline" data-reveal>
          <em>{it ? 'Formati da mixology e persino il vostro nome, inciso nel ghiaccio.' : 'Crafted by mixology — and even your name engraved in the ice.'}</em>
        </p>
        <a class="ice-lt__cta" href={url('ice', lang)} data-reveal>
          {it ? 'CHIEDETECI DI PIÙ →' : 'ASK US MORE →'}
        </a>
      </div>

      <!-- Right: 3×2 ice grid -->
      <div class="ice-lt__types" data-reveal>
        {iceTypes.map((tp, i) => (
          <div class="ice-lt__type" data-ice-lt-target={i + 1}>
            <div class="ice-lt__type-img">
              <Img src={tp.src} alt={it ? tp.labelIt : tp.labelEn} sizes="(min-width: 900px) 10vw, 30vw" widths={[180, 320]} />
            </div>
            <p class="ice-lt__type-label">{it ? tp.labelIt : tp.labelEn}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="section section--tight">
    <div class="container svc">
      <TowerSection lang={lang} />
      {services.slice(4).map((sv, i) => (
        <article class:list={['svc__item', 'svc__item--rev']} id={sv.id} aria-labelledby={`${sv.id}-t`}>
          <div class="media svc__media" data-reveal="image">
            <Img src={sv.image} alt={sv.imageAlt[lang]} sizes="(min-width: 960px) 45vw, 100vw" />
          </div>
          <div class="svc__text">
            <p class="micro svc__kicker" data-reveal>{String(i + 5).padStart(2, '0')} · {sv.kicker[lang]}</p>
            <h2 id={`${sv.id}-t`} class="h3 svc__title" data-reveal>
              {sv.id === 'bartender'
                ? <>Bartender <em>Service</em></>
                : sv.name[lang].includes(' — ')
                  ? <>{sv.name[lang].split(' — ')[0]} — <em>{sv.name[lang].split(' — ')[1]}</em></>
                  : sv.name[lang]}
            </h2>
            <p class="lead muted" data-reveal>
              {sv.id === 'bartender' && it
                ? 'Il nostro metodo, anche senza il nostro bar. Una soluzione per chi cerca bartender qualificati, con i nostri standard di servizio e la nostra consulenza.'
                : sv.summary[lang]}
            </p>
            <p class="svc__inc-label" data-reveal>{it ? 'Il servizio include:' : 'The service includes:'}</p>
            <ul class="svc__inc" role="list" data-reveal>
              {sv.includes[lang].map((x) => <li>{x}</li>)}
            </ul>
          </div>
        </article>
      ))}

      <!-- 06 · Personalizzazioni su richiesta -->
      <article class="svc__item" id="personalizzazioni" aria-labelledby="personalizzazioni-t">
        <div class="media svc__media" data-reveal="image">
          <Img src={iceHoshi} alt={it ? 'Cubo di ghiaccio con iniziali incise' : 'Ice cube with engraved initials'} sizes="(min-width: 960px) 34vw, 100vw" />
        </div>
        <div class="svc__text">
          <p class="micro svc__kicker" data-reveal>06 · {it ? 'Personalizzazioni su richiesta' : 'Bespoke add-ons'}</p>
          <h2 id="personalizzazioni-t" class="h3 svc__title" data-reveal>
            {it ? <>Un bar <em>che parla di voi</em></> : <>A bar <em>that speaks of you</em></>}
          </h2>
          <p class="lead muted" data-reveal>
            {it
              ? "Dettagli su misura che raccontano la vostra storia o l'identità del vostro brand, e rendono il bar inconfondibilmente vostro."
              : 'Bespoke details that tell your story or your brand identity, making the bar unmistakably yours.'}
          </p>
          <ul class="svc__inc" role="list" data-reveal>
            {(it ? [
              'Cocktail creati e nominati per voi',
              'Le vostre iniziali incise nel ghiaccio',
              'Frontale del banco bar con i vostri nomi o il logo',
              'Tovaglioli personalizzati',
              'Frutta decorativa incisa',
              'Divise brandizzate per gli eventi aziendali',
            ] : [
              'Cocktails created and named for you',
              'Your initials engraved in the ice',
              'Bar front with your names or logo',
              'Personalised napkins',
              'Decorative engraved fruit',
              'Branded uniforms for corporate events',
            ]).map(item => <li>{item}</li>)}
          </ul>
        </div>
      </article>

    </div>
  </section>

  <section class="svc-outro on-dark">
    <div class="container svc-outro__inner">
      <p class="svc-outro__text" data-reveal>
        {it ? 'Avete in mente qualcosa di diverso? Raccontatecelo, lo realizziamo per voi.' : 'Have something different in mind? Tell us about it — we will make it happen.'}
      </p>
      <a class="btn btn--ghost-light svc-outro__btn" href={url('contact', lang)} data-reveal style="--delay:.08s">
        {it ? 'Contattaci' : 'Contact us'}
      </a>
    </div>
  </section>


</BaseLayout>

<style>
  .svc-index {
    display: flex;
    width: 100%;
    background: rgba(6, 4, 3, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .svc-index::-webkit-scrollbar {
    display: none;
  }
  .svc-index a {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.95rem 1rem;
    text-decoration: none;
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .svc-index a::after {
    content: '';
    display: block;
    width: 5px;
    height: 5px;
    border-right: 1px solid var(--color-accent-on-dark);
    border-bottom: 1px solid var(--color-accent-on-dark);
    transform: rotate(45deg);
    opacity: 1;
    flex-shrink: 0;
  }
  .svc-index a:last-child {
    border-right: none;
  }
  .svc-index a:hover {
    color: var(--color-accent-on-dark);
    background: rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 900px) {
    .svc-index a {
      flex: 1;
    }
  }
  .svc {
    display: grid;
    gap: var(--space-xl);
  }
  .svc__item {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    scroll-margin-top: calc(var(--header-h-compact) + 1rem);
  }
  .svc__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .svc__text > * + * {
    margin-top: var(--space-m);
  }
  .svc__kicker {
    color: var(--color-accent-ink);
  }
  .svc__title {
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 3rem);
  }
  .svc__title em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .svc__inc-label {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: var(--space-m);
    margin-bottom: 0.25rem;
  }
  .svc__inc {
    border-top: 1px solid var(--color-border);
  }
  .svc__inc--highlight {
    font-weight: 600;
    color: var(--color-accent-ink);
  }
  .svc__inc li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--fs-small);
  }
  .svc__inc li::before {
    content: '·';
    color: var(--color-accent-ink);
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1;
  }
  .svc__tagline {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.2rem);
    font-style: italic;
    color: var(--color-accent-ink);
    line-height: 1.5;
  }
  .svc__textcta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3px;
    transition: color 0.2s, border-color 0.2s;
  }
  .svc__textcta:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }
  .svc__note {
    max-width: 44rem;
    font-size: var(--fs-small);
    margin-top: calc(var(--space-xl) * -0.4);
  }
  .section--tight :global(.sh) {
    margin-bottom: var(--space-m);
  }
  @media (min-width: 960px) {
    .svc__item {
      display: block;
      position: relative;
      padding-left: 30%;
    }
    .svc__media {
      position: absolute;
      left: 0;
      top: 20px;
      bottom: 20px;
      width: 34%;
      aspect-ratio: auto;
      z-index: 2;
    }
    .svc__media :global(picture),
    .svc__media :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .svc__text {
      background: #fff;
      border: 1px solid rgba(184, 158, 114, 0.4);
      padding: 2.5rem 2.5rem 3rem 6rem;
      position: relative;
      z-index: 1;
    }
    .svc__text::before {
      content: '';
      position: absolute;
      inset: -7px;
      border: 1px solid rgba(184, 158, 114, 0.55);
      pointer-events: none;
      z-index: -1;
    }
    .svc__item--rev {
      padding-left: 0;
      padding-right: 30%;
    }
    .svc__item--rev .svc__media {
      left: auto;
      right: 0;
    }
    .svc__item--rev .svc__text {
      padding-left: 2.5rem;
      padding-right: 6rem;
    }
  }

  /* ── Ice light section ── */
  .ice-lt {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .ice-lt__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 900px) {
    .ice-lt__grid {
      grid-template-columns: 1.4fr 2.6fr 2.6fr;
      gap: clamp(2rem, 4vw, 5rem);
    }
  }

  /* Left image with frame */
  .ice-lt__img-wrap {
    position: relative;
    padding-right: 1rem;
    padding-bottom: 1rem;
  }
  .ice-lt__img-wrap::after {
    content: '';
    position: absolute;
    inset: 1rem 0 0 1rem;
    border: 1px solid rgba(184, 158, 114, 0.5);
    pointer-events: none;
  }
  .ice-lt__img {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
  }
  .ice-lt__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .ice-lt__slide.is-active {
    opacity: 1;
  }
  .ice-lt__slide :global(picture),
  .ice-lt__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Centre text */
  .ice-lt__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    margin-bottom: var(--space-s);
  }
  .ice-lt__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.5vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: var(--space-m);
  }
  .ice-lt__title em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .ice-lt__desc {
    font-size: var(--fs-body);
    line-height: 1.7;
    margin-bottom: var(--space-m);
  }
  .ice-lt__tagline {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.8rem + 0.5vw, 1.15rem);
    font-style: italic;
    color: var(--color-accent-ink);
    line-height: 1.5;
    margin-bottom: var(--space-m);
  }
  .ice-lt__cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3px;
    transition: color 0.2s, border-color 0.2s;
  }
  .ice-lt__cta:hover {
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  /* ── svc-outro dark closer ── */
  .svc-outro {
    background: var(--color-bg-dark, #0d0d0d);
    padding-block: var(--space-xl);
    text-align: center;
  }
  .svc-outro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
    max-width: 42rem;
    margin-inline: auto;
  }
  .svc-outro__text {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.5rem);
    font-style: italic;
    color: #fff;
    line-height: 1.5;
    margin: 0;
  }

  /* Right: 3×2 ice grid */
  .ice-lt__types {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem 0.75rem;
    align-self: center;
  }
  .ice-lt__type-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border);
    margin-bottom: 0.35rem;
  }
  .ice-lt__type-img :global(picture),
  .ice-lt__type-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .ice-lt__type:hover .ice-lt__type-img :global(img) { transform: scale(1.04); }
  .ice-lt__type-label {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-ice-lt-gallery]');
  if (gallery) {
    const slides = gallery.querySelectorAll<HTMLElement>('[data-ice-lt-slide]');
    const items  = document.querySelectorAll<HTMLElement>('[data-ice-lt-target]');

    function show(idx: number) {
      slides.forEach(s => s.classList.toggle('is-active', s.dataset.iceLtSlide === String(idx)));
    }

    items.forEach(item => {
      const target = Number(item.dataset.iceLtTarget);
      item.addEventListener('mouseenter', () => show(target));
      item.addEventListener('mouseleave', () => show(0));
    });
  }
</script>
