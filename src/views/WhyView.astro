---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import EditorialSection from '@/components/EditorialSection.astro';
import WhyGrid from '@/components/WhyGrid.astro';
import hero from '@/assets/images/bars/golden-marble-night.jpg';
import villa from '@/assets/images/bars/pure-white-villa.jpg';
import strain from '@/assets/images/team/bartender-strain.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? {
      title: 'Perché Meteora Events | Il Partner Affidabile per il Tuo Evento',
      description: `Bartender qualificati, pulizia visiva impeccabile, rispetto per le location e massima discrezione. Scopri perché oltre ${site.yearsExperience} anni di eventi ci distinguono.`,
    }
  : {
      title: 'Why Meteora Events | Your Reliable Bar Catering Partner',
      description: `Qualified bartenders, impeccable visual cleanliness, respect for venues and complete discretion. Discover why ${site.yearsExperience}+ years of events set us apart.`,
    };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Perché Meteora' : 'Why Meteora', href: url('why', lang) },
];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('why')} current="why" breadcrumbs={crumbs} headerTheme="overlay">

  <!-- HERO -->
  <PageHero
    variant="fullscreen"
    eyebrow={it ? 'Perché Meteora' : 'Why Meteora'}
    image={hero}
    imageAlt={it ? 'Banco dorato su pavimento chevron in una sala elegante' : 'Golden bar on a chevron floor in an elegant room'}
    crumbs={crumbs}
  >
    <h1>
      {it
        ? <>Il tuo partner affidabile. <em>Prima, durante e dopo l'evento.</em></>
        : <>Your reliable partner. <em>Before, during and after the event.</em></>}
    </h1>
    <p slot="lead" class="lead muted">
      {it
        ? "Non vi affidate a noi solo per servire drink. Vi affidate a noi perché il bar diventi parte dell'evento: impeccabile nel servizio, preciso nella scenografia, discreto con ogni ospite."
        : "You don't hire us just to serve drinks. You hire us because the bar becomes part of the event — impeccable in service, precise in scenography, discreet with every guest."}
    </p>
  </PageHero>

  <!-- I 9 MOTIVI: WhyGrid -->
  <section class="section" aria-labelledby="why-reasons">
    <div class="container">
      <SectionHeading eyebrow={it ? 'I nostri impegni' : 'Our commitments'} align="split" id="why-reasons">
        {it
          ? <>Nove motivi <em>per sceglierci.</em></>
          : <>Nine reasons <em>to choose us.</em></>}
        <Fragment slot="lead">
          {it
            ? "Ogni punto nasce da un'esperienza reale sul campo, affinata in oltre 14 anni di eventi."
            : 'Each point comes from real experience in the field, refined over 14+ years of events.'}
        </Fragment>
      </SectionHeading>
      <WhyGrid lang={lang} />
    </div>
  </section>

  <!-- PULIZIA DI SERVIZIO -->
  <section class="section section--alt" aria-labelledby="why-clean">
    <div class="container">
      <EditorialSection
        image={villa}
        imageAlt={it ? 'Banco Pure White in giardino, senza nulla a vista' : 'Pure White bar in a garden, nothing out of place'}
        secondImage={strain}
        secondAlt={it ? 'Bartender al lavoro con bicchieri impeccabili' : 'Bartender at work with impeccable glassware'}
        ratio="landscape"
      >
        <p class="eyebrow" data-reveal>{it ? 'Pulizia di servizio' : 'A clean service'}</p>
        <h2 id="why-clean" data-reveal>
          {it
            ? <>Igienicamente impeccabile. <em>Visivamente raffinato.</em></>
            : <>Hygienically impeccable. <em>Visually refined.</em></>}
        </h2>
        <p class="muted" data-reveal>
          {it
            ? 'Chi si avvicina al banco durante il servizio non vedrà mai contenitori termici, casse o ceste di bicchieri. Ogni rifornimento di scorte, ghiaccio e bicchieri avviene a vassoio, con discrezione, lontano dagli occhi degli ospiti.'
            : "Guests who approach the bar will never see cool boxes, storage crates or glass racks. Every restock of supplies, ice and glassware is carried discreetly by tray, well away from guests' eyes."}
        </p>
        <p class="muted" data-reveal>
          {it
            ? 'Massimo rispetto per ville e location: massima cura di mura, pavimenti, arredi e verde sia in allestimento che a fine servizio. Lasciamo tutto come lo abbiamo trovato — o meglio.'
            : 'The utmost respect for villas and venues: care for walls, floors, furniture and gardens both during setup and at the end of service. We leave everything as we found it — or better.'}
        </p>
      </EditorialSection>
    </div>
  </section>

  <!-- PER IL CATERING -->
  <section class="section" aria-labelledby="why-catering">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Per il catering' : 'For the catering team'} align="split" id="why-catering">
        {it
          ? <>Un pensiero <em>in meno.</em></>
          : <>One less thing <em>to manage.</em></>}
        <Fragment slot="lead">
          {it
            ? 'Operiamo in completa autonomia: non usiamo cucina, staff o attrezzature del catering. Il catering può chiudere la cena con serenità, caricare il materiale e liberare lo staff senza aspettare la fine del dopocena — decisivo in alta stagione, quando gli eventi si concentrano nel weekend e le ore di riposo sono poche.'
            : 'We operate completely independently: we don\'t use the caterer\'s kitchen, staff or equipment. The catering team can close dinner service calmly, load out and release their staff without waiting for the after-party to end — decisive in high season, when events concentrate at weekends and rest hours are scarce.'}
        </Fragment>
      </SectionHeading>
      <div class="catering-facts">
        {(it
          ? ['Servizio completamente indipendente', 'Staff e attrezzatura propria', 'Coordinamento con gli altri fornitori', 'Pulizia a fine servizio inclusa']
          : ['Fully independent service', 'Own staff and equipment', 'Coordination with other suppliers', 'End-of-service clean-up included']
        ).map((f) => <p class="catering-fact" data-reveal>{f}</p>)}
      </div>
    </div>
  </section>



</BaseLayout>

<style>
  .catering-facts {
    margin-top: var(--space-xl);
    display: grid;
    gap: 1px;
    background: var(--color-border);
  }
  .catering-fact {
    background: var(--color-background);
    padding: var(--space-m) var(--space-l);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
  }
  @media (min-width: 700px) {
    .catering-facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
