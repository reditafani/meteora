</style>

<script>
  const bcRoot = document.querySelector<HTMLElement>('[data-bc-root]');
  if (bcRoot) {
    const bcRows   = Array.from(bcRoot.querySelectorAll<HTMLElement>('[data-bc-row]'));
    const bcSlides = Array.from(bcRoot.querySelectorAll<HTMLElement>('[data-bc-slide]'));
    const imgPrev  = bcRoot.querySelector<HTMLElement>('[data-bc-img-prev]');
    const imgNext  = bcRoot.querySelector<HTMLElement>('[data-bc-img-next]');
    let bcCurrent = 0;
    const subIdx  = new Array(bcSlides.length).fill(0);

    const getSubSlides = (i: number) =>
      Array.from(bcSlides[i]?.querySelectorAll<HTMLElement>('[data-bc-sub]') ?? []);

    const setSubSlide = (barI: number, delta: number) => {
      const subs = getSubSlides(barI);
      if (!subs.length) return;
      subIdx[barI] = (subIdx[barI] + delta + subs.length) % subs.length;
      subs.forEach((s, j) => s.classList.toggle('is-active', j === subIdx[barI]));
    };

    const syncImgArrows = (barI: number) => {
      const show = getSubSlides(barI).length > 1;
      [imgPrev, imgNext].forEach(btn => {
        if (!btn) return;
        btn.style.opacity = show ? '1' : '0';
        btn.style.pointerEvents = show ? '' : 'none';
      });
    };

    const bcActivate = (i: number) => {
      bcCurrent = i;
      bcRows.forEach((r, idx) => r.classList.toggle('is-active', idx === i));
      bcSlides.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
      // Reset sub-image to first
      const subs = getSubSlides(i);
      subIdx[i] = 0;
      subs.forEach((s, j) => s.classList.toggle('is-active', j === 0));
      syncImgArrows(i);
    };

    // Hover and click on list items
    bcRows.forEach((row, i) => {
      row.addEventListener('mouseenter', () => bcActivate(i));
      row.addEventListener('click',      () => bcActivate(i));
    });

    // Image prev/next arrows (inside the photo)
    imgPrev?.addEventListener('click', () => setSubSlide(bcCurrent, -1));
    imgNext?.addEventListener('click', () => setSubSlide(bcCurrent, +1));

    // Touch swipe on the main photo to navigate sub-images
    const bcMain = bcRoot.querySelector<HTMLElement>('.hm-bc__main');
    let bcTouchX = 0;
    bcMain?.addEventListener('touchstart', (e) => {
      bcTouchX = e.touches[0].clientX;
    }, { passive: true });
    bcMain?.addEventListener('touchend', (e) => {
      const dx = bcTouchX - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) setSubSlide(bcCurrent, dx > 0 ? 1 : -1);
    }, { passive: true });

    // Init
    syncImgArrows(0);
  }

  // ── Event types carousel (mobile) ──────────────────────────────────────
  const evGrid = document.querySelector<HTMLElement>('[data-ev-grid]');
  if (evGrid) {
    const evPrev = document.querySelector<HTMLButtonElement>('[data-ev-prev]');
    const evNext = document.querySelector<HTMLButtonElement>('[data-ev-next]');
    const evDots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ev-dot]'));
    const evCount = evDots.length;
    let evCurrent = 0;
    let evTimer = 0;

    // Dots + arrows only; never scrolls
    const evSetActive = (i: number) => {
      evCurrent = Math.max(0, Math.min(i, evCount - 1));
      evDots.forEach((d, j) => d.classList.toggle('is-active', j === evCurrent));
      if (evPrev) evPrev.style.opacity = evCurrent === 0 ? '0.35' : '1';
      if (evNext) evNext.style.opacity = evCurrent === evCount - 1 ? '0.35' : '1';
    };
    const evGo = (i: number) => {
      evSetActive(i);
      evGrid.scrollTo({ left: evCurrent * evGrid.offsetWidth, behavior: 'smooth' });
    };

    evPrev?.addEventListener('click', () => evGo(evCurrent - 1));
    evNext?.addEventListener('click', () => evGo(evCurrent + 1));
    evDots.forEach((d, i) => d.addEventListener('click', () => evGo(i)));

    // After a swipe, scroll-snap places the card; just sync dots and arrows
    // (re-scrolling here fought the finger on diagonal swipes)
    evGrid.addEventListener('scroll', () => {
      clearTimeout(evTimer);
      evTimer = window.setTimeout(() => {
        const w = evGrid.offsetWidth;
        if (!w) return;
        const idx = Math.round(evGrid.scrollLeft / w);
        if (idx !== evCurrent) evSetActive(idx);
      }, 60);
    }, { passive: true });

    // Reveal all cards together when the strip enters the viewport: on mobile
    // the off-screen cards would otherwise rise and fade in while being swiped
    const evRevealIo = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        evGrid.querySelectorAll<HTMLElement>('[data-reveal]').forEach((c) => c.classList.add('is-visible'));
        evRevealIo.disconnect();
      }
    }, { threshold: 0.08 });
    evRevealIo.observe(evGrid);

    // Initial arrow state (prev dimmed at slide 0)
    if (evPrev) evPrev.style.opacity = '0.35';
  }

  // ── Bar collection mobile carousel dots ────────────────────────────────
  const mobTrack = document.querySelector<HTMLElement>('[data-bc-mob-track]');
  if (mobTrack) {
    const mobDots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bc-mob-dot]'));
    const mobCards = Array.from(mobTrack.querySelectorAll<HTMLElement>('[data-bc-mob-card]'));
    let mobTimer = 0;

    const mobActiveDot = (i: number) => mobDots.forEach((d, j) => d.classList.toggle('is-active', j === i));

    mobDots.forEach((d, i) => d.addEventListener('click', () => {
      const card = mobCards[i];
      if (card) mobTrack.scrollTo({ left: card.offsetLeft - mobTrack.offsetLeft, behavior: 'smooth' });
      mobActiveDot(i);
    }));

    mobTrack.addEventListener('scroll', () => {
      clearTimeout(mobTimer);
      mobTimer = window.setTimeout(() => {
        let closest = 0, minDist = Infinity;
        mobCards.forEach((c, i) => {
          const dist = Math.abs(c.offsetLeft - mobTrack.offsetLeft - mobTrack.scrollLeft);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        mobActiveDot(closest);
      }, 60);
    }, { passive: true });
  }
</script>
