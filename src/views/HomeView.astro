    transition: color 0.2s;
  }
  .hm-intro__cta:hover { color: var(--color-accent-ink); }

  /* ── Event types (dark) ── */
  .hm-ev { padding-top: var(--space-l); }
  .hm-ev__head {
    margin-bottom: var(--space-s);
  }
  .hm-ev__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
    margin-bottom: var(--space-s);
  }
  .hm-ev__eyebrow::before {
    content: '';
    display: block;
    width: 2rem; height: 1px;
    background: var(--color-accent-on-dark);
    flex-shrink: 0;
  }
  .hm-ev__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.04;
    color: #fff;
  }
  .hm-ev__title em { font-style: italic; color: var(--color-accent-on-dark); }
  .hm-ev__lead {
    font-size: clamp(0.95rem, 1.5vw + 0.4rem, 1.45rem);
    color: rgba(255,255,255,0.5);
    line-height: 1.65;
    margin-bottom: var(--space-l);
  }
  .hm-ev__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }
  @media (min-width: 700px) {
    .hm-ev__grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* Card */
  .hm-ev__card {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.18);
  }
  .hm-ev__card-img {
    aspect-ratio: 3/4;
    overflow: hidden;
  }
  .hm-ev__card-img :global(picture),
  .hm-ev__card-img :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .hm-ev__card:hover .hm-ev__card-img :global(img) { transform: scale(1.05); }
  @media (hover: none) {
    .hm-ev__card .hm-ev__card-img :global(img) { transition: none; }
    .hm-ev__card:hover .hm-ev__card-img :global(img) { transform: none; }
  }
  .hm-ev__card-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 1.8rem 1.4rem 1.4rem;
    background: linear-gradient(to top, rgba(8,5,3,0.92) 0%, rgba(8,5,3,0.6) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hm-ev__card-num {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.35);
    margin-bottom: 0.2rem;
  }
  .hm-ev__card-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    font-weight: 300;
    color: #fff;
    line-height: 1.1;
  }
  .hm-ev__card-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.82rem, 0.72rem + 0.3vw, 0.95rem);
    color: var(--color-accent-on-dark);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  .hm-ev__card-cta {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255,255,255,0.65);
    transition: color 0.2s;
  }
  .hm-ev__card:hover .hm-ev__card-cta { color: var(--color-accent-on-dark); }

  /* Carousel controls: hidden by default (desktop), activated on mobile */
  .hm-ev__arrow { display: none; }
  .hm-ev__dots  { display: none; }

  /* ── Services ── */
  .hm-svc { padding-top: var(--space-l); }
  .hm-svc__header {
    margin-bottom: var(--space-s);
  }
  .hm-svc__eyebrow {
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent-ink);
    margin-bottom: var(--space-s);
  }
  .hm-svc__eyebrow::before {
    content: ''; display: block;
    width: 2rem; height: 1px;
    background: var(--color-accent-ink); flex-shrink: 0;
  }
  .hm-svc__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.08;
    color: var(--color-text);
  }
  .hm-svc__title em { font-style: italic; color: var(--color-accent-ink); }
  .hm-svc__intro {
    font-size: clamp(0.95rem, 1.5vw + 0.4rem, 1.45rem);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-l);
  }
  /* line break before "I drink…" on desktop only */
  .hm-svc__br { display: none; }
  @media (min-width: 768px) {
    .hm-svc__br { display: inline; }
  }
  .hm-svc__row1 {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-m);
  }
  @media (min-width: 700px) {
    .hm-svc__row1 { grid-template-columns: repeat(3, 1fr); }
  }
  .hm-svc__row2 { display: grid; gap: var(--space-m); }
  @media (min-width: 700px) {
    .hm-svc__row2 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .hm-svc__row2 { grid-template-columns: repeat(3, 1fr); }
  }
  /* Card base */
  .hm-svc__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    background: var(--color-background);
    transition: box-shadow 0.25s;
  }
  .hm-svc__card:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.07); }
  /* Row-1 image: 4:3 on top */
  .hm-svc__row1 .hm-svc__card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    flex-shrink: 0;
  }
  .hm-svc__row1 .hm-svc__card-img :global(picture),
  .hm-svc__row1 .hm-svc__card-img :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .hm-svc__row1 .hm-svc__card:hover .hm-svc__card-img :global(img) { transform: scale(1.04); }
  /* Row-2 card: horizontal layout */
  .hm-svc__card--wide { flex-direction: row; }
  .hm-svc__card--wide .hm-svc__card-img {
    width: 38%; flex-shrink: 0;
    overflow: hidden;
  }
  .hm-svc__card--wide .hm-svc__card-img :global(picture),
  .hm-svc__card--wide .hm-svc__card-img :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: 45% 75%;
    transition: transform 0.8s var(--ease-out);
  }
  .hm-svc__card--wide:hover .hm-svc__card-img :global(img) { transform: scale(1.04); }
  @media (max-width: 699px) {
    .hm-svc__card--wide { flex-direction: column; }
    .hm-svc__card--wide .hm-svc__card-img { width: 100%; aspect-ratio: 4/3; }
  }
  /* Card body */
  .hm-svc__card-body {
    padding: var(--space-m);
    display: flex; flex-direction: column; gap: var(--space-s);
    flex: 1;
  }
  .hm-svc__card-kicker {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.52rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  .hm-svc__card-kicker::before {
    content: ''; display: block;
    width: 1.4rem; height: 1px;
    background: var(--color-accent-ink); flex-shrink: 0;
  }
  .hm-svc__card-name {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-text);
  }
  .hm-svc__card-name em { font-style: italic; color: var(--color-accent-ink); display: block; }
  .hm-svc__card-desc {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
  }
  .hm-svc__card-cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.58rem; font-weight: 500; letter-spacing: 0.12em;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    text-decoration: none;
    margin-top: var(--space-s);
    transition: color 0.2s, border-color 0.2s;
  }
  .hm-svc__card:hover .hm-svc__card-cta { color: var(--color-accent-ink); border-color: var(--color-accent-ink); }
  /* mobile-only bits, hidden on desktop */
  .hm-svc__name-mob,
  .hm-svc__all { display: none; }

  /* Mobile redesign: 2-column grid of framed photos, number + name only,
     one dark CTA under the grid */
  @media (max-width: 699px) {
    .hm-svc__intro { margin-bottom: var(--space-m); }
    .hm-svc__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-m) 0.9rem;
    }
    .hm-svc__row1,
    .hm-svc__row2 { display: contents; }
    .hm-svc__card,
    .hm-svc__card--wide {
      flex-direction: column;
      border: none;
      background: none;
    }
    .hm-svc__card:hover { box-shadow: none; }
    .hm-svc__row1 .hm-svc__card-img,
    .hm-svc__card--wide .hm-svc__card-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      padding: 4px;
      background: #fff;
      border: 1px solid var(--color-border);
    }
    .hm-svc__card--wide .hm-svc__card-img :global(img) { object-position: center; }
    .hm-svc__card-body {
      padding: 0.75rem 0 0;
      gap: 0.3rem;
    }
    .hm-svc__card-kicker {
      font-size: 0.55rem;
      letter-spacing: 0.14em;
    }
    .hm-svc__card-kicker::before,
    .hm-svc__card-cat,
    .hm-svc__dash,
    .hm-svc__card-desc,
    .hm-svc__card-cta,
    .hm-svc__name-desk { display: none; }
    .hm-svc__card-name {
      font-size: clamp(1.1rem, 4.8vw, 1.25rem);
      line-height: 1.2;
    }
    .hm-svc__card-name em { display: inline; }
    .hm-svc__name-mob { display: inline; }
    .hm-svc__all {
      display: flex;
      width: 100%;
      margin-top: var(--space-l);
    }
  }

  /* ── Package ── */
  .hm-pkg {
    position: relative;
    overflow: hidden;
  }
  .hm-pkg__bg {
    position: absolute; inset: 0; z-index: 0;
  }
  .hm-pkg__bg :global(picture),
  .hm-pkg__bg :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .hm-pkg__overlay {
    position: absolute; inset: 0; z-index: 1;
    background: rgba(8,5,3,0.78);
  }
  .hm-pkg__inner {
    position: relative; z-index: 2;
    display: grid;
    gap: clamp(1.2rem, 3.2vw, 4rem);
    align-items: center;
    padding-block: clamp(1rem, 2.5vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .hm-pkg__inner { grid-template-columns: 1fr 0.7fr; align-items: stretch; }
  }
  .hm-pkg__text { display: flex; flex-direction: column; }
  .hm-pkg__eyebrow {
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.58rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent-on-dark);
    margin-bottom: var(--space-s);
  }
  .hm-pkg__eyebrow::before {
    content: ''; display: block;
    width: 2rem; height: 1px;
    background: var(--color-accent-on-dark); flex-shrink: 0;
  }
  .hm-pkg__title {
    font-family: var(--font-display);
    font-size: clamp(1.76rem, 0.96rem + 2.8vw, 3.84rem);
    font-weight: 300;
    line-height: 1.04;
    color: #fff;
  }
  .hm-pkg__title em { display: block; font-style: italic; color: var(--color-accent-on-dark); margin-top: 0.1rem; }
  .hm-pkg__panel {
    background: rgba(8,5,3,0.84);
    border: 1px solid rgba(207,182,138,0.4);
    padding-inline: clamp(1.2rem, 2vw, 2rem);
    padding-block: clamp(0.6rem, 1vw, 1rem);
  }
  .hm-pkg__list { list-style: none; padding: 0; margin: 0; }
  .hm-pkg__aside { display: flex; flex-direction: column; }
  .hm-pkg__panel { flex: 1; }
  .hm-pkg__cta { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; align-self: flex-start; line-height: 1; }
  .hm-pkg__cta-arrow { transition: transform 0.25s var(--ease-out); }
  .hm-pkg__cta:hover .hm-pkg__cta-arrow { transform: translateX(4px); }
  .hm-pkg__cta-mob { display: none; }
  /* Mobile: two-line title, CTA full width below the panel */
  @media (max-width: 699px) {
    .hm-pkg__br,
    .hm-pkg__cta { display: none; }
    .hm-pkg__cta-mob { display: flex; margin-top: var(--space-s); text-transform: uppercase; }
  }
  .hm-pkg__item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .hm-pkg__item:last-child { border-bottom: none; }
  .hm-pkg__check {
    flex-shrink: 0;
    color: var(--color-accent-on-dark);
    margin-top: 0.2rem;
  }
  .hm-pkg__item-body { display: flex; flex-direction: column; gap: 0.25rem; }
  .hm-pkg__item-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.88rem + 0.5vw, 1.2rem);
    font-weight: 300;
    color: rgba(255,255,255,0.9);
    line-height: 1.3;
  }
  .hm-pkg__item-sub {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: rgba(255,255,255,0.42);
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  /* ── Bar Collection ── */
  .hm-bc { padding-top: var(--space-l); }
  .hm-bc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }
  .hm-bc__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    margin-bottom: var(--space-s);
  }
  .hm-bc__eyebrow::before {
    content: '';
    display: block;
    width: 2rem; height: 1px;
    background: var(--color-accent-ink);
    flex-shrink: 0;
  }
  .hm-bc__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1rem + 4vw, 5rem);
    font-weight: 300;
    line-height: 1.04;
    color: var(--color-text);
  }
  .hm-bc__title em { font-style: italic; color: var(--color-accent-ink); }
  .hm-bc__stage {
    display: grid;
    gap: var(--space-l);
    margin-bottom: var(--space-l);
  }
  @media (min-width: 900px) {
    .hm-bc__stage { grid-template-columns: 3fr 2fr; gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  }
  .hm-bc__main {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-background-secondary);
  }
  .hm-bc__main-slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 0.75s var(--ease);
  }
  .hm-bc__main-slide.is-active { opacity: 1; }
  .hm-bc__sub-slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .hm-bc__sub-slide.is-active { opacity: 1; }
  .hm-bc__sub-slide :global(picture),
  .hm-bc__sub-slide :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hm-bc__item-swatch { width: 100%; height: 100%; background: var(--swatch); }
  .hm-bc__img-prev,
  .hm-bc__img-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: flex; align-items: center; justify-content: center;
    width: 1.8rem; height: 1.8rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.4);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.2s, opacity 0.3s;
  }
  .hm-bc__img-prev:hover,
  .hm-bc__img-next:hover { background: rgba(255,255,255,0.28); }
  .hm-bc__img-prev { left: 0.7rem; }
  .hm-bc__img-next { right: 0.7rem; }
  .hm-bc__main-overlay {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.4rem;
    background: linear-gradient(to top, rgba(8,5,3,0.7) 0%, transparent 100%);
  }
  .hm-bc__main-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    font-weight: 300; font-style: italic;
    color: #fff; line-height: 1.1;
  }
  .hm-bc__main-mood {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-accent-on-dark);
    margin-top: 0.25rem;
  }
  .hm-bc__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .hm-bc__item { border-bottom: 1px solid var(--color-border); }
  .hm-bc__item-btn {
    display: flex; align-items: center; gap: 1rem;
    width: 100%; padding: 0.75rem 0;
    background: transparent; border: none; cursor: pointer; text-align: left;
    transition: background 0.15s;
  }
  .hm-bc__item-btn:hover { background: rgba(0,0,0,0.025); }
  .hm-bc__item.is-active .hm-bc__item-btn { background: rgba(0,0,0,0.018); }
  .hm-bc__item-thumb {
    width: 64px; height: 64px; flex-shrink: 0;
    overflow: hidden; background: var(--color-background-secondary);
  }
  .hm-bc__item-thumb :global(picture),
  .hm-bc__item-thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hm-bc__item-info { flex: 1; min-width: 0; }
  .hm-bc__item-name {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
    font-weight: 400; color: var(--color-accent-ink);
    line-height: 1.2; margin-bottom: 0.2rem;
  }
  .hm-bc__item-mood { font-size: 0.7rem; color: var(--color-text-muted); line-height: 1.4; }
  .hm-bc__item-soon { font-size: 0.7rem; font-style: italic; color: var(--color-text-muted); }
  /* ── Mobile carousel (hidden on desktop) ── */
  .hm-bc__mob-carousel { display: none; }
  .hm-bc__mob-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4.5vw, 1.7rem);
    font-weight: 300;
    color: var(--color-text);
    line-height: 1.15;
    margin-top: var(--space-s);
    margin-bottom: 0.2rem;
  }
  .hm-bc__mob-mood {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
  .hm-bc__mob-soon { color: var(--color-accent-ink); }
  .hm-bc__mob-dot {
    width: 7px; height: 7px;
    border-radius: 50px;
    background: color-mix(in srgb, var(--color-accent-ink) 28%, transparent);
    border: none; cursor: pointer; padding: 0;
    flex-shrink: 0;
    transition: width 0.35s var(--ease), background 0.25s;
  }
  .hm-bc__mob-dot.is-active {
    width: 22px;
    background: var(--color-accent-ink);
  }

  /* ── Sizes strip ── */
  /* Desktop: stats + CTA in one bordered flex row */
  .hm-bc__stat-bar {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--color-border);
    margin-top: var(--space-s);
  }
  .hm-bc__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    flex: 1;
  }
  .hm-bc__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem clamp(0.5rem, 1.6vw, 1.4rem);
    border-right: 1px solid var(--color-border);
  }
  .hm-bc__stat:last-of-type { border-right: 1px solid var(--color-border); }
  .hm-bc__stat-label {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  .hm-bc__stat-size {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.1vw, 2rem);
    font-weight: 300;
    color: var(--color-text);
    line-height: 1;
  }
