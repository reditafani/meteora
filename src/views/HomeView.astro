  <script>
    const igGrid = document.querySelector<HTMLElement>('.hm-ig__grid');
    const igPrev = document.querySelector<HTMLButtonElement>('.hm-ig__carr-prev');
    const igNext = document.querySelector<HTMLButtonElement>('.hm-ig__carr-next');
    if (igGrid && igPrev && igNext) {
      const scroll = (dir: number) => {
        const item = igGrid.querySelector<HTMLElement>('.hm-ig__item');
        const step = item ? (item.offsetWidth + 4) * 3 : window.innerWidth;
        igGrid.scrollBy({ left: dir * step, behavior: 'smooth' });
      };
      igPrev.addEventListener('click', () => scroll(-1));
      igNext.addEventListener('click', () => scroll(1));
    }
  </script>

