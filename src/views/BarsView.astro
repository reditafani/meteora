---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BarCard from '@/components/BarCard.astro';
import Img from '@/components/Img.astro';
import CarouselProgress from '@/components/CarouselProgress.astro';
import { bars } from '@/data/bars';
import hero from '@/assets/images/bars/cocktails-lineup.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? { title: 'Banchi Bar Scenografici per Eventi e Matrimoni | Meteora Events', description: 'La collezione di banchi bar Meteora Events: Golden Mirror, Silver Reflection, Pure White e nuovi modelli in arrivo. Modulari, in tre misure, per matrimoni ed eventi.' }
  : { title: 'Luxury Mobile Bar Setups for Weddings & Events | Meteora Events', description: 'The Meteora Events bar collection: Golden Mirror, Silver Reflection, Pure White and new models coming soon. Modular, in three sizes, for weddings and events in Italy.' };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Banchi bar' : 'Bars', href: url('bars', lang) },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: it ? 'Collezione banchi bar Meteora Events' : 'Meteora Events bar collection',
  itemListElement: bars.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name })),
}];

const sizes = [
  { key: 'SLIM',   size: it ? '1,5' : '1.5', unit: it ? 'metri' : 'metres', note: it ? 'fino a 40 ospiti'  : 'up to 40 guests'  },
  { key: 'MEDIUM', size: '3',               unit: it ? 'metri' : 'metres', note: it ? 'fino a 150 ospiti' : 'up to 150 guests' },
  { key: 'LARGE',  size: '6',               unit: it ? 'metri' : 'metres', note: it ? '250+ ospiti'       : '250+ guests'      },
];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('bars')} current="bars" breadcrumbs={crumbs} schema={schema} headerTheme="overlay">

  <!-- ── Full-bleed hero ── -->
  <section class="bh on-dark" aria-labelledby="bh-title">

    <!-- Background image (full width) -->
    <div class="bh__bg">
      <Img src={hero} alt={it ? 'Selezione di cocktail premium sul banco bar' : 'Selection of premium cocktails on the bar counter'} priority sizes="100vw" widths={[800, 1280, 1920]} />
    </div>
    <!-- Gradient overlay: dark left → transparent right -->
    <div class="bh__overlay" aria-hidden="true"></div>

    <!-- Text content -->
    <div class="bh__content">
      <div class="bh__text" data-reveal>
        <h1 id="bh-title">
          {it ? <>Il bar, <em>come scenografia.</em></> : <>The bar, <em>as scenography.</em></>}
        </h1>
        <p class="lead bh__lead" data-reveal style="--delay:.14s">
          {it
            ? <>Banchi bar modulari, professionali e scenografici<br />scelti in base al carattere dell'evento.<br />Una collezione in continuo ampliamento.</>
            : <>Modular, professional, scenographic bars<br />chosen to match the character of your event.<br />A collection that keeps growing.</>}
        </p>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="bh__stats" id="bh-stats">
      {sizes.map(z => (
        <div class="bh__stat">
          <span class="bh__stat-label">{z.key}</span>
          <span class="bh__stat-size">{z.size} <span class="bh__stat-unit">{z.unit}</span></span>
          <span class="bh__stat-note">{z.note}</span>
        </div>
      ))}
      <a class="bh__stat bh__stat--cta" href={url('contact', lang)}>
        <span class="bh__stat-label">{it ? 'SU MISURA' : 'BESPOKE'}</span>
        <em class="bh__stat-custom">{it
          ? <>Contattaci <br class="bh__stat-br" />per altre forme <br />e misure</>
          : <>Contact us <br class="bh__stat-br" />for other sizes <br />and shapes</>}<span class="bh__stat-arrow-inline" aria-hidden="true"> →</span></em>
      </a>
    </div>
    <CarouselProgress lang={lang} for="bh-stats" variant="dark" />

  </section>

  <!-- ── Bar collection ── -->
  <section class="section" style="padding-top: var(--space-l)">
    <div class="container">
      <SectionHeading eyebrow={it ? 'La nostra collezione' : 'Our collection'} class="bars-collection-head">{it ? <>Il banco giusto <em>per ogni evento.</em></> : <>The right bar <em>for every event.</em></>}</SectionHeading>
      <ul class="bars" role="list">
        {bars.map((b, i) => <li data-reveal style={`--delay:${(i % 2) * 0.08}s`}><BarCard bar={b} lang={lang} index={i} sizes="(min-width: 900px) 45vw, 100vw" /></li>)}
      </ul>
    </div>
  </section>

  <!-- ── CTA Band ── -->
  <section class="bars-cta on-dark">
    <div class="container bars-cta__inner">
      <h2 class="bars-cta__title" data-reveal>
        {it ? 'Scegliete il vostro banco.' : 'Choose your bar.'}
      </h2>
      <a class="btn btn--ghost-light cta-pill bars-cta__btn" href={url('contact', lang)} data-reveal style="--delay:.1s">
        {it ? 'Contattaci' : 'Contact us'} →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .bh {
    position: relative;
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Full-bleed background image */
  .bh__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bh__bg :global(picture),
  .bh__bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Gradient: very dark on left for text, fades right */
  .bh__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(10, 7, 5, 0.95) 0%,
      rgba(10, 7, 5, 0.80) 30%,
      rgba(10, 7, 5, 0.38) 60%,
      rgba(10, 7, 5, 0.12) 100%
    );
  }

  /* Text content */
  .bh__content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h, 5rem) + var(--space-l)) clamp(2rem, 6vw, 7rem) 7rem;
    max-width: 52rem;
  }

  .bh__text :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw + 0.5rem, 6rem);
    font-weight: 300;
    line-height: 1.03;
    color: #fff;
  }
  .bh__text :global(h1)::after {
    content: '';
    display: block;
    width: 42px;
    height: 2px;
    background: var(--color-accent-on-dark);
    margin-top: var(--space-m);
    margin-bottom: var(--space-m);
  }
  .bh__text :global(h1 em) {
    font-style: italic;
    color: var(--color-accent-on-dark);
    display: block;
  }
  .bh__lead {
    color: rgba(255 255 255 / 0.72);
    max-width: 32rem;
  }

  /* Stats bar — anchored to hero bottom */
  .bh__stats {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(8, 5, 3, 0.88);
    border-top: 1px solid rgba(255 255 255 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .bh__stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.6rem clamp(1.2rem, 2.5vw, 2.5rem);
    border-right: 1px solid rgba(255 255 255 / 0.08);
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .bh__stat:last-child { border-right: none; }

  .bh__stat-label {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: rgba(255 255 255 / 0.45);
    margin-bottom: 0.1rem;
  }
  .bh__stat-size {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.6vw, 1.8rem);
    font-weight: 300;
    color: var(--color-accent-on-dark);
    line-height: 1;
  }
  .bh__stat-note {
    font-size: 0.65rem;
    color: rgba(255 255 255 / 0.4);
    letter-spacing: 0.02em;
    margin-top: 0.1rem;
  }

  /* SU MISURA column */
  .bh__stat--cta { transition: background 0.2s; }
  .bh__stat--cta:hover { background: rgba(255 255 255 / 0.04); }
  .bh__stat-custom {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    font-style: italic;
    color: var(--color-accent-on-dark);
    line-height: 1.25;
  }

  /* ── Mobile ── */
  @media (max-width: 699px) {
    .bh {
      height: auto;
      min-height: unset;
    }
    .bh__overlay {
      background: linear-gradient(
        to top,
        rgba(10, 7, 5, 0.90) 0%,
        rgba(10, 7, 5, 0.55) 50%,
        rgba(10, 7, 5, 0.30) 100%
      );
    }
    .bh__content {
      min-height: 68svh;
      padding: calc(var(--header-h, 4rem) + 1rem) var(--gutter) var(--space-l);
    }
    /* Stats: scroll-snap carousel of square cards below the hero text */
    .bh__stats {
      position: relative;
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: var(--space-m) var(--gutter) 0;
      scroll-padding-inline: var(--gutter);
      /* solid black band below the hero image, as on the home perks strip */
      background: rgb(8 5 3);
      border-top: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .bh__stats::-webkit-scrollbar { display: none; }
    .bh :global(.cprog) {
      position: relative;
      z-index: 2;
      margin-top: 0;
      padding-block: 16px; /* 16px from the cards, 16px to the band's end */
      background: rgb(8 5 3);
    }
    .bh__stat {
      flex: 0 0 32%;
      min-width: 0;
      aspect-ratio: 5 / 4; /* a bit lower than square, like the services cards */
      scroll-snap-align: start;
      justify-content: space-between;
      align-items: center;
      gap: 0;
      padding: 0.3rem 0.45rem 0.35rem;
      border: 1px solid rgba(201, 183, 143, 0.4);
      background: none;
      text-align: center;
    }
    .bh__stat:last-child { border-right: 1px solid rgba(201, 183, 143, 0.4); }
    .bh__stat-label { font-size: 0.6rem; margin-bottom: 0; }
    .bh__stat-size  { font-size: clamp(1.1rem, 4.8vw, 1.4rem); line-height: 1.1; }
    .bh__stat-unit  { display: block; }
    .bh__stat-note  { font-size: 0.78rem; margin-top: 0; white-space: nowrap; }
    .bh__stat-custom { font-size: clamp(0.95rem, 4.1vw, 1.15rem); line-height: 1.15; white-space: nowrap; }
  }
  /* desktop: "Contattaci per altre forme" / "e misure →" */
  @media (min-width: 700px) {
    .bh__stat-br { display: none; }
  }

  /* ── Collection heading: single-line title, less gap before photos ── */
  :global(.bars-collection-head) {
    margin-bottom: 2.8rem !important;
  }
  :global(.bars-collection-head .sh__title) {
    max-width: none;
    white-space: nowrap;
  }

  /* ── Bar list ── */
  .bars {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }
  @media (min-width: 900px) {
    .bars { grid-template-columns: 1fr 1fr; }
  }
  .bars__note {
    margin-top: var(--space-xl);
    max-width: 40rem;
    font-size: var(--fs-small);
  }

  /* ── CTA Band ── */
  .bars-cta {
    background: var(--color-dark);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }
  .bars-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    flex-wrap: wrap;
  }
  .bars-cta__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw + 0.5rem, 4rem);
    font-weight: 300;
    font-style: italic;
    color: #fff;
    line-height: 1.05;
  }
  .bars-cta__btn {
    flex-shrink: 0;
    letter-spacing: 0.1em;
  }
  @media (max-width: 699px) {
    /* title on a single line next to the button: title shrinks with the screen */
    .bars-cta__inner {
      flex-wrap: nowrap;
      gap: 0.75rem;
    }
    .bars-cta__title {
      font-size: min(calc(10.3vw - 18px), 2rem);
      white-space: nowrap;
    }
    /* keeps the button on one line beside the title */
    a.bars-cta__btn {
      white-space: nowrap;
    }
    :global(.bars-collection-head .sh__title) { white-space: normal; }
  }
</style>
