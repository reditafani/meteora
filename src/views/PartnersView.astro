---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PartnerForm from '@/components/PartnerForm.astro';
import NetworkCard from '@/components/NetworkCard.astro';
import { byRegion, regionLabels } from '@/data/network';
import hall from '@/assets/images/venues/fresco-hall.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);

const meta = it
  ? {
      title: 'Wedding Planner e Location in Toscana e in Italia | Meteora Events',
      description: 'Una selezione curata di Wedding Planner e Location in Toscana e in Italia. Meteora Events offre anche condizioni dedicate ai professionisti del settore wedding.',
    }
  : {
      title: 'Wedding Planners & Venues in Tuscany and Italy | Meteora Events',
      description: 'A curated selection of wedding planners and venues in Tuscany and Italy. Meteora Events also offers dedicated terms for wedding industry professionals.',
    };

const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Collabora con noi' : 'Work with us', href: url('partners', lang) },
];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: meta.title,
  url: new URL(url('partners', lang), site.url + '/').toString(),
}];

const wpGroups = byRegion('wedding-planner');
const locGroups = byRegion('location');

const benefitsList = it
  ? [
      { num: '01', title: 'Condizioni dedicate',         body: 'Un listino riservato al professionista, con condizioni studiate per il settore wedding.' },
      { num: '02', title: 'Libertà commerciale',         body: 'La libertà di costruire la propria proposta economica al cliente finale.' },
      { num: '03', title: 'Un servizio premium',         body: 'Cocktail bar, open bar, personale e hospitality pensati per eventi di alto livello.' },
      { num: '04', title: 'Un interlocutore professionale', body: 'Meteora Events come partner operativo affidabile per il servizio bar.' },
    ]
  : [
      { num: '01', title: 'Dedicated pricing',    body: 'A professional price list with terms designed for the wedding industry.' },
      { num: '02', title: 'Commercial freedom',   body: 'The freedom to build your own commercial proposal to the end client.' },
      { num: '03', title: 'A premium service',    body: 'Cocktail bar, open bar, staff and hospitality designed for high-end events.' },
      { num: '04', title: 'A professional partner', body: 'Meteora Events as a reliable operational partner for bar service.' },
    ];

const joinSteps = it
  ? [
      { num: '01', body: 'Meteora individua le realtà che ritiene interessanti per qualità, estetica e professionalità.' },
      { num: '02', body: 'Contatta personalmente il professionista o la struttura.' },
      { num: '03', body: 'Se accetti, raccogliamo le informazioni e costruiamo il profilo.' },
      { num: '04', body: 'Il profilo viene pubblicato gratuitamente sul sito Meteora Events.' },
    ]
  : [
      { num: '01', body: 'Meteora identifies professionals it considers outstanding in quality, aesthetics and service.' },
      { num: '02', body: 'We reach out directly to the professional or venue.' },
      { num: '03', body: 'If you accept, we collect your details and build your profile.' },
      { num: '04', body: 'Your profile is published for free on the Meteora Events website.' },
    ];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('partners')} current="partners" breadcrumbs={crumbs} schema={schema} showQuoteBar={false} headerTheme="overlay">

  <!-- 1 · HERO -->
  <PageHero variant="fullscreen" image={hall} imageAlt={it ? 'Tavolo imperiale in un salone affrescato' : 'Long table in a frescoed hall'} crumbs={crumbs}>
    <h1>{it ? <>Professionisti con cui <em>condividiamo la visione.</em></> : <>Professionals who <em>share our vision.</em></>}</h1>
    <p slot="lead" class="lead muted">
      {it
        ? 'Wedding Planner, Location e professionisti selezionati con cui Meteora Events condivide una visione fatta di qualità, estetica e attenzione all\'esperienza.'
        : 'Wedding planners, venues and selected professionals who share Meteora Events\' commitment to quality, aesthetics and experience.'}
    </p>
    <div slot="cta" class="cta-row">
      <a class="btn btn--light" href="#partner-form">{it ? 'Richiedi il listino partner' : 'Request partner pricing'}</a>
      <a class="link" href="#selezione">{it ? 'Scopri la selezione' : 'Discover the selection'}</a>
    </div>
  </PageHero>

  <!-- 2 · INTRO NETWORK -->
  <section class="section section--alt">
    <div class="container container--narrow net-intro">
      <p class="eyebrow" data-reveal>{it ? 'Il network Meteora' : 'The Meteora network'}</p>
      <h2 data-reveal style="--delay:.08s">{it ? <>Una rete costruita <em>intorno alla qualità.</em></> : <>A network built <em>around quality.</em></>}</h2>
      <p data-reveal style="--delay:.12s">
        {it
          ? 'Meteora Events non lavora isolata. Nel corso degli anni abbiamo costruito relazioni con Wedding Planner, Location e professionisti che condividono la nostra attenzione alla qualità, all\'estetica e all\'esperienza ospite.'
          : 'Meteora Events doesn\'t work in isolation. Over the years we have built relationships with wedding planners, venues and professionals who share our commitment to quality, aesthetics and the guest experience.'}
      </p>
      <p data-reveal style="--delay:.16s">
        {it
          ? 'Non una lista infinita di fornitori. Una selezione curata di realtà che sentiamo vicine per sensibilità e approccio.'
          : 'Not an endless supplier list. A curated selection of people and places we consider close to us in sensibility and approach.'}
      </p>
    </div>
  </section>

  <!-- 3 · DIRECTORY WEDDING PLANNER -->
  <section class="section" id="selezione" aria-labelledby="a-wp">
    <div class="container">
      <p class="eyebrow" data-reveal>{it ? 'La selezione Meteora' : 'The Meteora Selection'}</p>
      <h2 id="a-wp" data-reveal style="--delay:.08s">{it ? <>Wedding <em>Planner.</em></> : <>Wedding <em>Planners.</em></>}</h2>
      <p class="dir-intro muted" data-reveal style="--delay:.12s">
        {it
          ? 'Una selezione di Wedding Planner con cui siamo in contatto o che riteniamo realtà interessanti nel panorama italiano.'
          : 'A curated selection of wedding planners we know or consider outstanding in their field.'}
      </p>
      {wpGroups.map(group => (
        <div class="dir-region">
          <p class="dir-region__label micro">{regionLabels[group.region][lang]}</p>
          <div class="dir-grid">
            {group.items.map(p => <NetworkCard professional={p} lang={lang} />)}
          </div>
        </div>
      ))}
      {wpGroups.length === 0 && (
        <div class="dir-empty" data-reveal>
          <p class="muted">
            {it ? 'La selezione è in fase di cura. Tornate presto.' : 'Our selection is being curated. Check back soon.'}
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- 4 · DIRECTORY LOCATION -->
  <section class="section section--alt" aria-labelledby="a-loc">
    <div class="container">
      <p class="eyebrow" data-reveal>{it ? 'La selezione Meteora' : 'The Meteora Selection'}</p>
      <h2 id="a-loc" data-reveal style="--delay:.08s">{it ? <>Location <em>selezionate.</em></> : <>Selected <em>venues.</em></>}</h2>
      <p class="dir-intro muted" data-reveal style="--delay:.12s">
        {it
          ? 'Location di qualità con cui siamo in contatto o che consideriamo realtà di riferimento nel panorama del matrimonio in Italia.'
          : 'Quality venues we know or consider outstanding references in the Italian wedding landscape.'}
      </p>
      {locGroups.map(group => (
        <div class="dir-region">
          <p class="dir-region__label micro">{regionLabels[group.region][lang]}</p>
          <div class="dir-grid">
            {group.items.map(p => <NetworkCard professional={p} lang={lang} />)}
          </div>
        </div>
      ))}
      {locGroups.length === 0 && (
        <div class="dir-empty" data-reveal>
          <p class="muted">
            {it ? 'La selezione è in fase di cura. Tornate presto.' : 'Our selection is being curated. Check back soon.'}
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- 5 · B2B CTA + FORM -->
  <section class="section section--dark" id="partner-form" aria-labelledby="a-b2b">
    <div class="container pf">
      <div class="pf__intro">
        <p class="eyebrow" data-reveal>{it ? 'Per i professionisti' : 'For professionals'}</p>
        <h2 id="a-b2b" data-reveal style="--delay:.08s">
          {it
            ? <>Sei una Wedding Planner <em>o rappresenti una Location?</em></>
            : <>Are you a wedding planner <em>or do you represent a venue?</em></>}
        </h2>
        <p class="lead muted" data-reveal style="--delay:.12s">
          {it
            ? 'Meteora Events riserva ai professionisti del settore condizioni dedicate per integrare cocktail bar, open bar e servizi di hospitality nelle proprie proposte. Il listino partner non è pubblico: richiedi di riceverlo.'
            : 'Meteora Events offers dedicated terms to wedding professionals who want to integrate cocktail bar, open bar and hospitality services into their proposals. Partner pricing is not public: request it here.'}
        </p>
        <ol class="ben__list" role="list">
          {benefitsList.map((b, i) => (
            <li data-reveal style={`--delay:${(i * 0.06 + 0.16).toFixed(2)}s`}>
              <span class="micro ben__num">{b.num}</span>
              <div class="ben__content">
                <p class="ben__title">{b.title}</p>
                <p class="muted ben__body">{b.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="pf__form-wrap">
        <PartnerForm lang={lang} />
      </div>
    </div>
  </section>

  <!-- 6 · COME ENTRARE NELLA SELEZIONE -->
  <section class="section section--alt" aria-labelledby="a-join">
    <div class="container container--narrow">
      <p class="eyebrow" data-reveal>{it ? 'La selezione Meteora' : 'The Meteora selection'}</p>
      <h2 id="a-join" data-reveal style="--delay:.08s">{it ? <>Vuoi entrare <em>nella selezione?</em></> : <>Want to join <em>the selection?</em></>}</h2>
      <ol class="join-steps" role="list">
        {joinSteps.map((step, i) => (
          <li data-reveal style={`--delay:${(i * 0.07).toFixed(2)}s`}>
            <span class="micro join-num">{step.num}</span>
            <p class="join-body">{step.body}</p>
          </li>
        ))}
      </ol>
      <div class="join-foot" data-reveal>
        <a class="link" href="#partner-form">{it ? 'Segnala la tua realtà' : 'Put your business forward'}</a>
        <p class="join-note muted">
          {it
            ? 'La presenza nella selezione è gratuita e subordinata alla valutazione di Meteora Events.'
            : "Inclusion in the selection is free and subject to Meteora Events' approval."}
        </p>
      </div>
    </div>
  </section>

  <!-- 7 · CHIUSURA B2C -->
  <section class="section section--dark" aria-labelledby="a-b2c">
    <div class="container b2c">
      <p class="eyebrow" data-reveal>{it ? 'Per gli sposi' : 'For couples'}</p>
      <h2 id="a-b2c" data-reveal style="--delay:.08s">{it ? <>Stai organizzando <em>il tuo matrimonio?</em></> : <>Planning <em>your wedding?</em></>}</h2>
      <p class="lead muted" data-reveal style="--delay:.12s">
        {it
          ? 'Scopri la selezione di Wedding Planner e Location oppure parla direttamente con noi per progettare il servizio bar del tuo evento.'
          : 'Discover our selection of wedding planners and venues, or speak directly with us to design the bar service for your event.'}
      </p>
      <div class="cta-row" data-reveal style="--delay:.16s">
        <a class="btn btn--light" href="#selezione">{it ? 'Scopri la selezione' : 'Discover the selection'}</a>
        <a class="link" href={url('contact', lang)}>{it ? 'Parla con Meteora' : 'Talk to Meteora'}</a>
      </div>
      <p class="b2c__note muted" data-reveal style="--delay:.2s">
        {it
          ? 'La scelta di una Wedding Planner o di una Location presente nella nostra selezione è del tutto indipendente dalla possibilità di affidare a Meteora Events il servizio bar del tuo matrimonio.'
          : 'Choosing a wedding planner or venue from our selection is entirely independent of your decision to hire Meteora Events for your wedding bar service.'}
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Intro network ── */
  .net-intro {
    text-align: center;
  }
  .net-intro > * + * {
    margin-top: var(--space-m);
  }
  .net-intro p:not(.eyebrow) {
    max-width: 38rem;
    margin-inline: auto;
  }

  /* ── Directory shared ── */
  .dir-intro {
    font-size: var(--fs-small);
    margin-top: var(--space-m);
    margin-bottom: var(--space-xl);
    max-width: 44rem;
  }
  .dir-region {
    margin-top: var(--space-xl);
  }
  .dir-region__label {
    letter-spacing: var(--tracking-micro);
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-m);
  }
  .dir-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-l);
  }
  .dir-empty {
    padding-block: var(--space-xl);
    text-align: center;
    border: 1px solid var(--color-border);
    margin-top: var(--space-l);
  }

  /* ── B2B section ── */
  .pf {
    display: grid;
    gap: var(--space-xl);
  }
  .pf__intro > * + * {
    margin-top: var(--space-m);
  }
  .pf__form-wrap {
    background: var(--color-background);
    color: var(--color-text);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .ben__list {
    margin-top: var(--space-l);
    list-style: none;
    padding: 0;
  }
  .ben__list li {
    display: flex;
    gap: var(--space-m);
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid rgba(255 255 255 / 0.14);
  }
  .ben__num {
    color: var(--color-accent-on-dark);
    flex: none;
    min-width: 2ch;
  }
  .ben__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 300;
    line-height: 1.2;
  }
  .ben__body {
    font-size: var(--fs-small);
    margin-top: 0.3rem;
  }
  @media (min-width: 960px) {
    .pf {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 7vw, 8rem);
      align-items: start;
    }
  }

  /* ── Join section ── */
  .join-steps {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
    list-style: none;
    padding: 0;
  }
  .join-steps li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
  }
  .join-num {
    color: var(--color-accent-ink);
    display: block;
    margin-bottom: 0.5rem;
  }
  .join-body {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }
  .join-foot {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-s);
  }
  .join-note {
    font-size: var(--fs-small);
    font-style: italic;
  }
  @media (min-width: 640px) {
    .join-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .join-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── B2C closing ── */
  .b2c {
    max-width: 52rem;
  }
  .b2c > * + * {
    margin-top: var(--space-m);
  }
  .b2c .cta-row {
    margin-top: var(--space-l);
  }
  .b2c__note {
    font-size: var(--fs-small);
    max-width: 42rem;
    margin-top: var(--space-l);
    font-style: italic;
    color: var(--color-on-dark-muted);
  }
</style>
