</style>

<script define:vars={{ prosData, contactUrl, langCode }}>
  const it = langCode === 'it';

  function buildPanel(pro) {
    const infoItems = [
      { label: it ? 'BASE' : 'BASE', value: pro.area },
      pro.languages?.length ? { label: it ? 'LINGUE' : 'LANGUAGES', value: pro.languages.join(' · ') } : null,
      pro.budget ? { label: 'BUDGET', value: pro.budget } : null,
      pro.bookingLead ? { label: it ? 'PRENOTARE' : 'BOOK', value: pro.bookingLead } : null,
    ].filter(Boolean);

    return `
      <div class="pd">
        <div class="pd__media">
          ${pro.imageSrc
            ? `<img src="${pro.imageSrc}" alt="${pro.imageAlt}" class="pd__img" loading="lazy" />`
            : `<div class="pd__img-placeholder"><span>${pro.name.slice(0,1)}</span></div>`
          }
        </div>
        <div class="pd__body">
          <button class="pd__close" aria-label="${it ? 'Chiudi' : 'Close'}">×</button>
          <p class="pd__eyebrow">${pro.area} · ${pro.typeLabel}</p>
          <h3 class="pd__name">${pro.name}</h3>
          <p class="pd__tagline">${pro.tagline}</p>
          <p class="pd__desc">${pro.description}</p>
          ${infoItems.length ? `
            <div class="pd__info-grid">
              ${infoItems.map(item => `
                <div>
                  <span class="pd__info-label">${item.label}</span>
                  <strong class="pd__info-val">${item.value}</strong>
                </div>
              `).join('')}
            </div>
          ` : ''}
          ${pro.tags?.length ? `
            <div class="pd__tags">
              ${pro.tags.map(t => `<span class="pd__tag">${t}</span>`).join('')}
            </div>
          ` : ''}
          ${pro.advice ? `
            <div class="pd__advice">
              <p class="pd__advice-label">${it ? 'IL CONSIGLIO DI METEORA' : "METEORA'S ADVICE"}</p>
              <p class="pd__advice-quote">"${pro.advice}"</p>
            </div>
          ` : ''}
          <div class="pd__links">
            ${pro.website ? `<a href="${pro.website}" target="_blank" rel="noopener" class="pd__link">${it ? 'SITO WEB' : 'WEBSITE'} ↗</a>` : ''}
            ${pro.instagram ? `<a href="${pro.instagram}" target="_blank" rel="noopener" class="pd__link">INSTAGRAM ↗</a>` : ''}
            <a href="${contactUrl}" class="pd__link">${it ? 'CONTATTACI' : 'CONTACT US'}</a>
          </div>
        </div>
      </div>
    `;
  }

  document.querySelectorAll('.pf-section').forEach(section => {
    const grid = section.querySelector('.pf-section__grid');
    const detail = section.querySelector('.pf__detail');
    const detailInner = detail?.querySelector('.pf__detail-inner');
    if (!grid || !detail || !detailInner) return;

    let openId = null;

    function closePanel() {
      detail.classList.remove('is-open');
      if (openId) {
        const prevBtn = grid.querySelector(`.sc__toggle[data-pro-id="${openId}"]`);
        if (prevBtn) {
          prevBtn.setAttribute('aria-expanded', 'false');
          prevBtn.querySelector('.sc__lbl-open').style.display = '';
          prevBtn.querySelector('.sc__lbl-close').style.display = 'none';
        }
        openId = null;
      }
    }

    function openPanel(proId) {
      const pro = prosData[proId];
      if (!pro) return;
      detailInner.innerHTML = buildPanel(pro);
      detail.classList.add('is-open');
      detailInner.querySelector('.pd__close')?.addEventListener('click', () => closePanel());
      setTimeout(() => detail.scrollIntoView({ behavior: 'smooth', block: 'start' }), 450);
    }

    grid.querySelectorAll('.sc__toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const proId = btn.dataset.proId;
        const isOpen = openId === proId;

        if (openId && openId !== proId) {
          const prevBtn = grid.querySelector(`.sc__toggle[data-pro-id="${openId}"]`);
          if (prevBtn) {
            prevBtn.setAttribute('aria-expanded', 'false');
            prevBtn.querySelector('.sc__lbl-open').style.display = '';
            prevBtn.querySelector('.sc__lbl-close').style.display = 'none';
          }
        }

        if (isOpen) {
          closePanel();
        } else {
          openId = proId;
          btn.setAttribute('aria-expanded', 'true');
          btn.querySelector('.sc__lbl-open').style.display = 'none';
          btn.querySelector('.sc__lbl-close').style.display = '';
          openPanel(proId);
        }
      });
    });
  });
</script>

<script>
  const howGrid = document.querySelector<HTMLElement>('[data-how-grid]');
  const howPrev = document.querySelector<HTMLButtonElement>('[data-how-prev]');
  const howNext = document.querySelector<HTMLButtonElement>('[data-how-next]');
  const howDots = document.querySelectorAll<HTMLElement>('[data-how-dot]');
  let howCurrent = 0;

  function howGo(to: number) {
    const total = howDots.length || 3;
    howCurrent = ((to % total) + total) % total;
    howGrid?.scrollTo({ left: howCurrent * (howGrid.offsetWidth), behavior: 'smooth' });
    howDots.forEach((d, i) => d.classList.toggle('is-active', i === howCurrent));
  }

  howPrev?.addEventListener('click', () => howGo(howCurrent - 1));
  howNext?.addEventListener('click', () => howGo(howCurrent + 1));
  howDots.forEach((d, i) => d.addEventListener('click', () => howGo(i)));

  let howScrollTimer: ReturnType<typeof setTimeout>;
  howGrid?.addEventListener('scroll', () => {
    clearTimeout(howScrollTimer);
    howScrollTimer = setTimeout(() => {
      if (!howGrid) return;
      const idx = Math.round(howGrid.scrollLeft / howGrid.offsetWidth);
      if (idx !== howCurrent) {
        howCurrent = idx;
        howDots.forEach((d, i) => d.classList.toggle('is-active', i === howCurrent));
      }
    }, 80);
  }, { passive: true });

  let howTouchX = 0;
  howGrid?.addEventListener('touchstart', (e) => { howTouchX = e.touches[0].clientX; }, { passive: true });
  howGrid?.addEventListener('touchend', (e) => {
    const dx = howTouchX - e.changedTouches[0].clientX;
    if (Math.abs(dx) > 40) howGo(howCurrent + (dx > 0 ? 1 : -1));
  }, { passive: true });
</script>
