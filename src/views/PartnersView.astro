---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import SupplierCard from '@/components/SupplierCard.astro';
import { professionalsOfType, typeLabels } from '@/data/network';
import hero           from '@/assets/images/weddings/sumatra-weddings-hero.jpg';
import howImg1        from '@/assets/images/venues/wedding-table-candles.jpg';
import howImg2        from '@/assets/images/destinations/tuscany-villa-aerial.jpg';
import howImg3        from '@/assets/images/bars/bartender-event.jpg';
import ctaBg          from '@/assets/images/venues/wedding-hall-chandeliers.jpg';
import wpSectionImg   from '@/assets/images/weddings/couple-holding-hands.jpg';
import locSectionImg  from '@/assets/images/destinations/tuscany-hills.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);

const meta = it
  ? { title: 'Wedding Planner e Location in Italia | Meteora Events', description: 'Una selezione curata di wedding planner e location in Italia. I professionisti che consigliamo alle coppie che scelgono Meteora Events per il bar del loro matrimonio.' }
  : { title: 'Wedding Planners & Venues in Italy | Meteora Events', description: 'A curated selection of wedding planners and venues in Italy. The professionals we recommend to couples choosing Meteora Events for their wedding bar.' };

const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Fornitori consigliati' : 'Recommended suppliers', href: url('partners', lang) },
];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: meta.title,
  url: new URL(url('partners', lang), site.url + '/').toString(),
}];

const weddingPlanners = professionalsOfType('wedding-planner');
const locations       = professionalsOfType('location');
const contactUrl      = url('contact', lang);
const langCode        = lang;

const howSteps = it
  ? [
      { img: howImg1, alt: 'Tavolo nuziale allestito con fiori', num: '1', title: 'Scegliete la vostra planner.', desc: 'È la regista del vostro giorno. Darà forma alle vostre idee, vi consiglierà sul budget e gestirà ogni imprevisto, perché voi possiate viverlo senza pensieri.', cta: 'LE PLANNER', href: '#wedding-planner' },
      { img: howImg2, alt: 'Paesaggio toscano con villa', num: '2', title: 'Trovate la vostra location.', desc: 'È la cornice del vostro giorno: il luogo dove i vostri ricordi più belli prenderanno vita.', cta: 'LE LOCATION', href: '#location' },
      { img: howImg3, alt: 'Dettaglio tableau de mariage', num: '3', title: "Raccontateci com'è andata.", desc: "La vostra esperienza sarà preziosa per altre coppie come voi, e ci aiuterà a mantenere questa lista all'altezza, stagione dopo stagione.", cta: 'INIZIA DA QUI', href: contactUrl },
    ]
  : [
      { img: howImg1, alt: 'Wedding table set with flowers', num: '1', title: 'Choose your planner.', desc: "She is the director of your day. She will shape your ideas, advise on budget and handle every surprise, so you can live it without a worry.", cta: 'THE PLANNERS', href: '#wedding-planner' },
      { img: howImg2, alt: 'Tuscan landscape with villa', num: '2', title: 'Find your venue.', desc: "It is the frame of your day: the place where your most beautiful memories will come to life.", cta: 'THE VENUES', href: '#location' },
      { img: howImg3, alt: 'Wedding place card detail', num: '3', title: "Get in touch and tell us how it went.", desc: "Your experience will be precious for other couples like you, and will help us keep this list at its best, season after season.", cta: 'START HERE', href: contactUrl },
    ];

const faqItems = it
  ? [
      { q: 'Possiamo scegliere i fornitori liberamente?', a: 'Sì: questa è la vostra lista personale di suggerimenti. Siete liberi di scegliere qualsiasi professionista, con o senza il nostro bar.' },
      { q: "Qual è il piano B se piove?", a: 'Parlatene con location e planner prima di firmare: ogni scelta dipende dagli spazi coperti disponibili nella struttura.' },
      { q: 'Cosa è incluso nel contratto con la location?', a: 'Ogni voce deve essere scritta in nero su bianco: cosa è incluso, cosa non lo è, e cosa costa extra.' },
      { q: "Fino a che ora possiamo fare musica all'aperto?", a: 'I limiti variano per ogni location e comune. Verificateli prima di firmare il contratto.' },
      { q: 'Come ottimizzare gli ospiti a fine serata?', a: 'Organizzate il transfer in anticipo: è il dettaglio che fa la differenza quando la festa finisce.' },
    ]
  : [
      { q: 'Can we choose our own suppliers freely?', a: 'Yes: this is your personal list of recommendations. You are free to choose any professional, with or without our bar.' },
      { q: 'What is plan B if it rains?', a: 'Discuss this with the venue and planner before signing: every decision depends on the covered spaces available.' },
      { q: 'What is included in the venue contract?', a: 'Every item must be in black and white: what is included, what is not, and what costs extra.' },
      { q: 'Until what time can we have outdoor music?', a: 'Limits vary by venue and municipality. Check them before signing the contract.' },
      { q: 'How to manage guests at the end of the evening?', a: 'Arrange the transfer in advance: it is the detail that makes the difference when the party ends.' },
    ];

const allPros = [...weddingPlanners, ...locations];
const prosData: Record<string, object> = {};
for (const p of allPros) {
  prosData[p.id] = {
    id: p.id,
    type: p.type,
    typeLabel: typeLabels[p.type][lang],
    area: p.area[lang],
    name: p.name,
    tagline: p.tagline[lang],
    description: p.description[lang],
    tags: p.tags ?? [],
    budget: p.budget ?? null,
    languages: p.languages ?? [],
    bookingLead: p.bookingLead?.[lang] ?? null,
    advice: p.advice?.[lang] ?? null,
    website: p.website ?? null,
    instagram: p.instagram ?? null,
    featured: p.featured ?? false,
    imageSrc: p.image?.src ?? null,
    imageAlt: p.imageAlt?.[lang] ?? p.name,
  };
}
---

<BaseLayout
  lang={lang}
  title={meta.title}
  description={meta.description}
  alternates={alternatesFor('partners')}
  current="partners"
  breadcrumbs={crumbs}
  schema={schema}
  headerTheme="overlay"
>

  <!-- ── Hero ── -->
  <section class="ph on-dark" aria-labelledby="ph-title">
    <div class="ph__bg">
      <Img src={hero} alt={it ? 'Matrimonio in un giardino fiorito' : 'Wedding in a flower garden'} priority sizes="100vw" widths={[800, 1280, 1920]} />
    </div>
    <div class="ph__overlay" aria-hidden="true"></div>
    <div class="ph__content">
      <h1 id="ph-title" data-reveal>
        {it
          ? <>Le persone giuste <em>per il vostro giorno.</em></>
          : <>The right people <em>for your day.</em></>}
      </h1>
      <p class="lead ph__lead" data-reveal style="--delay:.1s">
        {it
          ? `Wedding planner e location selezionati, per aiutarvi a organizzare il vostro matrimonio in Italia con chi sa davvero farlo. Li abbiamo scelti per la loro professionalità, serietà e affidabilità.`
          : `Selected wedding planners and venues, to help you plan your wedding in Italy with people who truly know how. We chose them for their professionalism, seriousness and reliability.`}
      </p>
      <div class="ph__badge" data-reveal style="--delay:.18s">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>
          <span class="ph__badge-desk">{it ? 'Selezione indipendente. Nessuno paga per essere in questa pagina.' : 'Independent selection. No one pays to be on this page.'}</span>
          <span class="ph__badge-mob">{it
            ? <>Selezione indipendente.<br />Nessuno paga per essere in questa lista.</>
            : <>Independent selection.<br />No one pays to be on this list.</>}</span>
        </span>
      </div>
    </div>
    <nav class="ph__tabs" aria-label={it ? 'Categorie fornitori' : 'Supplier categories'}>
      <a href="#wedding-planner">Wedding <br class="ph__br" />Planner</a>
      <a href="#location">Location</a>
      <a href="#pf-faq">FAQ</a>
    </nav>
  </section>

  <!-- ── Come funziona ── -->
  <section class="section pf-how">
    <div class="container">
      <p class="eyebrow pf-how__eyebrow" data-reveal>{it ? 'Come funziona' : 'How it works'}</p>
      <div class="pf-how__carousel">
        <button class="pf-how__arrow pf-how__arrow--prev" data-how-prev aria-label={it ? 'Passo precedente' : 'Previous step'}>
          <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true"><path d="M8 1 1 8l7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="pf-how__arrow pf-how__arrow--next" data-how-next aria-label={it ? 'Passo successivo' : 'Next step'}>
          <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true"><path d="M1 1l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pf-how__grid" data-how-grid>
          {howSteps.map((step, i) => (
            <div class="pf-how__col" data-reveal style={`--delay:${i * 0.07}s`}>
              <div class="pf-how__img">
                <Img src={step.img} alt={step.alt} sizes="(min-width: 900px) 30vw, 90vw" widths={[480, 800]} />
              </div>
              <div class="pf-how__body">
                <h3 class="pf-how__title">{step.title}</h3>
                <p class="pf-how__desc">{step.desc}</p>
                <a class="pf-how__cta" href={step.href}>{step.cta} →</a>
              </div>
            </div>
          ))}
        </div>
        <div class="pf-how__dots" aria-hidden="true">
          {howSteps.map((_, i) => (
            <span class:list={['pf-how__dot', i === 0 && 'is-active']} data-how-dot={i}></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Wedding Planner ── -->
  <section class="section--alt pf-section" id="wedding-planner" aria-labelledby="pf-wp-title">
    <div class="pf-section__intro">
      <div class="pf-section__intro-text">
        <p class="eyebrow" data-reveal>{it ? 'IL RAGGIO DEL VOSTRO GIORNO' : 'THE GUIDING LIGHT OF YOUR DAY'}</p>
        <h2 id="pf-wp-title" class="pf-section__title" data-reveal>Wedding Planner</h2>
        <p class="pf-section__desc" data-reveal>
          {it
            ? 'Dietro ogni matrimonio riuscito c\'è una connessione profonda tra la coppia e la sua planner. Leggete le loro storie e lasciatevi guidare dall\'istinto.'
            : "Behind every successful wedding is a deep connection between the couple and their planner. Read their stories and let your instincts guide you."}
        </p>
      </div>
      <div class="pf-section__intro-img">
        <Img src={wpSectionImg} alt={it ? 'Coppia durante il matrimonio' : 'Couple at their wedding'} sizes="(min-width: 900px) 58vw, 100vw" widths={[600, 1000]} />
      </div>
    </div>
    <div class="pf-section__grid container">
      {weddingPlanners.map((pro, i) => (
        <div data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
          <SupplierCard pro={pro} lang={lang} contactUrl={contactUrl} />
        </div>
      ))}
    </div>
    <div class="pf__detail" data-section-detail="wedding-planner">
      <div class="pf__detail-inner"></div>
    </div>
  </section>

  <!-- ── Location ── -->
  <section class="section pf-section" id="location" aria-labelledby="pf-loc-title">
    <div class="pf-section__intro">
      <div class="pf-section__intro-text">
        <p class="eyebrow" data-reveal>{it ? 'LA CORNICE DEL VOSTRO GIORNO' : "YOUR DAY'S BACKDROP"}</p>
        <h2 id="pf-loc-title" class="pf-section__title" data-reveal>Location</h2>
        <p class="pf-section__desc" data-reveal>
          {it
            ? 'Ogni luogo ha un\'anima, e il vostro si sta già aspettando. Quando lo vedrete, lo saprete: è lì che la vostra storia diventerà un ricordo per sempre.'
            : "Every venue has a soul, and yours is already waiting. When you find it, you'll know: it's where your story will become a memory forever."}
        </p>
      </div>
      <div class="pf-section__intro-img">
        <Img src={locSectionImg} alt={it ? 'Colline toscane con villa' : 'Tuscan hills with villa'} sizes="(min-width: 900px) 58vw, 100vw" widths={[600, 1000]} />
      </div>
    </div>
    <div class="pf-section__grid container">
      {locations.map((pro, i) => (
        <div data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
          <SupplierCard pro={pro} lang={lang} contactUrl={contactUrl} />
        </div>
      ))}
    </div>
    <div class="pf__detail" data-section-detail="location">
      <div class="pf__detail-inner"></div>
    </div>
  </section>

  <!-- ── Le domande giuste ── -->
  <section class="section pf-faq" id="pf-faq" aria-labelledby="pf-faq-title">
    <div class="container">
      <h2 id="pf-faq-title" class="pf-faq__title" data-reveal>
        {it ? <>Le domande giuste <em>prima di firmare</em></> : <>The right questions <em>before signing</em></>}
      </h2>
      <div class="pf-faq__grid">
        {faqItems.map((item, i) => (
          <div class="pf-faq__item" data-reveal style={`--delay:${i * 0.06}s`}>
            <span class="pf-faq__n">0{i + 1}</span>
            <h3 class="pf-faq__q">{item.q}</h3>
            <p class="pf-faq__a">{item.a}</p>
          </div>
        ))}
      </div>
      <div class="pf-faq__dl" data-reveal>
        <p class="pf-faq__dl-text muted">
          {it
            ? 'Scarica la lista completa delle domande da fare prima di firmare'
            : 'Download the full list of questions to ask before signing'}
        </p>
        <a class="btn pf-faq__dl-btn" href={contactUrl}>
          {it ? 'SCARICA LA LISTA' : 'DOWNLOAD THE LIST'}
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="pf-cta on-dark" aria-labelledby="pf-cta-title">
    <div class="pf-cta__bg">
      <Img src={ctaBg} alt={it ? 'Salone nuziale' : 'Wedding hall'} sizes="100vw" widths={[800, 1440]} />
    </div>
    <div class="pf-cta__overlay" aria-hidden="true"></div>
    <div class="container pf-cta__inner">
      <h2 id="pf-cta-title" class="pf-cta__title" data-reveal>
        {it
          ? <>Non sapete da dove iniziare? <em>Lasciatevi consigliare.</em></>
          : <>Not sure where to start? <em>Let us guide you.</em></>}
      </h2>
      <p class="pf-cta__sub" data-reveal style="--delay:.08s">
        {it
          ? 'Raccontateci la vostra idea: vi guidiamo tra planner, location e tutto il resto, con o senza il nostro bar.'
          : "Tell us your idea: we'll guide you through planners, venues and everything else, with or without our bar."}
      </p>
      <a class="btn btn--ghost-light pf-cta__btn" href={contactUrl} data-reveal style="--delay:.14s">
        {it ? 'CONTATTACI PER CONOSCERCI' : 'GET IN TOUCH WITH US'}
      </a>
    </div>
  </section>

  <!-- ── Footer bar ── -->
  <div class="pf-bar">
    <span class="pf-bar__msg">
      {it
        ? 'Le coppie si fidano di noi perché conosciamo il settore dall\'interno.'
        : 'Couples trust us because we know the industry from the inside.'}
    </span>
    <a class="pf-bar__link" href={`${contactUrl}?tab=pro#contact-form`}>
      {it ? 'Siete wedding planner o location? Entriamo in contatto →' : "Are you a wedding planner or venue? Let's connect →"}
    </a>
  </div>

</BaseLayout>

<style>
  /* ── Hero ── */
  .ph {
    position: relative;
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ph__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ph__bg :global(picture),
  .ph__bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .ph__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(10, 7, 5, 0.92) 0%,
      rgba(10, 7, 5, 0.75) 35%,
      rgba(10, 7, 5, 0.38) 65%,
      rgba(10, 7, 5, 0.12) 100%
    );
  }
  .ph__content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: calc(var(--header-h, 5rem) + var(--space-l)) clamp(2rem, 6vw, 7rem) 5rem;
    max-width: 52rem;
  }
  .ph__content :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw + 0.5rem, 6rem);
    font-weight: 300;
    line-height: 1.03;
    color: #fff;
  }
  .ph__content :global(h1)::after {
    content: '';
    display: block;
    width: 42px;
    height: 2px;
    background: var(--color-accent-on-dark);
    margin-top: var(--space-m);
    margin-bottom: var(--space-m);
  }
  .ph__content :global(h1 em) {
    display: block;
    font-style: italic;
    color: var(--color-accent-on-dark);
  }
  .ph__lead {
    color: rgba(255 255 255 / 0.72);
    max-width: 32rem;
    margin-bottom: var(--space-m);
  }
  .ph__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: flex-start;
  }
  .ph__badge svg {
    flex-shrink: 0;
    color: var(--color-accent-on-dark);
  }
  .ph__badge span {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
  }

  /* Tabs bar */
  .ph__tabs {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    width: 100%;
    background: rgba(6, 4, 3, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .ph__tabs::-webkit-scrollbar { display: none; }
  .ph__tabs a {
    flex: 1;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1rem 1rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255 255 255 / 0.55);
    border-right: 1px solid rgba(255 255 255 / 0.08);
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .ph__tabs a::after {
    content: '';
    display: block;
    width: 4px; height: 4px;
    border-right: 1px solid var(--color-accent-on-dark);
    border-bottom: 1px solid var(--color-accent-on-dark);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .ph__tabs a:last-child { border-right: none; }
  .ph__tabs a:hover {
    color: var(--color-accent-on-dark);
    background: rgba(255 255 255 / 0.03);
  }
  /* "Wedding / Planner" on two lines on mobile only */
  .ph__br { display: none; }
  /* badge text: two-line version on mobile only */
  .ph__badge-mob { display: none; }
  @media (max-width: 699px) {
    .ph__badge-desk { display: none; }
    .ph__badge-mob { display: inline; }
  }
  @media (max-width: 699px) {
    .ph__tabs a { font-size: 0.75rem; text-align: center; line-height: 1.35; }
    /* Location, FAQ: single words, a bit larger */
    .ph__tabs a:nth-child(n + 2) { font-size: 0.85rem; }
    .ph__br { display: inline; }
  }

  /* ── Come funziona ── */
  .pf-how { padding-top: var(--space-l); padding-bottom: var(--space-l); }
  .pf-how__eyebrow {
    text-align: center;
    margin-bottom: var(--space-l);
  }
  .pf-how__carousel { position: relative; }
  .pf-how__arrow { display: none; }
  .pf-how__dots  { display: none; }
  .pf-how__grid {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 700px) {
    .pf-how__grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-m); }
  }
  .pf-how__col {
    background: #fff;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }
  .pf-how__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .pf-how__img :global(picture),
  .pf-how__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .pf-how__col:hover .pf-how__img :global(img) {
    transform: scale(1.03);
  }
  @media (hover: none) {
    .pf-how__col .pf-how__img :global(img) { transition: none; }
    .pf-how__col:hover .pf-how__img :global(img) { transform: none; }
  }
  .pf-how__body {
    padding: var(--space-s) var(--space-m) var(--space-s);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .pf-how__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-s);
  }
  .pf-how__desc {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-m);
  }
  .pf-how__cta {
    display: inline-block;
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .pf-how__cta:hover {
    color: var(--color-accent-ink);
  }

