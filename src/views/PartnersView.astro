---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PartnerForm from '@/components/PartnerForm.astro';
import FAQ from '@/components/FAQ.astro';
import Img from '@/components/Img.astro';
import { faqFor } from '@/data/faq';
import { faqSchema } from '@/lib/seo';
import hall from '@/assets/images/venues/fresco-hall.jpg';
import bowl from '@/assets/images/details/champagne-bowl.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? { title: 'Partner Bar Catering per Wedding Planner e Location | Meteora Events', description: 'Bar catering partner per wedding planner, location, catering e professionisti eventi. Staff, attrezzatura e bicchieri propri, servizio autonomo in tutta Italia. Richiedi il listino partner.' }
  : { title: 'Bar Catering Partner for Wedding Planners & Venues | Meteora Events', description: 'A bar catering partner for wedding planners, venues, caterers and event professionals. Own staff, equipment and glassware, fully independent service across Italy. Request partner pricing.' };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Wedding planner & location' : 'Planners & venues', href: url('partners', lang) },
];
const audiences = it
  ? [['Wedding planner', 'Un fornitore che lavora in autonomia, rispetta i tempi e fa bella figura con i vostri clienti.'], ['Location', 'Massima cura di mura, pavimenti, arredi e verde. Lasciamo tutto pulito a fine servizio.'], ['Catering', 'Chiudete la cena con serenità, caricate il materiale e liberate il vostro staff: il dopocena è nostro.'], ['Professionisti eventi', 'Un partner beverage affidabile per produzioni, agenzie e organizzatori.']]
  : [['Wedding planners', 'A supplier who works independently, keeps to the timeline and makes you look good in front of your clients.'], ['Venues', 'Utmost care for walls, floors, furniture and gardens. We leave everything clean after service.'], ['Caterers', 'Close dinner service calmly, load out and release your team: the after-party is ours.'], ['Event professionals', 'A reliable beverage partner for productions, agencies and organisers.']];
const benefits = it
  ? ['Operatività indipendente e affidabile', 'Staff professionale e discreto', 'Attrezzatura e bicchieri propri', 'Logistica organizzata', 'Cura della location', 'Servizio visivamente pulito, nessuna cassa a vista', 'Coordinamento con il catering', 'Operativi in tutta Italia']
  : ['Reliable, independent operation', 'Professional, discreet staff', 'Our own equipment and glassware', 'Organised logistics', 'Care for the venue', 'A visually clean service, no crates in view', 'Coordination with catering', 'Available throughout Italy'];
const faqs = faqFor('partner');
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('partners')} current="partners" breadcrumbs={crumbs} schema={[faqSchema(faqs, lang)]} headerTheme="overlay">
  <PageHero variant="fullscreen" eyebrow={it ? 'Per wedding planner, location e catering' : 'For planners, venues and caterers'} image={hall} imageAlt={it ? 'Tavolo imperiale in un salone affrescato' : 'Long table in a frescoed hall'} crumbs={crumbs}>
    <h1>{it ? <>Il vostro partner <em>di fiducia</em> per il bar.</> : <>Your trusted <em>bar catering</em> partner.</>}</h1>
    <p slot="lead" class="lead muted">
      {it
        ? 'Lavoriamo al fianco di wedding planner, location, catering e professionisti degli eventi. Il vostro evento resta vostro: noi ci occupiamo del bar, in silenzio e con precisione.'
        : 'We work alongside wedding planners, venues, caterers and event professionals. Your event stays yours: we take care of the bar, quietly and precisely.'}
    </p>
    <div slot="cta" class="cta-row">
      <a class="btn" href="#partner-form" data-track="cta_click" data-track-label="partner_hero">{s.partnerPricing}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="p-who">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Con chi lavoriamo' : 'Who we work with'} id="p-who">{it ? <>Un solo obiettivo: <em>la buona riuscita dell’evento.</em></> : <>One goal: <em>a flawless event.</em></>}</SectionHeading>
      <ul class="aud" role="list">
        {audiences.map(([k, v], i) => (<li data-reveal style={`--delay:${i * 0.06}s`}><h3>{k}</h3><p class="muted">{v}</p></li>))}
      </ul>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="p-ben">
    <div class="container ben">
      <div class="ben__head">
        <p class="eyebrow" data-reveal>{it ? 'Perché i partner ci scelgono' : 'Why partners choose us'}</p>
        <h2 id="p-ben" data-reveal>{it ? <>Un pensiero <em>in meno.</em></> : <>One less thing <em>to worry about.</em></>}</h2>
        <div class="media ben__img" data-reveal="image"><Img src={bowl} alt={it ? 'Champagne bowl sul banco' : 'Champagne bowl on the bar'} sizes="(min-width: 960px) 25vw, 60vw" /></div>
      </div>
      <ul class="ben__list" role="list">
        {benefits.map((b, i) => (<li data-reveal style={`--delay:${(i % 4) * 0.05}s`}><span class="micro">{String(i + 1).padStart(2, '0')}</span>{b}</li>))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="partner-form" aria-labelledby="p-form">
    <div class="container pf">
      <div class="pf__intro">
        <p class="eyebrow">{it ? 'Area partner' : 'Partner area'}</p>
        <h2 id="p-form">{it ? <>Richiedete il <em>listino partner.</em></> : <>Request <em>partner pricing.</em></>}</h2>
        <p class="muted">
          {it
            ? 'Il listino riservato a planner, location e professionisti non è pubblico. Compilate il modulo: vi invieremo condizioni e tariffe dedicate.'
            : 'Our price list for planners, venues and professionals is not public. Fill in the form and we will send you our dedicated terms and rates.'}
        </p>
      </div>
      <div class="pf__form"><PartnerForm lang={lang} /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="p-faq">
    <div class="container container--narrow">
      <SectionHeading eyebrow="FAQ" id="p-faq">{it ? <>Domande <em>frequenti.</em></> : <>Frequently <em>asked.</em></>}</SectionHeading>
      <FAQ lang={lang} items={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .aud {
    display: grid;
    gap: var(--space-l);
  }
  .aud li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
  }
  .aud h3 {
    margin-bottom: 0.5rem;
  }
  .aud p {
    font-size: var(--fs-small);
  }
  @media (min-width: 800px) {
    .aud {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .aud {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ben {
    display: grid;
    gap: var(--space-xl);
  }
  .ben__head h2 {
    margin-top: var(--space-m);
  }
  .ben__img {
    margin-top: var(--space-l);
    aspect-ratio: 3 / 4;
    width: min(100%, 18rem);
  }
  .ben__list li {
    display: flex;
    gap: var(--space-m);
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    line-height: 1.2;
  }
  .ben__list .micro {
    color: var(--color-accent-on-dark);
    flex: none;
  }
  .pf {
    display: grid;
    gap: var(--space-xl);
  }
  .pf__intro > * + * {
    margin-top: var(--space-m);
  }
  @media (min-width: 960px) {
    .ben,
    .pf {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 7vw, 8rem);
      align-items: start;
    }
    .pf__intro {
      position: sticky;
      top: calc(var(--header-h-compact) + 2rem);
    }
  }
</style>
