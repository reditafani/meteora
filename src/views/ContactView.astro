---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import { site, whatsappLink } from '@/data/site';
import side from '@/assets/images/details/table-setting-gold.jpg';
import aerial from '@/assets/images/weddings/wedding-aerial.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? { title: 'Richiedi un Preventivo | Meteora Events', description: 'Richiedi un preventivo per il bar catering del tuo matrimonio o evento. Rispondiamo con una proposta su misura. Email info@meteoraevents.com, WhatsApp e telefono.' }
  : { title: 'Request a Quote | Meteora Events', description: 'Request a quote for bar catering at your wedding or event in Italy. We reply with a tailored proposal. Email info@meteoraevents.com, WhatsApp or phone.' };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Contatti' : 'Contact', href: url('contact', lang) },
];
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: meta.title,
  url: new URL(url('contact', lang), site.url + '/').toString(),
};
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('contact')} current="contact" breadcrumbs={crumbs} schema={[contactSchema]} showQuoteBar={false} headerTheme="overlay">

  <PageHero variant="fullscreen" align="left" image={aerial} imageAlt={it ? 'Sposi visti dall\'alto su un prato verde' : 'Couple seen from above on green grass'} crumbs={crumbs}>
    <h1>{it ? <>Contattaci.</> : <>Contact us.</>}</h1>
    <p slot="lead" class="lead muted">
      {it
        ? 'Raccontateci il vostro evento: vi risponderemo con una proposta costruita su misura.'
        : 'Tell us about your event and we will reply with a proposal built around it.'}
    </p>
    <div slot="cta">
      <a class="scroll-arrow" href="#contact-form" aria-label={it ? 'Scorri alla sezione contatti' : 'Scroll to contact section'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </a>
    </div>
  </PageHero>

  <section class="ct" id="contact-form">
    <div class="container ct__grid">
      <aside class="ct__side">
        <h2 class="ct__side-hd">{it ? <>Richiedete <em>il vostro preventivo.</em></> : <>Request <em>your quote.</em></>}</h2>
        <p class="lead muted">
          {it
            ? 'Più dettagli ci date, più precisa sarà la proposta.'
            : 'The more you share, the more precise our proposal will be.'}
        </p>
        <ul class="ct__links" role="list">
          <li><a href={`mailto:${site.email}`} data-track="email_click"><Icon name="mail" />{site.email}</a></li>
          <li><a href={`tel:${site.phoneE164}`} data-track="phone_click"><Icon name="phone" />{site.phoneDisplay}</a></li>
          <li><a href={site.instagram.url} target="_blank" rel="noopener" data-track="instagram_click"><Icon name="instagram" />{site.instagram.handle}</a></li>
          <li><span><Icon name="pin" />{site.address.locality} ({site.address.province}), {it ? 'Toscana — operativi in tutta Italia' : 'Tuscany — serving all of Italy'}</span></li>
        </ul>
        <div class="media ct__img"><Img src={side} alt={it ? 'Tavola elegante con piatti dorati e composizioni floreali bianche' : 'Elegant table setting with gold-rimmed plates and white floral arrangements'} sizes="(min-width: 960px) 30vw, 1px" /></div>
        <p class="ct__partner muted">
          {it ? 'Siete un wedding planner, una location o un catering?' : 'Are you a wedding planner, venue or caterer?'}
          <a class="link" href={url('partners', lang, 'partner-form')}>{s.partnerPricing}</a>
        </p>
      </aside>
      <div class="ct__form">
        <LeadForm lang={lang} />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .scroll-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(255 255 255 / 0.45);
    border-radius: 50%;
    color: rgba(255 255 255 / 0.8);
    text-decoration: none;
    animation: bounce-arrow 2.2s ease-in-out infinite;
    transition: border-color 0.2s, color 0.2s;
  }
  .scroll-arrow:hover {
    border-color: var(--color-accent-on-dark);
    color: var(--color-accent-on-dark);
    animation-play-state: paused;
  }
  @keyframes bounce-arrow {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(7px); }
  }
  .ct {
    padding-block: var(--space-xl) var(--section);
  }
  .ct__grid {
    display: grid;
    gap: var(--space-xl);
  }
  .ct__side > * + * {
    margin-top: var(--space-m);
  }
  .ct__eyebrow {
    margin-top: var(--space-l) !important;
  }
  .ct__side-hd {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
  }
  .ct__side-hd em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .ct__links {
    display: grid;
    gap: 0.2rem;
    padding-top: var(--space-s);
  }
  .ct__links a,
  .ct__links span {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding-block: 0.45rem;
    text-decoration: none;
    font-size: var(--fs-small);
  }
  .ct__links a:hover {
    color: var(--color-accent-ink);
  }
  .ct__img {
    display: none;
  }
  .ct__partner {
    font-size: var(--fs-small);
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  @media (min-width: 960px) {
    .ct__grid {
      grid-template-columns: 4fr 6fr;
      gap: clamp(3rem, 7vw, 8rem);
      align-items: start;
    }
    .ct__img {
      display: block;
      aspect-ratio: 4 / 3;
      margin-top: var(--space-l);
    }
    .ct__form {
      padding-top: calc(var(--space-xl) + 1rem);
    }
  }
</style>
