---
import '@/styles/forms.css';
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Img from '@/components/Img.astro';
import Field from '@/components/Field.astro';
import { site } from '@/data/site';
import tableMain  from '@/assets/images/details/table-setting-gold.jpg';
import mintOver   from '@/assets/images/details/mint-coupes.jpg';
import venueMain  from '@/assets/images/venues/wedding-table-flowers.jpg';
import barOver    from '@/assets/images/bars/golden-marble-night.jpg';
import aerial     from '@/assets/images/weddings/wedding-aerial.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);

const meta = it
  ? { title: 'Richiedi un Preventivo | Meteora Events', description: 'Richiedi un preventivo per il bar catering del tuo matrimonio o evento. Rispondiamo con una proposta su misura. Email info@meteoraevents.com, WhatsApp e telefono.' }
  : { title: 'Request a Quote | Meteora Events', description: 'Request a quote for bar catering at your wedding or event in Italy. We reply with a tailored proposal. Email info@meteoraevents.com, WhatsApp or phone.' };

const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Contatti' : 'Contact', href: url('contact', lang) },
];
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: meta.title,
  url: new URL(url('contact', lang), site.url + '/').toString(),
};

const messages = {
  required: s.errRequired,
  email: s.errEmail,
  phone: s.errPhone,
  date: s.errDate,
  consent: s.errConsent,
  invalid: s.formInvalid,
  sending: s.sending,
  error: s.formError,
};

const proTypes = [
  { value: 'wedding-planner', label: 'Wedding planner' },
  { value: 'location',        label: it ? 'Location / Villa' : 'Venue / Villa' },
];

const privacyHref = url('privacy', lang);
const privacyFull  = s.privacyConsent.replace('{href}', privacyHref);
const privacyShort = privacyFull.replace(' per ricevere una risposta', '').replace(' to receive a reply', '');
---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('contact')} current="contact" breadcrumbs={crumbs} schema={[contactSchema]} showQuoteBar={false} headerTheme="overlay">

  <PageHero variant="fullscreen" align="left" image={aerial} imageAlt={it ? 'Sposi visti dall\'alto su un prato verde' : 'Couple seen from above on green grass'} crumbs={crumbs}>
    <h1>{it ? <>Contattaci.</> : <>Contact us.</>}</h1>
    <p slot="lead" class="lead muted contact-lead">
      {it
        ? <>Raccontateci il vostro evento.<br />Vi risponderemo con una proposta costruita su misura.</>
        : <>Tell us about your event.<br />We will reply with a proposal built around it.</>}
    </p>
  </PageHero>

  <!-- ── Quote section ── -->
  <section class="ct" id="contact-form">
    <div class="container">

      <!-- Tab bar — sits above the two-column grid -->
      <div class="ct__tabbar" role="group" aria-label={it ? 'Chi siete?' : 'Who are you?'}>
        <span class="ct__tabbar-label" aria-hidden="true">{it ? 'CHI SIETE?' : 'WHO ARE YOU?'}</span>
        <div class="ct__tabs" role="tablist">
          <button
            class="ct__tab is-active"
            role="tab"
            id="tab-sposi"
            aria-selected="true"
            aria-controls="form-sposi"
            data-tab="sposi"
          >
            {it ? 'Sposi, Aziende e Privati' : 'Couples, Businesses & Private'}
          </button>
          <button
            class="ct__tab"
            role="tab"
            id="tab-pro"
            aria-selected="false"
            aria-controls="form-pro"
            data-tab="pro"
          >
            {it ? 'Wedding Planner e Location' : 'Wedding Planner & Venue'}
          </button>
        </div>
      </div>

      <!-- Two-column grid -->
      <div class="ct__grid">

        <!-- ── LEFT: overlapping images + tab-specific text ── -->
        <aside class="ct__left" aria-hidden="true">

          <!-- Sposi panel (default) -->
          <div class="ct__panel" data-panel="sposi">
            <div class="ct__imgs">
              <div class="ct__img-a-wrap">
                <div class="ct__img-a">
                  <Img src={tableMain} alt={it ? 'Tavola elegante con piatti dorati e fiori bianchi' : 'Elegant table with gold plates and white flowers'} sizes="(min-width: 960px) 20vw, 45vw" widths={[300, 500, 700]} />
                </div>
              </div>
              <div class="ct__img-b">
                <Img src={mintOver} alt={it ? 'Coppe con menta fresca' : 'Coupes with fresh mint'} sizes="(min-width: 960px) 13vw, 30vw" widths={[250, 450]} />
              </div>
            </div>
            <p class="ct__quote"><em>{it ? 'Ogni dettaglio, al suo posto.' : 'Every detail, in its place.'}</em></p>
            <div class="ct__direct">
              <p class="ct__direct-lbl">{it ? 'Preferite scriverci direttamente?' : 'Prefer to write to us directly?'}</p>
              <a class="ct__direct-email" href={`mailto:${site.email}`}>{site.email}</a>
              <ul class="ct__direct-list" role="list">
                <li>{it ? 'Rispondiamo a ogni richiesta entro 48 ore.' : 'We respond to every request within 48 hours.'}</li>
              </ul>
            </div>
          </div>

          <!-- Pro panel -->
          <div class="ct__panel" data-panel="pro" hidden>
            <div class="ct__imgs">
              <div class="ct__img-a-wrap">
                <div class="ct__img-a">
                  <Img src={venueMain} alt={it ? 'Tavola matrimoniale con fiori bianchi' : 'Wedding table with white flowers'} sizes="(min-width: 960px) 20vw, 45vw" widths={[300, 500, 700]} />
                </div>
              </div>
              <div class="ct__img-b">
                <Img src={barOver} alt={it ? 'Banco bar dorato di notte' : 'Golden bar at night'} sizes="(min-width: 960px) 13vw, 30vw" widths={[250, 450]} />
              </div>
            </div>
            <div class="ct__benefits">
              <p class="ct__benefits-hd">{it ? 'PER I PROFESSIONISTI' : 'FOR PROFESSIONALS'}</p>
              <ul role="list">
                <li>{it ? 'Listino partner riservato'                      : 'Reserved partner pricing'}</li>
                <li>{it ? 'Un referente unico per ogni evento'             : 'A single point of contact for every event'}</li>
                <li>{it ? 'Brochure Trade Edition per i vostri clienti'    : 'Trade Edition brochure for your clients'}</li>
                <li>{it ? 'Priorità sulle date di alta stagione'           : 'Priority on peak season dates'}</li>
              </ul>
            </div>
            <div class="ct__direct">
              <p class="ct__direct-lbl">{it ? 'Preferite scriverci direttamente?' : 'Prefer to write to us directly?'}</p>
              <a class="ct__direct-email" href={`mailto:${site.email}`}>{site.email}</a>
              <ul class="ct__direct-list" role="list">
                <li>{it ? 'Rispondiamo a ogni richiesta entro 48 ore.' : 'We respond to every request within 48 hours.'}</li>
              </ul>
            </div>
          </div>

        </aside>

        <!-- ── RIGHT: forms ── -->
        <div class="ct__right">

          <!-- ── Form 1: Sposi / Aziende / Privati ── -->
          <form
            id="form-sposi"
            class="form form--boxed"
            role="tabpanel"
            aria-labelledby="tab-sposi"
            action={site.formEndpoint}
            method="post"
            data-lead-form
            data-form="quote"
            data-event="quote_request"
            data-done="done-sposi"
            data-messages={JSON.stringify(messages)}
          >
            <input type="hidden" name="form_type"    value="quote" />
            <input type="hidden" name="form_variant" value="sposi" />
            <input type="hidden" name="lang"         value={lang} />
            <input type="hidden" name="_t"           value="" />
            <input type="hidden" name="redirect"     value={url('thanks', lang)} />
            <div class="hp" aria-hidden="true">
              <label>Leave empty <input type="text" name="company_fax" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="form__section form__full">{it ? 'CHI SIETE' : 'ABOUT YOU'}</div>
            <Field lang={lang} name="full_name"      label={it ? 'Nome e Cognome'        : 'Full name'}                required  autocomplete="name" />
            <Field lang={lang} name="email"          label="Email"                        type="email"  required  autocomplete="email" inputmode="email" />
            <Field lang={lang} name="phone"          label={it ? 'Telefono / WhatsApp'   : 'Phone / WhatsApp'}        span="full" autocomplete="tel" inputmode="tel" placeholder="+39 …" />

            <div class="form__section form__full">{it ? 'IL VOSTRO EVENTO' : 'YOUR EVENT'}</div>
            <Field lang={lang} name="event_date"     label={it ? 'Data'                  : 'Date'}                    required placeholder={it ? 'gg/mm/aaaa' : 'dd/mm/yyyy'} />
            <Field lang={lang} name="guests"         label={it ? 'Numero di ospiti'      : 'Number of guests'}        type="number" inputmode="numeric" min={10} max={5000} required placeholder="es. 120" />
            <Field lang={lang} name="event_location" label="Location"                     span="full"  required        placeholder={it ? 'Villa, borgo, città o zona' : 'Villa, town or area'} />

            <div class="form__section form__full">{it ? 'IL VOSTRO MESSAGGIO' : 'YOUR MESSAGE'}</div>
            <Field lang={lang} name="message"        label={it ? 'Parla con noi'         : 'Tell us more'}            type="textarea" span="full" rows={4} required placeholder={it ? 'Una breve descrizione della richiesta...' : 'A brief description of your request...'} />

            <div class="form__full consent-wrap">
              <label class="consent">
                <input type="checkbox" name="privacy" value="1" required aria-describedby="consent-sposi-err" />
                <span set:html={privacyFull} />
              </label>
              <p class="field__err" id="consent-sposi-err" aria-live="polite"></p>
            </div>
            <div class="form__full form__actions">
              <button type="submit" class="btn">
                {it ? 'Invia' : 'Send'} <span class="arrow" aria-hidden="true">→</span>
              </button>
              <p class="form__status" role="status" data-form-status></p>
            </div>
          </form>

          <div class="form-done" id="done-sposi" tabindex="-1" hidden role="status">
            <p class="eyebrow">{it ? 'Richiesta ricevuta' : 'Request received'}</p>
            <h3>{it ? <>Grazie. <em>Il vostro evento è in buone mani.</em></> : <>Thank you. <em>Your event is in good hands.</em></>}</h3>
            <p class="muted">{it ? 'Abbiamo ricevuto la vostra richiesta e vi risponderemo al più presto con una proposta su misura.' : 'We have received your request and will reply as soon as possible with a tailored proposal.'}</p>
          </div>

          <!-- ── Form 2: Wedding Planner / Location ── -->
          <form
            id="form-pro"
            class="form form--boxed"
            role="tabpanel"
            aria-labelledby="tab-pro"
            hidden
            action={site.formEndpoint}
            method="post"
            data-lead-form
            data-form="quote"
            data-event="partner_request"
            data-done="done-pro"
            data-messages={JSON.stringify(messages)}
          >
            <input type="hidden" name="form_type"    value="partner" />
            <input type="hidden" name="lang"         value={lang} />
            <input type="hidden" name="_t"           value="" />
            <input type="hidden" name="redirect"     value={url('thanks', lang)} />
            <div class="hp" aria-hidden="true">
              <label>Leave empty <input type="text" name="company_fax2" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="form__section form__full">{it ? 'CHI SIETE' : 'ABOUT YOU'}</div>
            <Field lang={lang} name="full_name"  label={it ? 'Nome e Cognome'           : 'Full name'}                required autocomplete="name" />
            <Field lang={lang} name="pro_type"   label={it ? 'Tipo di professionista'   : 'Professional type'}        type="select" required options={proTypes} placeholder={it ? 'Seleziona' : 'Select'} />
            <Field lang={lang} name="email"      label="Email"                           type="email" required autocomplete="email" inputmode="email" />
            <Field lang={lang} name="phone"      label="WhatsApp / Telefono"             type="tel"   autocomplete="tel" inputmode="tel" placeholder="+39 …" />

            <div class="form__section form__full">{it ? 'LA VOSTRA ATTIVITÀ' : 'YOUR BUSINESS'}</div>
            <Field lang={lang} name="instagram"  label={it ? 'Sito o Instagram'         : 'Website or Instagram'}     placeholder="@…" />
            <Field lang={lang} name="zones"      label={it ? 'Zone in cui lavorate'     : 'Areas you work in'}        placeholder={it ? 'Toscana, Umbria…' : 'Tuscany, Umbria…'} />

            <div class="form__section form__full">{it ? 'IL VOSTRO MESSAGGIO' : 'YOUR MESSAGE'}</div>
            <Field lang={lang} name="message"    label={it ? 'Parla con noi'            : 'Tell us more'}             type="textarea" span="full" rows={4} required placeholder={it ? 'Una breve descrizione della richiesta...' : 'A brief description of your request...'} />

            <div class="form__full consent-wrap">
              <label class="consent">
                <input type="checkbox" name="privacy" value="1" required aria-describedby="consent-pro-err" />
                <span set:html={privacyShort} />
              </label>
              <p class="field__err" id="consent-pro-err" aria-live="polite"></p>
            </div>
            <div class="form__full form__actions">
              <button type="submit" class="btn">
                {it ? 'Invia' : 'Send'} <span class="arrow" aria-hidden="true">→</span>
              </button>
              <p class="form__status" role="status" data-form-status></p>
            </div>
          </form>

          <div class="form-done" id="done-pro" tabindex="-1" hidden role="status">
            <p class="eyebrow">{it ? 'Richiesta ricevuta' : 'Request received'}</p>
            <h3>{it ? <>Grazie. <em>Vi ricontatteremo al più presto.</em></> : <>Thank you. <em>We will be in touch shortly.</em></>}</h3>
          </div>

        </div><!-- /ct__right -->
      </div><!-- /ct__grid -->
    </div><!-- /container -->
  </section>

</BaseLayout>

<style is:global>
  /* ── Hero lead: a little larger than the shared fullscreen-hero default ── */
  .fhero .fhero__lead p.contact-lead {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    max-width: 44rem;
  }

  /* ── Scroll arrow ── */
  .scroll-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    animation: bounce-arrow 2.2s ease-in-out infinite;
    transition: border-color 0.2s, color 0.2s;
  }
  .scroll-arrow:hover {
    border-color: var(--color-accent-on-dark);
    color: var(--color-accent-on-dark);
    animation-play-state: paused;
  }
  @keyframes bounce-arrow {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(7px); }
  }

  /* ── Section ── */
  .ct {
    padding-top: var(--space-xl);
    padding-bottom: var(--section);
  }

  /* ── Tab bar ── */
  .ct__tabbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-bottom: var(--space-l);
  }
  .ct__tabbar-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .ct__tabs {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 4px;
    gap: 3px;
  }
  .ct__tab {
    padding: 0.65rem 1.75rem;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.22s, color 0.22s;
    white-space: nowrap;
    line-height: 1.3;
  }
  .ct__tab.is-active {
    background: var(--color-text);
    color: var(--color-background);
  }
  .ct__tab:not(.is-active):hover {
    color: var(--color-text);
  }

  /* ── Two-column grid ── */
  .ct__grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 960px) {
    .ct__grid {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
    .ct__left {
      padding-top: 2rem;
    }
  }

  /* ── Left panels ── */
  .ct__panel {
    display: none;
  }
  .ct__panel:not([hidden]) {
    display: block;
  }

  /* ── Overlapping images ── */
  .ct__imgs {
    position: relative;
    padding-bottom: 11%;
  }
  .ct__img-a-wrap {
    position: relative;
    width: 65%;
  }
  .ct__img-a-wrap::after {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1px solid rgba(184, 158, 114, 0.6);
    pointer-events: none;
  }
  .ct__img-a {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }
  .ct__img-b {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 42%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    outline: 4px solid var(--color-background);
    outline-offset: -4px;
    z-index: 2;
  }
  .ct__img-a picture,
  .ct__img-a img,
  .ct__img-b picture,
  .ct__img-b img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Quote tagline (sposi) ── */
  .ct__quote {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.8rem + 0.7vw, 1.25rem);
    font-style: italic;
    color: var(--color-accent-ink);
    line-height: 1.3;
  }

  /* ── Direct contact block ── */
  .ct__direct {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
  .ct__direct-lbl {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .ct__direct-email {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.3rem);
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--space-s);
    transition: color 0.2s;
  }
  .ct__direct-email:hover {
    color: var(--color-accent-ink);
  }
  .ct__direct-list {
    list-style: disc;
    padding-left: 1.2rem;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ── Pro benefits ── */
  .ct__benefits {
    margin-top: 0.5rem;
  }
  .ct__benefits-hd {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-s);
  }
  .ct__benefits ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }
  .ct__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .ct__benefits li::before {
    content: '✓';
    color: var(--color-accent-ink);
    flex-shrink: 0;
    font-size: 0.8rem;
    margin-top: 0.1em;
  }

  /* ── Form section headers ── */
  .form__section {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--color-accent-ink);
    padding-top: var(--space-m);
  }
  .form__section:first-of-type {
    padding-top: 0;
  }
  .form__section::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Boxed field style ── */
  .form--boxed .field {
    border: 1px solid var(--color-border);
    background: #fff;
    padding: 0.45rem 0.75rem 0.5rem;
    gap: 0.15rem;
    transition: border-color 0.2s;
  }
  .form--boxed .field:focus-within {
    border-color: var(--color-text);
  }
  .form--boxed .field input,
  .form--boxed .field select,
  .form--boxed .field textarea {
    border: none;
    padding: 0;
    min-height: unset;
    font-size: 0.95rem;
  }
  .form--boxed .field input:hover,
  .form--boxed .field select:hover,
  .form--boxed .field textarea:hover {
    border: none;
  }
  .form--boxed .field input:focus-visible,
  .form--boxed .field select:focus-visible,
  .form--boxed .field textarea:focus-visible {
    outline: none;
    border: none;
    box-shadow: none;
  }
  .form--boxed .field textarea {
    min-height: 6rem;
    resize: vertical;
  }

  /* ── Mobile tweaks ── */
  @media (max-width: 699px) {
    .ct__left { display: none; }
    .ct__tabbar { gap: var(--space-s); }
    .ct__tabs { flex-direction: column; border-radius: 12px; }
    .ct__tab { border-radius: 10px; text-align: left; padding: 1.05rem 2.5rem; }
  }
  @media (max-width: 959px) and (min-width: 700px) {
    .ct__left { display: none; }
  }
</style>

<script>
  import { initForms } from '@/scripts/forms';
  initForms();

  const tabs   = document.querySelectorAll<HTMLButtonElement>('.ct__tab');
  const panels = document.querySelectorAll<HTMLElement>('.ct__panel');

  function activateTab(t: string) {
    tabs.forEach(b => {
      b.classList.toggle('is-active', b.dataset.tab === t);
      b.setAttribute('aria-selected', String(b.dataset.tab === t));
    });
    panels.forEach(p => {
      const show = p.dataset.panel === t;
      if (show) p.removeAttribute('hidden');
      else p.setAttribute('hidden', '');
    });
    (['sposi', 'pro'] as const).forEach(v => {
      const form = document.getElementById(`form-${v}`);
      const done = document.getElementById(`done-${v}`);
      if (form) form.hidden = v !== t;
      if (done) done.hidden = true;
    });
  }

  const initialTab = new URLSearchParams(window.location.search).get('tab');
  if (initialTab === 'pro') activateTab('pro');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab!));
  });
</script>
