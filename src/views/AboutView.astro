---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import { site } from '@/data/site';
import terrace from '@/assets/images/bars/terrace-panorama.jpg';
import mint from '@/assets/images/details/mint-coupes.jpg';
import sunset from '@/assets/images/bars/golden-mirror-sunset.jpg';
import shaker from '@/assets/images/details/shaker.jpg';
import strain from '@/assets/images/team/bartender-strain.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? {
      title: `Chi Siamo | Meteora Events — Oltre ${site.yearsExperience} Anni di Esperienza`,
      description: `Meteora Events è il partner specializzato nel servizio beverage per eventi di alto livello. Nasciamo da oltre ${site.yearsExperience} anni di esperienza operativa tra matrimoni, eventi corporate e privati. Base a Montecatini Terme, Toscana.`,
    }
  : {
      title: `About Us | Meteora Events — ${site.yearsExperience}+ Years of Experience`,
      description: `Meteora Events is the specialist partner for beverage services at high-level events. Built on ${site.yearsExperience}+ years of operational experience across weddings, corporate and private events. Based in Montecatini Terme, Tuscany.`,
    };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Chi siamo' : 'About us', href: url('about', lang) },
];

const values = it
  ? [
      ['Esperienza', `Oltre ${site.yearsExperience} anni di esperienza operativa: matrimoni, corporate ed eventi privati.`],
      ['Metodo', "Ogni servizio segue un metodo preciso, dall'allestimento allo smontaggio."],
      ['Cultura visiva', "Grande attenzione all'aspetto estetico e visivo. Il banco è scenografia."],
      ['Ospitalità', 'Professionalità e discrezione con ogni ospite, in ogni contesto.'],
    ]
  : [
      ['Experience', `${site.yearsExperience}+ years of operational experience: weddings, corporate and private events.`],
      ['Method', 'Every service follows a precise method, from setup to load-out.'],
      ['Visual culture', 'Great attention to aesthetic and visual impact. The bar is scenography.'],
      ['Hospitality', 'Professionalism and discretion with every guest, in every context.'],
    ];

const serves = it
  ? [
      {
        n: '01',
        title: 'Matrimoni',
        text: "Dall'aperitivo in giardino all'open bar dopo cena. Il banco diventa scenografia dell'evento e resta nelle fotografie.",
      },
      {
        n: '02',
        title: 'Eventi aziendali',
        text: 'Brand activation, lanci di prodotto, cene di gala, team building. Il nostro staff si adatta al registro corporate con divisa personalizzabile.',
      },
      {
        n: '03',
        title: 'Eventi privati',
        text: 'Compleanni, anniversari, celebrazioni e rinfreschi. Ogni occasione, piccola o grande, merita il nostro standard di servizio.',
      },
    ]
  : [
      {
        n: '01',
        title: 'Weddings',
        text: 'From the garden aperitivo to the after-dinner open bar. The bar becomes part of the scenography and stays in the photographs.',
      },
      {
        n: '02',
        title: 'Corporate events',
        text: 'Brand activations, product launches, gala dinners, team building. Our staff adapts to the corporate register with customisable uniforms.',
      },
      {
        n: '03',
        title: 'Private events',
        text: 'Birthdays, anniversaries, celebrations and receptions. Every occasion, large or small, deserves our service standard.',
      },
    ];

type IconName = 'ice' | 'user' | 'briefcase' | 'cocktail' | 'star' | 'snowflake';
const included: { icon: IconName; title: string; text: string }[] = it
  ? [
      { icon: 'ice',       title: 'Banco bar',                 text: 'Uno dei nostri banchi signature, nella misura scelta.' },
      { icon: 'user',      title: 'Staff preparato',           text: 'Barman professionisti formati da noi, inclusi nel prezzo.' },
      { icon: 'briefcase', title: 'Allestimento e smontaggio', text: "Montiamo prima degli ospiti, smontiamo dopo l'ultimo brindisi." },
      { icon: 'cocktail',  title: 'Bicchieri in vetro',        text: 'Cristalleria professionale.' },
      { icon: 'star',      title: 'Tutti gli ingredienti',     text: 'Distillati, mixer, frutta fresca, sciroppi e guarnizioni.' },
      { icon: 'snowflake', title: 'Ghiaccio',                  text: 'Ghiaccio artigianale, in quantita calcolata sui vostri ospiti.' },
    ]
  : [
      { icon: 'ice',       title: 'Bar counter',       text: 'One of our signature bars, in the size you choose.' },
      { icon: 'user',      title: 'Trained staff',     text: 'Professional bartenders trained by us, included in the price.' },
      { icon: 'briefcase', title: 'Setup & breakdown', text: 'We set up before your guests arrive, break down after the last toast.' },
      { icon: 'cocktail',  title: 'Crystal glassware', text: 'Professional glassware throughout.' },
      { icon: 'star',      title: 'All ingredients',   text: 'Spirits, mixers, fresh fruit, syrups and garnishes.' },
      { icon: 'snowflake', title: 'Ice',               text: 'Artisan ice, calculated for your guest count.' },
    ];

const steps: { title: string; text: string; cta?: boolean }[] = it
  ? [
      { title: 'Primo contatto',     text: 'Ascoltiamo la vostra richiesta e ci conosciamo.' },
      { title: 'Il vostro bar',      text: 'Scegliete il banco bar e la cocktail list.' },
      { title: 'La nostra proposta', text: "Tutto per iscritto: un contratto con ogni dettaglio di cio che e incluso.", cta: true },
      { title: 'Il grande giorno',   text: 'Allestimento, servizio e coordinamento in presenza.' },
      { title: 'Smontaggio',         text: "Lasciamo la location esattamente come l'abbiamo trovata." },
    ]
  : [
      { title: 'First contact', text: 'You tell us about your event and we get to know each other.' },
      { title: 'Your bar',      text: 'Choose your bar counter and cocktail list.' },
      { title: 'Our proposal',  text: 'Everything in writing: a contract detailing exactly what is included.', cta: true },
      { title: 'The big day',   text: 'Setup, service and on-site coordination.' },
      { title: 'Breakdown',     text: 'We leave the venue exactly as we found it.' },
    ];

---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('about')} current="about" breadcrumbs={crumbs} headerTheme="overlay">

  <!-- HERO -->
  <PageHero
    variant="fullscreen"
    eyebrow={it ? 'Chi siamo' : 'About us'}
    image={strain}
    imageAlt={it ? 'Bartender in gilet nero che filtra un cocktail' : 'Bartender in a black waistcoat straining a cocktail'}
    crumbs={crumbs}
  >
    <h1>{it ? <>Esperienza beverage. <em>Esecuzione impeccabile.</em></> : <>Beverage expertise. <em>Flawless execution.</em></>}</h1>
    <p slot="lead" class="lead muted hero-lead">
      {it
        ? `Meteora Events è il partner specializzato nella gestione del servizio beverage per eventi di alto livello. Nasciamo da oltre ${site.yearsExperience} anni di esperienza operativa nel settore.`
        : `Meteora Events is the partner specialised in managing beverage services for high-level events. We grew from ${site.yearsExperience}+ years of operational experience in the industry.`}
    </p>
  </PageHero>

  <!-- LA NOSTRA STORIA -->
  <section class="section" aria-labelledby="a-story">
    <div class="container story">
      <div class="story__heading">
        <p class="eyebrow" data-reveal>{it ? 'La nostra storia' : 'Our story'}</p>
        <h2 id="a-story" data-reveal>
          {it
            ? <>Non offriamo semplicemente <em>un servizio bar.</em></>
            : <>We don't simply offer <em>a bar service.</em></>}
        </h2>
      </div>
      <div class="story__media">
        <div class="media story__img" data-reveal="image">
          <Img src={terrace} alt={it ? 'Banco bar davanti a una vetrata panoramica' : 'Bar in front of a panoramic window'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.06s">
          <Img src={mint} alt={it ? 'Coppe con menta e frutti rossi' : 'Coupes with mint and red berries'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.12s">
          <Img src={sunset} alt={it ? 'Banco Golden Mirror al tramonto su una terrazza' : 'Golden Mirror bar at sunset on a terrace'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.18s">
          <Img src={shaker} alt={it ? 'Shaker professionale sul banco' : 'Professional shaker on the bar'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
      </div>
      <div class="story__text">
        <p class="muted" data-reveal>
          {it
            ? "Portiamo professionalità, metodo ed esperienza scenografica con grande attenzione all'aspetto estetico e visivo dell'allestimento. Conosciamo a fondo le dinamiche di matrimoni, eventi corporate e privati, perché le viviamo da anni dall'interno."
            : 'We bring professionalism, method and scenographic experience with great attention to the aesthetic and visual impact of every setup. We know the dynamics of weddings, corporate and private events inside out, because we have lived them for years.'}
        </p>
        <p class="lead" data-reveal>
          {it
            ? "Ogni evento è unico e irripetibile, e ciò che viene realizzato resta impresso nelle immagini e nei ricordi. Per questo puntiamo all'eccellenza, nel servizio e nell'impatto visivo."
            : 'Every event is unique and unrepeatable, and what is created lives on in the images and memories. That is why we aim for excellence — in service and in visual impact.'}
        </p>
        <p class="muted" data-reveal>
          {it
            ? "Realizziamo servizi bar e cocktail experience per privati, aziende e professionisti del settore dalla nostra sede di Montecatini Terme, operando in tutta Italia e all'estero."
            : 'We create bar services and cocktail experiences for private clients, companies and event professionals from our base in Montecatini Terme, operating across Italy and abroad.'}
        </p>
      </div>
    </div>
  </section>


  <!-- CHIAVI IN MANO -->
  <section class="section section--alt" aria-labelledby="a-included">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Chiavi in mano' : 'All-inclusive'} id="a-included">
        {it ? <>Voi scegliete il pacchetto. <em>Al resto pensiamo noi.</em></> : <>You choose the package. <em>We handle the rest.</em></>}
      </SectionHeading>
      <ul class="incl" role="list">
        {included.map((item, i) => (
          <li data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
            <Icon name={item.icon} size={26} />
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="section" aria-labelledby="a-process">
    <div class="container">
      <p class="eyebrow" data-reveal>{it ? 'Come funziona' : 'How it works'}</p>
      <h2 id="a-process" class="process-hdg" data-reveal style="--delay:.04s">
        {it ? <>Cinque passi. <em>Nessuna sorpresa.</em></> : <>Five steps. <em>No surprises.</em></>}
      </h2>
      <ol class="process" role="list">
        {steps.map((step, i) => (
          <li data-reveal style={`--delay:${i * 0.07}s`}>
            <span class="process__n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
            {step.cta && <a class="link process__cta" href={url('contact', lang)}>{it ? 'Scriveteci' : 'Get in touch'}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4 VALORI -->
  <section class="section section--alt section--tight" aria-labelledby="a-values">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Come lavoriamo' : 'How we work'} id="a-values">
        {it ? <>Quattro parole, <em>ogni volta.</em></> : <>Four words, <em>every time.</em></>}
      </SectionHeading>
      <ol class="values" role="list">
        {values.map(([k, v], i) => (
          <li data-reveal style={`--delay:${i * 0.06}s`}>
            <span class="values__k">{k}</span>
            <p class="muted">{v}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CHI SERVIAMO -->
  <section class="section section--tight" aria-labelledby="a-serves">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Chi serviamo' : 'Who we serve'} align="split" id="a-serves">
        {it
          ? <>Matrimoni, aziende <em>e privati.</em></>
          : <>Weddings, corporate <em>and private.</em></>}
      </SectionHeading>
      <ol class="serves" role="list">
        {serves.map((item) => (
          <li data-reveal>
            <span class="micro serves__n">{item.n}</span>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ol>
      <div class="serves__cta" data-reveal>
        <a class="btn" href={url('services', lang)}>{it ? 'Scopri i nostri servizi' : 'Discover our services'}</a>
      </div>
    </div>
  </section>



</BaseLayout>

<style>
  .section--tight :global(.sh) {
    margin-bottom: var(--space-m);
  }

  :global(.hero-lead) {
    text-align: justify;
    max-width: 34rem;
    hyphens: auto;
  }

  /* ── Story ── */
  .story {
    display: grid;
    gap: var(--space-l);
  }
  .story__heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
  }
  .story__heading h2 em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .story__media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
  }
  .story__img {
    aspect-ratio: 4 / 3;
  }
  .story__text {
    display: grid;
    gap: var(--space-m);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }
  .story__text p {
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
  }
  @media (min-width: 700px) {
    .story__media {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .values {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-s);
  }
  .values li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
  }
  .values__k {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .values p {
    font-size: var(--fs-small);
    max-width: 22rem;
  }
  @media (min-width: 800px) {
    .values { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .values { grid-template-columns: repeat(4, 1fr); }
  }

  .serves {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-s);
  }
  .serves li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .serves__n {
    color: var(--color-accent-ink);
  }
  .serves h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .serves p {
    font-size: var(--fs-small);
    max-width: 28rem;
  }
  .serves__cta {
    margin-top: var(--space-l);
  }
  @media (min-width: 700px) {
    .serves { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Chiavi in mano ── */
  .incl {
    display: grid;
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }
  .incl li {
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-l) var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .incl li :global(svg) {
    color: var(--color-accent-ink);
    margin-bottom: var(--space-xs, 0.5rem);
  }
  .incl h3 {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.5vw, 1.35rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .incl p {
    font-size: var(--fs-small);
    max-width: 26rem;
  }
  @media (min-width: 600px) {
    .incl { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 900px) {
    .incl { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Come funziona ── */
  .process-hdg {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .process-hdg em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .process {
    display: grid;
    gap: var(--space-l);
    position: relative;
  }
  .process li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .process__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-accent-ink);
    color: var(--color-accent-ink);
    font-size: 0.75rem;
    margin-bottom: var(--space-s);
    position: relative;
    z-index: 1;
  }
  .process li h3 {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.5vw, 1.35rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .process li p {
    font-size: var(--fs-small);
  }
  .process__cta {
    margin-top: var(--space-xs, 0.5rem);
    font-size: var(--fs-small);
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-m);
    }
    .process::before {
      content: '';
      position: absolute;
      top: 1.125rem;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--color-border);
    }
    .process li {
      border-top: none;
      padding-top: 0;
    }
    .process__n {
      background: var(--color-background);
    }
  }
</style>
