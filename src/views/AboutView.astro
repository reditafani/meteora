---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import ItalyMap from '@/components/ItalyMap.astro';
import { site } from '@/data/site';
import terrace from '@/assets/images/bars/terrace-panorama.jpg';
import mint from '@/assets/images/details/mint-coupes.jpg';
import sunset from '@/assets/images/bars/golden-mirror-sunset.jpg';
import shaker from '@/assets/images/details/shaker.jpg';
import strain from '@/assets/images/team/bartender-strain.jpg';
import coupleImg from '@/assets/images/towers/couple-pour.jpg';
import silverImg from '@/assets/images/corporate/corporate-table.jpg';
import loungeImg from '@/assets/images/bars/night-lounge.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? {
      title: `Chi Siamo | Meteora Events — Oltre ${site.yearsExperience} Anni di Esperienza`,
      description: `Meteora Events è il partner specializzato nel servizio beverage per eventi di alto livello. Nasciamo da oltre ${site.yearsExperience} anni di esperienza operativa tra matrimoni, eventi corporate e privati. Base a Montecatini Terme, Toscana.`,
    }
  : {
      title: `About Us | Meteora Events — ${site.yearsExperience}+ Years of Experience`,
      description: `Meteora Events is the specialist partner for beverage services at high-level events. Built on ${site.yearsExperience}+ years of operational experience across weddings, corporate and private events. Based in Montecatini Terme, Tuscany.`,
    };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Chi siamo' : 'About us', href: url('about', lang) },
];

const serveCards = it
  ? [
      {
        n: '01', title: 'Matrimoni',
        subtitle: "Il giorno più fotografato della vostra vita merita un bar all'altezza.",
        bullets: ['Destination wedding', 'Matrimoni in villa, castelli e cantine', 'Welcome party e after party', 'Brunch del giorno dopo'],
        href: url('services', lang), cta: 'Scopri',
      },
      {
        n: '02', title: 'Eventi aziendali',
        subtitle: "La cura di un matrimonio, per l'immagine della vostra azienda.",
        bullets: ['Logo su divise e banco', 'Cene di gala e lanci di prodotto', 'Convention e team building', 'Viaggi incentive e feste di Natale'],
        href: url('services', lang), cta: 'Scopri',
      },
      {
        n: '03', title: 'Eventi privati',
        subtitle: 'Ogni traguardo merita un brindisi fatto bene.',
        bullets: ['Sfilate ed eventi di moda', 'Vernissage e inaugurazioni', 'Fiere', 'Feste di laurea e compleanni'],
        href: url('services', lang), cta: 'Scopri',
      },
    ]
  : [
      {
        n: '01', title: 'Weddings',
        subtitle: 'The most photographed day of your life deserves a bar to match.',
        bullets: ['Destination weddings', 'Villas, castles and wineries', 'Welcome party and after party', 'Day-after brunch'],
        href: url('services', lang), cta: 'Discover',
      },
      {
        n: '02', title: 'Corporate events',
        subtitle: 'The care of a wedding, for the image of your company.',
        bullets: ['Logo on uniforms and bar', 'Gala dinners and product launches', 'Conventions and team building', 'Incentive trips and Christmas parties'],
        href: url('services', lang), cta: 'Discover',
      },
      {
        n: '03', title: 'Private events',
        subtitle: 'Every milestone deserves a well-made toast.',
        bullets: ['Fashion shows and events', 'Vernissages and openings', 'Trade fairs', 'Graduation parties and birthdays'],
        href: url('services', lang), cta: 'Discover',
      },
    ];
const serveImgs = [coupleImg, silverImg, loungeImg];
const serveAlts = it
  ? ['Coppia che versa champagne da una tower', 'Tavola imperiale allestita sotto un portico', 'Lounge notturno con luci soffuse']
  : ['Couple pouring champagne from a tower', 'Imperial table set under a portico', 'Night lounge with soft lighting'];

type IconName = 'ice' | 'user' | 'briefcase' | 'cocktail' | 'star' | 'snowflake';
const included: { icon: IconName; title: string; text: string }[] = it
  ? [
      { icon: 'ice',       title: 'Banco bar',                 text: 'Uno dei nostri banchi signature, nella misura scelta.' },
      { icon: 'user',      title: 'Staff preparato',           text: 'Barman professionisti formati da noi, inclusi nel prezzo.' },
      { icon: 'briefcase', title: 'Allestimento e smontaggio', text: "Montiamo prima degli ospiti, smontiamo dopo l'ultimo brindisi." },
      { icon: 'cocktail',  title: 'Bicchieri in vetro',        text: 'Cristalleria professionale.' },
      { icon: 'star',      title: 'Tutti gli ingredienti',     text: 'Distillati, mixer, frutta fresca, sciroppi e guarnizioni.' },
      { icon: 'snowflake', title: 'Ghiaccio',                  text: 'Ghiaccio artigianale, in quantita calcolata sui vostri ospiti.' },
    ]
  : [
      { icon: 'ice',       title: 'Bar counter',       text: 'One of our signature bars, in the size you choose.' },
      { icon: 'user',      title: 'Trained staff',     text: 'Professional bartenders trained by us, included in the price.' },
      { icon: 'briefcase', title: 'Setup & breakdown', text: 'We set up before your guests arrive, break down after the last toast.' },
      { icon: 'cocktail',  title: 'Crystal glassware', text: 'Professional glassware throughout.' },
      { icon: 'star',      title: 'All ingredients',   text: 'Spirits, mixers, fresh fruit, syrups and garnishes.' },
      { icon: 'snowflake', title: 'Ice',               text: 'Artisan ice, calculated for your guest count.' },
    ];

const steps: { title: string; text: string; cta?: boolean }[] = it
  ? [
      { title: 'Primo contatto',     text: 'Ascoltiamo la vostra richiesta e ci conosciamo.' },
      { title: 'Il vostro bar',      text: 'Scegliete il banco bar e la cocktail list.' },
      { title: 'La nostra proposta', text: "Tutto per iscritto: un contratto con ogni dettaglio di cio che e incluso." },
      { title: 'Il grande giorno',   text: 'Allestimento, servizio e coordinamento in presenza.' },
      { title: 'Smontaggio',         text: "Lasciamo la location esattamente come l'abbiamo trovata." },
    ]
  : [
      { title: 'First contact', text: 'You tell us about your event and we get to know each other.' },
      { title: 'Your bar',      text: 'Choose your bar counter and cocktail list.' },
      { title: 'Our proposal',  text: 'Everything in writing: a contract detailing exactly what is included.' },
      { title: 'The big day',   text: 'Setup, service and on-site coordination.' },
      { title: 'Breakdown',     text: 'We leave the venue exactly as we found it.' },
    ];

---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('about')} current="about" breadcrumbs={crumbs} headerTheme="overlay">

  <!-- HERO -->
  <PageHero
    variant="fullscreen"
    eyebrow={it ? 'Chi siamo' : 'About us'}
    image={strain}
    imageAlt={it ? 'Bartender in gilet nero che filtra un cocktail' : 'Bartender in a black waistcoat straining a cocktail'}
    crumbs={crumbs}
  >
    <h1>Meteora Events</h1>
    <p slot="lead" class="lead muted hero-lead">
      {it
        ? `Il tuo partner specializzato nella gestione del servizio beverage per eventi. Nasciamo da oltre ${site.yearsExperience} anni di esperienza operativa nel settore.`
        : `Your specialist partner for beverage services at events. Built on ${site.yearsExperience}+ years of operational experience in the industry.`}
    </p>
  </PageHero>

  <!-- LA NOSTRA FILOSOFIA -->
  <section class="section" aria-labelledby="a-story">
    <div class="container story">
      <div class="story__heading">
        <p class="eyebrow" data-reveal>{it ? 'La nostra filosofia' : 'Our philosophy'}</p>
        <h2 id="a-story" data-reveal>
          {it
            ? <>Non offriamo semplicemente <em>un servizio bar.</em></>
            : <>We don't simply offer <em>a bar service.</em></>}
        </h2>
      </div>
      <div class="story__media">
        <div class="media story__img" data-reveal="image">
          <Img src={terrace} alt={it ? 'Banco bar davanti a una vetrata panoramica' : 'Bar in front of a panoramic window'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.06s">
          <Img src={mint} alt={it ? 'Coppe con menta e frutti rossi' : 'Coupes with mint and red berries'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.12s">
          <Img src={sunset} alt={it ? 'Banco Golden Mirror al tramonto su una terrazza' : 'Golden Mirror bar at sunset on a terrace'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.18s">
          <Img src={shaker} alt={it ? 'Shaker professionale sul banco' : 'Professional shaker on the bar'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
      </div>
      <div class="story__text">
        <p class="muted" data-reveal>
          {it
            ? "Portiamo professionalità, metodo ed esperienza scenografica con grande attenzione all'aspetto estetico e visivo dell'allestimento. Conosciamo a fondo le dinamiche di matrimoni, eventi corporate e privati, perché le viviamo da anni dall'interno."
            : 'We bring professionalism, method and scenographic experience with great attention to the aesthetic and visual impact of every setup. We know the dynamics of weddings, corporate and private events inside out, because we have lived them for years.'}
        </p>
        <p class="lead" data-reveal>
          {it
            ? "Ogni evento è unico e irripetibile, e ciò che viene realizzato resta impresso nelle immagini e nei ricordi. Per questo puntiamo all'eccellenza, nel servizio e nell'impatto visivo."
            : 'Every event is unique and unrepeatable, and what is created lives on in the images and memories. That is why we aim for excellence — in service and in visual impact.'}
        </p>
        <p class="muted" data-reveal>
          {it
            ? "Realizziamo servizi bar e cocktail experience per privati, aziende e professionisti del settore dalla nostra sede di Montecatini Terme, operando in tutta Italia e all'estero."
            : 'We create bar services and cocktail experiences for private clients, companies and event professionals from our base in Montecatini Terme, operating across Italy and abroad.'}
        </p>
      </div>
    </div>
  </section>


  <!-- CHIAVI IN MANO -->
  <section class="section section--dark section--dark-pair" aria-labelledby="a-included">
    <div class="container">
      <SectionHeading eyebrow={it ? 'Chiavi in mano' : 'All-inclusive'} id="a-included">
        {it ? <>Voi scegliete il pacchetto. <em>Al resto pensiamo noi.</em></> : <>You choose the package. <em>We handle the rest.</em></>}
      </SectionHeading>
      <ul class="incl" role="list">
        {included.map((item, i) => (
          <li data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
            <Icon name={item.icon} size={26} />
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="section" aria-labelledby="a-process">
    <div class="container">
      <p class="eyebrow" data-reveal>{it ? 'Come funziona' : 'How it works'}</p>
      <h2 id="a-process" class="process-hdg" data-reveal style="--delay:.04s">
        {it ? <>Cinque passi. <em>Nessuna sorpresa.</em></> : <>Five steps. <em>No surprises.</em></>}
      </h2>
      <ol class="process" role="list">
        {steps.map((step, i) => (
          <li data-reveal style={`--delay:${i * 0.07}s`}>
            <span class="process__n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
            {step.cta && <a class="link process__cta" href={url('contact', lang)}>{it ? 'Scriveteci' : 'Get in touch'}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CHI SERVIAMO -->
  <section class="section section--dark section--serves" aria-labelledby="a-serves">
    <div class="container">
      <div class="serves-hd">
        <p class="eyebrow" data-reveal>{it ? 'I nostri eventi' : 'Our events'}</p>
        <h2 id="a-serves" class="serves-hd__title" data-reveal>
          {it
            ? <>Ogni occasione merita <em>il suo brindisi.</em></>
            : <>Every occasion deserves <em>its toast.</em></>}
        </h2>
        <p class="serves-hd__lead muted" data-reveal>
          {it
            ? 'Matrimoni, eventi aziendali ed eventi privati, in Toscana e in tutta Italia.'
            : 'Weddings, corporate and private events, in Tuscany and throughout Italy.'}
        </p>
      </div>
    </div>
    <div class="srv-cards">
      {serveCards.map((card, i) => (
        <div class="srv-card" data-reveal style={`--delay:${i * 0.08}s`}>
          <div class="srv-card__media">
            <Img src={serveImgs[i]} alt={serveAlts[i]} sizes="(min-width: 700px) 33vw, 90vw" />
          </div>
          <span class="srv-card__badge">
            <span class="srv-card__badge-dot" aria-hidden="true"></span>
            {it ? 'Foto reale' : 'Real photo'}
          </span>
          <div class="srv-card__body">
            <span class="srv-card__n">{card.n}</span>
            <h3 class="srv-card__title">{card.title}</h3>
            <p class="srv-card__sub">{card.subtitle}</p>
            <hr class="srv-card__rule" />
            <ul class="srv-card__bullets" role="list">
              {card.bullets.map(b => <li>— {b}</li>)}
            </ul>
            <a class="srv-card__link" href={card.href}>
              {card.cta} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- DOVE LAVORIAMO -->
  <ItalyMap lang={lang} />

</BaseLayout>

<style>
  :global(.hero-lead) {
    text-align: justify;
    max-width: 34rem;
    hyphens: auto;
  }

  /* ── Story ── */
  .story {
    display: grid;
    gap: var(--space-l);
  }
  .story__heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
  }
  .story__heading h2 em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .story__media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
  }
  .story__img {
    aspect-ratio: 4 / 3;
  }
  .story__text {
    display: grid;
    gap: var(--space-m);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }
  .story__text p {
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
  }
  @media (min-width: 700px) {
    .story__media {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Collapse gap between the two adjacent linked dark sections */
  .section--dark-pair + .section--dark-pair {
    padding-top: 0;
  }

  /* ── Dark section overrides ── */
  .section--dark .incl {
    border-color: rgba(255 255 255 / 0.12);
  }
  .section--dark .incl li {
    border-color: rgba(255 255 255 / 0.12);
  }
  .section--dark .incl li :global(svg) {
    color: var(--color-accent-on-dark);
  }
  .section--dark .process li {
    border-top-color: rgba(255 255 255 / 0.15);
  }
  .section--dark .process__n {
    background: var(--color-dark);
    border-color: var(--color-accent-on-dark);
    color: var(--color-accent-on-dark);
  }
  @media (min-width: 700px) {
    .section--dark .process__n {
      background: var(--color-dark);
    }
    .section--dark .process::before {
      background: rgba(255 255 255 / 0.15);
    }
  }

  /* ── Chiavi in mano ── */
  .incl {
    display: grid;
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }
  .incl li {
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-l) var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .incl li :global(svg) {
    color: var(--color-accent-ink);
    margin-bottom: var(--space-xs, 0.5rem);
  }
  .incl h3 {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.5vw, 1.35rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .incl p {
    font-size: var(--fs-small);
    max-width: 26rem;
  }
  @media (min-width: 600px) {
    .incl { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 900px) {
    .incl { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Come funziona ── */
  .process-hdg {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .process-hdg em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .process {
    display: grid;
    gap: var(--space-l);
    position: relative;
  }
  .process li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .process__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-accent-ink);
    color: var(--color-accent-ink);
    font-size: 0.75rem;
    margin-bottom: var(--space-s);
    position: relative;
    z-index: 1;
  }
  .process li h3 {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.5vw, 1.35rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .process li p {
    font-size: var(--fs-small);
  }
  .process__cta {
    margin-top: var(--space-xs, 0.5rem);
    font-size: var(--fs-small);
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-m);
    }
    .process::before {
      content: '';
      position: absolute;
      top: 1.125rem;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--color-border);
    }
    .process li {
      border-top: none;
      padding-top: 0;
    }
    .process__n {
      background: var(--color-background);
    }
  }

  /* ── Chi serviamo ── */
  .section--serves {
    padding-bottom: 0;
  }
  .serves-hd {
    text-align: center;
    padding-bottom: var(--space-xl);
  }
  .serves-hd__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.2rem + 4.5vw, 5.5rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
  }
  .serves-hd__title em {
    font-style: italic;
    color: var(--color-accent-on-dark);
  }
  .serves-hd__lead {
    margin-top: var(--space-m);
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.05rem);
  }

  /* ── Cards ── */
  .srv-cards {
    display: grid;
  }
  .srv-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .srv-card__media {
    position: absolute;
    inset: 0;
  }
  .srv-card__media :global(picture),
  .srv-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .srv-card:hover .srv-card__media :global(img) {
    transform: scale(1.04);
  }
  .srv-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.4) 45%, transparent 100%);
    pointer-events: none;
  }
  .srv-card__badge {
    position: absolute;
    top: var(--space-m);
    left: var(--space-m);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0 0 0 / 0.52);
    padding: 0.3rem 0.65rem;
    border-radius: 2rem;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .srv-card__badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #5cb85c;
    flex-shrink: 0;
  }
  .srv-card__body {
    position: relative;
    z-index: 2;
    padding: var(--space-m);
  }
  .srv-card__n {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: rgba(255 255 255 / 0.5);
    margin-bottom: 0.25rem;
  }
  .srv-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.4rem + 1.5vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
  }
  .srv-card__sub {
    margin-top: 0.45rem;
    font-size: var(--fs-small);
    font-style: italic;
    color: rgba(255 255 255 / 0.65);
    max-width: 28rem;
  }
  .srv-card__rule {
    border: none;
    border-top: 1px solid rgba(255 255 255 / 0.2);
    margin-block: var(--space-s);
  }
  .srv-card__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .srv-card__bullets li {
    font-size: var(--fs-small);
    color: rgba(255 255 255 / 0.55);
  }
  .srv-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
    text-decoration: none;
  }
