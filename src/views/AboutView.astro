---
import type { Lang } from '@/i18n/routes';
import { url, alternatesFor } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';

import Img from '@/components/Img.astro';
import { site } from '@/data/site';
import ItalyMap from '@/components/ItalyMap.astro';
import terrace from '@/assets/images/bars/terrace-panorama.jpg';
import mint from '@/assets/images/details/mint-coupes.jpg';
import sunset from '@/assets/images/cocktails/old-fashioned-pour.jpg';
import shaker from '@/assets/images/details/woman-coupe.jpg';
import strain from '@/assets/images/venues/wedding-table-flowers.jpg';
import weddCardImg from '@/assets/images/weddings/open-bar-matrimonio-villa-toscana.jpg';
import corpCardImg from '@/assets/images/corporate/bar-catering-evento-aziendale.webp';
import loungeImg from '@/assets/images/bars/private-bar-night.jpg';
import cimBg from '@/assets/images/venues/wedding-table-candles.jpg';
import bartenderStrain from '@/assets/images/team/bartender-strain.jpg';
import processBg from '@/assets/images/bars/bartender-pour-night.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const s = t(lang);
const meta = it
  ? {
      title: 'Chi Siamo | Meteora Events, servizio bar in Toscana e Italia',
      description: `Da oltre ${site.yearsExperience} anni curiamo il servizio bar di matrimoni, eventi privati e aziendali in Toscana e in tutta Italia. La nostra storia, il metodo, il team.`,
    }
  : {
      title: 'About Meteora | Luxury Wedding Bar Catering, Tuscany & Italy',
      description: `Based in Tuscany, we have spent ${site.yearsExperience}+ years creating the bar for destination weddings and private events across Italy. Meet the team behind every drink.`,
    };
const crumbs = [
  { name: s.breadcrumbHome, href: url('home', lang) },
  { name: it ? 'Chi siamo' : 'About us', href: url('about', lang) },
];

const serveCards = it
  ? [
      {
        n: '01', title: 'Matrimoni',
        subtitle: 'Il bar di tutto il vostro weekend, dalla sera prima all\'ultimo ballo.',
        bullets: ['Destination wedding', 'Matrimoni in villa, castelli e cantine', 'Welcome party, pool party e pizza party', 'Fughe d\'amore e matrimoni intimi', 'Rinnovo delle promesse', 'Addii al nubilato e al celibato'],
        href: url('services', lang), cta: 'Scopri i nostri servizi',
      },
      {
        n: '02', title: 'Eventi aziendali',
        subtitle: 'Ospitalità impeccabile, per clienti, partner e collaboratori.',
        bullets: ['Convention, congressi e cene di gala', 'Lanci di prodotto e inaugurazioni', 'Eventi di moda e lusso', 'Eventi artistici, vernissage e mostre', 'Feste aziendali', 'Fiere e stand'],
        href: url('services', lang), cta: 'Scopri i nostri servizi',
      },
      {
        n: '03', title: 'Eventi privati',
        subtitle: 'Ogni traguardo merita un brindisi fatto bene.',
        bullets: ['Compleanni, anniversari e ricorrenze', 'Feste di laurea', 'Feste di fidanzamento', 'Pool party e pizza party', 'Cene con chef a domicilio', 'Degustazioni e corsi di cucina'],
        href: url('services', lang), cta: 'Scopri i nostri servizi',
      },
    ]
  : [
      {
        n: '01', title: 'Weddings',
        subtitle: 'The bar for your whole wedding weekend, from the eve to the last dance.',
        bullets: ['Destination weddings', 'Villas, castles and wineries', 'Welcome party, pool party and pizza party', 'Elopements and intimate weddings', 'Vow renewals', 'Hen and stag parties'],
        href: url('services', lang), cta: 'Discover our services',
      },
      {
        n: '02', title: 'Corporate events',
        subtitle: 'Impeccable hospitality, for clients, partners and colleagues.',
        bullets: ['Conventions, congresses and gala dinners', 'Product launches and openings', 'Fashion and luxury events', 'Art events, vernissages and exhibitions', 'Company parties', 'Trade fairs and stands'],
        href: url('services', lang), cta: 'Discover our services',
      },
      {
        n: '03', title: 'Private events',
        subtitle: 'Every milestone deserves a well-made toast.',
        bullets: ['Birthdays, anniversaries and celebrations', 'Graduation parties', 'Engagement parties', 'Pool parties and pizza parties', 'Private chef dinners', 'Tastings and cooking classes'],
        href: url('services', lang), cta: 'Discover our services',
      },
    ];
const serveImgs = [weddCardImg, corpCardImg, loungeImg];
// the wedding photo is portrait in a 16:10 box: frame it on the bride's face and bouquet (see position below)
const serveAlts = it
  ? ['Sposa con velo e bouquet sulla terrazza di una villa per matrimoni in Italia', 'Convention aziendale in una grande sala con pubblico, palco e maxischermi', 'Lounge notturno con luci soffuse']
  : ['Bride with veil and bouquet on the terrace of an Italian wedding villa', 'Corporate convention in a large hall with audience, stage and big screens', 'Night lounge with soft lighting'];

const included: { title: string; sub: string }[] = it
  ? [
      { title: 'Banco bar scenografico',                       sub: 'a scelta dalla nostra collezione'                              },
      { title: 'Bartender professionisti',                     sub: 'staff qualificato, in divisa elegante'                          },
      { title: 'La vostra drink list',                         sub: 'Scegliete i vostri drink preferiti, al resto pensiamo noi.'     },
      { title: 'Distillati selezionati e ingredienti freschi', sub: 'frutta fresca, disidratata, odori e spezie'                     },
      { title: 'Ghiaccio professionale',                       sub: 'scelto per ogni tipo di cocktail'                               },
      { title: 'Il bicchiere giusto per ogni drink',           sub: "serviamo drink in vetro, perché anche l'occhio vuole la sua parte" },
      { title: 'Allestimento e smontaggio',                    sub: 'pensiamo noi a tutto'                                           },
    ]
  : [
      { title: 'Scenic bar counter',                    sub: 'chosen from our collection' },
      { title: 'Professional bartenders',               sub: 'qualified staff, in elegant uniform' },
      { title: 'Your drink list',                       sub: 'choose your favourite drinks, we handle the rest.' },
      { title: 'Selected spirits & fresh ingredients',  sub: 'fresh fruit, dried, herbs and spices' },
      { title: 'Professional ice',                      sub: 'chosen for each cocktail type' },
      { title: 'The right glass for every drink',       sub: 'no plastic, ever' },
      { title: 'Setup & breakdown',                     sub: 'we take care of everything' },
    ];

const steps: { title: string; text: string }[] = it
  ? [
      { title: 'Raccontateci il vostro giorno',     text: 'Basta una email con data, location e numero di ospiti.' },
      { title: 'Costruiamo la vostra offerta',       text: 'Scegliete banco, formula e cocktail list, con le personalizzazioni che desiderate.' },
      { title: 'Tutto per iscritto',                 text: 'Una proposta e un contratto con ogni dettaglio incluso.' },
      { title: "Il giorno dell'evento",              text: 'Quel giorno l\'unica cosa a cui dovrete pensare sarete voi. Al bar penseremo noi, esattamente come lo abbiamo costruito insieme.' },
    ]
  : [
      { title: 'Tell us about your day',   text: 'Just send us an email with your date, venue and number of guests.' },
      { title: 'We build your offer',      text: 'Choose your bar, package and cocktail list, with any customisations you want.' },
      { title: 'Everything in writing',    text: 'A proposal and a contract with every detail included.' },
      { title: 'The day of your event',    text: 'That day, the only thing you need to think about is each other. We\'ll take care of the bar, exactly as we built it together.' },
    ];

---

<BaseLayout lang={lang} title={meta.title} description={meta.description} alternates={alternatesFor('about')} current="about" breadcrumbs={crumbs} headerTheme="overlay">

  <!-- HERO -->
  <PageHero
    variant="fullscreen"
    align="left"

    image={strain}
    imageAlt={it ? 'Tavola matrimoniale apparecchiata con fiori freschi e tovaglioli a quadretti' : 'Wedding table set with fresh flowers and gingham napkins'}
    crumbs={crumbs}
  >
    <h1>Meteora <em>Events</em></h1>
    <p slot="lead" class="lead hero-lead">
      {it
        ? <>Il bar dei vostri eventi, pensato e curato in ogni dettaglio<br />da un team che vive il settore da oltre {site.yearsExperience} anni.</>
        : <>The bar for your events, designed and crafted in every detail<br />by a team that has lived the industry for over {site.yearsExperience} years.</>}
    </p>
  </PageHero>

  <!-- LA NOSTRA FILOSOFIA -->
  <section class="section" aria-labelledby="a-story">
    <div class="container story">
      <div class="story__heading">
        <p class="eyebrow" data-reveal>{it ? 'La nostra filosofia' : 'Our philosophy'}</p>
        <h2 id="a-story" data-reveal>
          {it
            ? <>Non offriamo semplicemente <em>un servizio bar.</em></>
            : <>We don't simply offer <em>a bar service.</em></>}
        </h2>
      </div>
      <div class="story__media">
        <div class="media story__img" data-reveal="image">
          <Img src={terrace} alt={it ? 'Banco bar davanti a una vetrata panoramica' : 'Bar in front of a panoramic window'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.06s">
          <Img src={mint} alt={it ? 'Coppe con menta e frutti rossi' : 'Coupes with mint and red berries'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.12s">
          <Img src={sunset} alt={it ? 'Old Fashioned versato attraverso uno strainer su ghiaccio' : 'Old Fashioned being strained over ice'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
        <div class="media story__img" data-reveal="image" style="--delay:.18s">
          <Img src={shaker} alt={it ? 'Donna con cappello che assaggia un cocktail rosa in una coppa' : 'Woman in a hat sipping a pink cocktail in a coupe glass'} sizes="(min-width: 900px) 25vw, 50vw" />
        </div>
      </div>
      <div class="story__bottom">

        <!-- Photo card -->
        <div class="story__card" data-reveal>
          <Img src={bartenderStrain} alt={it ? 'Barman che filtra un cocktail in coppa' : 'Bartender straining a cocktail into a coupe'} sizes="(min-width: 760px) 45vw, 90vw" />
          <div class="story__card-overlay">
            <p class="story__card-exp">
              {it
                ? <><em>Da oltre</em><strong class="story__card-n">14</strong><em>anni</em></>
                : <><em>Over</em><strong class="story__card-n">14</strong><em>years</em></>}
            </p>
            <p class="story__card-sub">{it ? 'DI ESPERIENZA NEL SETTORE EVENTI' : 'OF EXPERIENCE IN THE EVENTS INDUSTRY'}</p>
            <p class="story__card-tags">
              <span aria-hidden="true"></span>
              {it ? 'MATRIMONI · EVENTI AZIENDALI · EVENTI PRIVATI' : 'WEDDINGS · CORPORATE · PRIVATE EVENTS'}
              <span aria-hidden="true"></span>
            </p>
          </div>
        </div>

        <!-- Right: sub-heading + text + CTA -->
        <div class="story__text" data-reveal style="--delay:.08s">
          <h3 class="story__sub">
            {it
              ? <>Professionalità, metodo <em>ed esperienza scenografica.</em></>
              : <>Professionalism, method <em>and scenographic experience.</em></>}
          </h3>
          <p class="muted">
            {it
              ? "Portiamo professionalità, metodo ed esperienza scenografica con grande attenzione all'aspetto estetico e visivo dell'allestimento. Conosciamo a fondo le dinamiche di matrimoni, eventi corporate e privati, perché le viviamo da anni dall'interno."
              : 'We bring professionalism, method and scenographic experience with great attention to the aesthetic and visual impact of every setup. We know the dynamics of weddings, corporate and private events inside out, because we have lived them for years.'}
          </p>
          <p class="muted">
            {it
              ? "Ogni evento è unico e irripetibile, e le emozioni di quel giorno resteranno impresse nelle foto e nei ricordi. Per questo ogni dettaglio, dal banco all'ultimo drink, è pensato per renderlo indimenticabile."
              : 'Every event is unique and unrepeatable, and the emotions of that day will live on in photographs and memories. That is why every detail — from the bar to the last drink — is designed to make it unforgettable.'}
          </p>
          <a class="btn story__cta" href={url('services', lang)}>
            {it ? 'Scopri i nostri servizi' : 'Discover our services'}
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- CHIAVI IN MANO -->
  <section class="cim" id="a-included" aria-labelledby="cim-title">
    <div class="cim__bg">
      <Img src={cimBg} alt={it ? 'Tavola imperiale apparecchiata con candele e fiori per un matrimonio' : 'Long wedding table set with candles and flowers'} sizes="100vw" widths={[800, 1280, 1920]} />
    </div>
    <div class="cim__overlay" aria-hidden="true"></div>
    <div class="cim__inner container">
      <div class="cim__text">
        <p class="cim__eyebrow" data-reveal>
          <span class="cim__eyebrow-line" aria-hidden="true"></span>
          {it ? 'Pacchetti all inclusive' : 'All inclusive packages'}
        </p>
        <h2 id="cim-title" class="cim__title" data-reveal style="--delay:.04s">
          {it ? 'Voi scegliete il pacchetto!' : 'You choose the package!'}
        </h2>
        <p class="cim__sub" data-reveal style="--delay:.09s">
          <em>{it ? 'Noi pensiamo al resto.' : 'We handle the rest.'}</em>
        </p>
        <!-- desktop CTA (original position); mobile uses the one below the card -->
        <a href={url('services', lang)} class="cim__cta btn btn--ghost-light" data-reveal style="--delay:.12s">
          {it ? 'Scopri i nostri pacchetti' : 'Discover our packages'}
          <svg class="cim__cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <!-- checklist card + CTA below it (same order as the home packages section) -->
      <div class="cim__aside" data-reveal style="--delay:.14s">
      <div class="cim__card">
        <ul class="cim__list" role="list">
          {included.map(item => (
            <li class="cim__item">
              <svg class="cim__check" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="9.5" stroke="currentColor" stroke-width="1.2"/>
                <path d="M7 11.5l2.8 2.8 5.2-5.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="cim__item-body">
                <span class="cim__item-title">{item.title}</span>
                <span class="cim__item-sub">{item.sub}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <a href={url('services', lang)} class="cim__cta-mob btn">
        {it ? 'Scopri i nostri pacchetti →' : 'Discover our packages →'}
      </a>
      </div>
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="section proc" id="a-process" aria-labelledby="proc-title">
    <div class="container proc__grid">

      <!-- Left photo card -->
      <div class="proc__card" data-reveal>
        <Img src={processBg} alt={it ? 'Allestimento bar serale in una location elegante' : 'Evening bar setup at an elegant venue'} sizes="(min-width: 900px) 38vw, 90vw" />
        <div class="proc__card-overlay">
          <p class="proc__card-eyebrow">
            <span class="proc__card-line" aria-hidden="true"></span>
            {it ? 'COME FUNZIONA' : 'HOW IT WORKS'}
          </p>
          <h2 id="proc-title" class="proc__card-title">
            {it
              ? <>Dal primo contatto <em>al grande giorno.</em></>
              : <>From first contact <em>to the big day.</em></>}
          </h2>
          <p class="proc__card-sub">
            {it
              ? 'Organizzare da lontano non è mai stato così semplice: quattro passaggi chiari, nessuna incertezza.'
              : 'Organising from afar has never been this simple: four clear steps, no uncertainty.'}
          </p>
          <a class="btn proc__card-btn" href={url('contact', lang)}>
            {it ? 'Raccontateci il vostro evento' : 'Tell us about your event'} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Right vertical steps -->
      <ol class="proc__steps" role="list" data-reveal style="--delay:.1s">
        {steps.map((step, i) => (
          <li class="proc__step">
            <div class="proc__step-dot" aria-hidden="true"></div>
            <div class="proc__step-body">
              <p class="proc__step-label">{`PASSO ${['I','II','III','IV'][i]}`}</p>
              <h3 class="proc__step-title">{step.title}</h3>
              <p class="proc__step-text muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

    </div>
  </section>

  <!-- CHI SERVIAMO -->
  <section class="section section--dark section--serves" aria-labelledby="a-serves">
    <div class="container">
      <div class="serves-hd">
        <p class="eyebrow" data-reveal>{it ? 'I nostri eventi' : 'Our events'}</p>
        <h2 id="a-serves" class="serves-hd__title" data-reveal>
          {it
            ? <>Ogni occasione merita <em>il suo brindisi.</em></>
            : <>Every occasion deserves <em>its toast.</em></>}
        </h2>
        <p class="serves-hd__lead muted" data-reveal>
          {it
            ? 'Dal grande giorno alla festa in piscina, dalla cena di gala al compleanno: siamo il bar di ogni vostra occasione.'
            : 'From the big day to the pool party, from the gala dinner to the birthday: we are the bar for every occasion.'}
          <br class="serves-hd__br" />
          {it
            ? 'Dal benvenuto a fine serata, pensiamo noi a tutto il servizio, perché voi possiate pensare solo a festeggiare.'
            : 'From the welcome drink to the last round, we handle the full service so you can focus on celebrating.'}
        </p>
      </div>
    </div>
    <div class="srv-carousel">
      <div class="srv-cards" data-srv-grid>
        {serveCards.map((card, i) => (
          <div class="srv-card" data-reveal style={`--delay:${i * 0.08}s`}>
            <div class="srv-card__media">
              <Img src={serveImgs[i]} alt={serveAlts[i]} quality={i < 2 ? 90 : undefined} position={i === 0 ? '50% 14%' : undefined} sizes="(min-width: 700px) 33vw, 90vw" />
            </div>
            <div class="srv-card__body">
              <h3 class="srv-card__title">{card.title}</h3>
              <p class="srv-card__sub">{card.subtitle}</p>
              <hr class="srv-card__rule" />
              <ul class="srv-card__bullets" role="list">
                {card.bullets.map(b => <li>— {b}</li>)}
              </ul>
              <a class="srv-card__link" href={card.href}>
                {card.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
      <button type="button" class="srv-arrow srv-arrow--prev" data-srv-prev aria-label={it ? 'Precedente' : 'Previous'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="srv-arrow srv-arrow--next" data-srv-next aria-label={it ? 'Successivo' : 'Next'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <div class="srv-dots" role="list">
        {serveCards.map((_, i) => (
          <button class:list={['srv-dot', i === 0 && 'is-active']} type="button" data-srv-dot={i} aria-label={`Slide ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <ItalyMap lang={lang} />

  <!-- ── About CTA ── -->
  <section class="abt-cta on-dark">
    <div class="container abt-cta__inner">
      <h2 class="abt-cta__title" data-reveal>
        {it ? 'Dove sarà il vostro brindisi?' : 'Where will your toast be?'}
      </h2>
      <a class="btn btn--ghost-light cta-pill cta-pill--block abt-cta__btn" href={url('contact', lang)} data-reveal style="--delay:.1s">
        {it ? 'Verifica disponibilità →' : 'Check availability →'}
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  :global(.hero-lead) {
    max-width: 38rem;
    color: rgba(255 255 255 / 0.78);
  }

  /* Offset for fixed header on anchor links from nav dropdown */
  section[id] {
    scroll-margin-top: calc(var(--header-h-compact, 4rem) + 1rem);
  }

  /* Riduzione padding superiore eyebrow — stessa logica homepage */
  section[aria-labelledby="a-story"],
  section[aria-labelledby="a-serves"] {
    padding-top: var(--space-l);
  }
  .cim {
    scroll-margin-top: calc(var(--header-h-compact, 4rem) + 1rem);
  }

  /* ── Story ── */
  .story {
    display: grid;
    gap: var(--space-l);
  }
  .story__heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    margin-top: var(--space-s);
  }
  .story__heading h2 em {
    font-style: italic;
    color: var(--color-accent-ink);
  }
  .story__media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
  }
  .story__img {
    aspect-ratio: 4 / 3;
  }
  .story__img::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--color-accent-on-dark), inset 0 0 0 8px #fff;
    pointer-events: none;
    z-index: 2;
  }
  /* Two-column block below photos */
  .story__bottom {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 760px) {
    .story__bottom {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: stretch;
    }
  }

  /* Photo card (experience) */
  .story__card {
    position: relative;
    overflow: hidden;
  }
  .story__card :global(picture) { display: contents; }
  .story__card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story__card::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--color-accent-on-dark), inset 0 0 0 8px #fff;
    pointer-events: none;
    z-index: 3;
  }
  .story__card-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.2rem, 2.5vw, 2rem);
    background: linear-gradient(to top, rgba(0 0 0 / 0.88) 0%, rgba(0 0 0 / 0.65) 50%, transparent 100%);
    text-align: center;
    color: #fff;
    z-index: 2;
  }
  .story__card-exp {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.92rem, 3.36vw, 2.88rem);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4em;
    margin-bottom: 1.4rem;
    line-height: 1;
  }
  .story__card-n {
