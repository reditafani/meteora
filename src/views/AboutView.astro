<script>
  const srvGrid = document.querySelector<HTMLElement>('[data-srv-grid]');
  if (srvGrid) {
    const srvPrev = document.querySelector<HTMLButtonElement>('[data-srv-prev]');
    const srvNext = document.querySelector<HTMLButtonElement>('[data-srv-next]');
    const srvDots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-srv-dot]'));
    const srvCount = srvDots.length;
    let srvCurrent = 0;
    let srvTimer = 0;

    // Dots + arrows only; never scrolls
    const srvSetActive = (i: number) => {
      srvCurrent = Math.max(0, Math.min(i, srvCount - 1));
      srvDots.forEach((d, j) => d.classList.toggle('is-active', j === srvCurrent));
      if (srvPrev) srvPrev.style.opacity = srvCurrent === 0 ? '0.35' : '1';
      if (srvNext) srvNext.style.opacity = srvCurrent === srvCount - 1 ? '0.35' : '1';
    };
    const srvGo = (i: number) => {
      srvSetActive(i);
      srvGrid.scrollTo({ left: srvCurrent * srvGrid.offsetWidth, behavior: 'smooth' });
    };

    srvPrev?.addEventListener('click', () => srvGo(srvCurrent - 1));
    srvNext?.addEventListener('click', () => srvGo(srvCurrent + 1));
    srvDots.forEach((d, i) => d.addEventListener('click', () => srvGo(i)));

    // After a swipe, scroll-snap places the card; just sync dots and arrows
    // (re-scrolling here fought the finger on diagonal swipes)
    srvGrid.addEventListener('scroll', () => {
      clearTimeout(srvTimer);
      srvTimer = window.setTimeout(() => {
        const w = srvGrid.offsetWidth;
        if (!w) return;
        const idx = Math.round(srvGrid.scrollLeft / w);
        if (idx !== srvCurrent) srvSetActive(idx);
      }, 60);
    }, { passive: true });

    // Reveal all cards together when the strip enters the viewport: on mobile
    // the off-screen cards would otherwise rise and fade in while being swiped
    const srvRevealIo = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        srvGrid.querySelectorAll<HTMLElement>('[data-reveal]').forEach((c) => c.classList.add('is-visible'));
        srvRevealIo.disconnect();
      }
    }, { threshold: 0.08 });
    srvRevealIo.observe(srvGrid);

    if (srvPrev) srvPrev.style.opacity = '0.35';
  }
</script>
